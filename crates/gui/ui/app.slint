import { Button, LineEdit, ComboBox, VerticalBox, HorizontalBox, GroupBox, ScrollView, Palette } from "std-widgets.slint";

// Shared theme tokens so custom-drawn elements (everything below that isn't
// a plain std-widget) actually follow the Appearance tab's choices instead
// of staying hardcoded to one dark palette. Most of this derives from
// `Palette`, which follows `Palette.color-scheme` (set from `theme-mode`
// below); `accent` is the one deliberately user-choosable color (Appearance
// tab's swatch picker), everything else stays theme-derived.
global Theme {
    in-out property <color> accent: #2d7d5a;
    out property <color> muted-text: Palette.foreground.with-alpha(0.55);
    out property <color> divider: Palette.foreground.with-alpha(0.15);
    out property <color> panel-hover: Palette.foreground.with-alpha(0.08);
    out property <color> track-background: Palette.foreground.with-alpha(0.15);
    out property <color> accent-wash: accent.with-alpha(0.18);
    out property <color> accent-text: accent.brighter(0.7);
}

export struct EqBand {
    enabled: bool,
    freq: float,
    gain: float,
    q: float,
    /// 0 bell, 1 low shelf, 2 high shelf, 3 notch -- an int because Slint
    /// and Rust share no enum. See `antiphon_audio::BandType`.
    band-type: int,
}

export struct ChatMessage {
    id: int,
    from-me: bool,
    text: string,
    edited: bool,
    deleted: bool,
    pinned: bool,
    /// Where the links in this message actually point, worked out locally.
    /// Nothing is ever fetched -- see `link_preview.rs`.
    links: string,
    /// Reactions on this message, already summarised (spec §13).
    reactions: string,
    /// Sending / Waiting for them to come online / Delivered (spec §8).
    /// Empty on messages we did not send -- a delivery state on someone
    /// else's message would be a claim this device cannot make.
    delivery: string,
}

/// One entry in the theme gallery (spec §7).
export struct ThemePresetEntry {
    name: string,
    description: string,
    accent: color,
    background: color,
}

export struct PresetEntry {
    name: string,
}

/// One row of the network capability table (spec §10). Three columns
/// rather than a sentence, because the questions are independent and a
/// paragraph makes people hunt for the one they care about.
export struct ReachabilityRow {
    question: string,
    answer: string,
    meaning: string,
}

/// An imported WireGuard config (spec §6). Never carries the key.
export struct VpnConfigEntry {
    id: string,
    name: string,
    detail: string,
    active: bool,
}

/// A file that stays fetchable after the call (spec §5).
export struct SharedFileEntry {
    name: string,
    detail: string,
    /// Availability, or how a download went.
    status: string,
    file-id: string,
    mine: bool,
}

/// A community listed in a directory (spec §4).
export struct DirectoryEntry {
    name: string,
    description: string,
    invite: string,
    directory: string,
}

/// One delivery route (spec §8), for the route list.
export struct RouteEntry {
    title: string,
    description: string,
    enabled: bool,
    is-direct: bool,
    /// Node addresses, comma-separated.
    nodes: string,
    code: string,
    /// Live status of each node, one per line.
    status: string,
}

export struct ContactEntry {
    name: string,
    address: string,
    is-server: bool,
    /// Short hex of the pinned identity key, or "" if nothing pinned yet.
    fingerprint: string,
    /// A verification code was compared out of band and matched.
    verified: bool,
    /// The key presented on the last call differed from the pinned one.
    key-changed: bool,
    /// 0 always ring, 1 silent only, 2 never. See `notify::RingRule`.
    ring-rule: int,
    /// The full pinned identity key, hex, or "".
    key: string,
    /// Spec §3 per-conversation override: 0 auto, 1 direct, 2 relay.
    connection-mode: int,
    /// They have shared a relay, so a relayed call is possible.
    via-relay: bool,
    /// Spec §8 per-contact override: 0 their routes, 1 direct only.
    message-route: int,
    /// They publish somewhere mail can be left for them.
    has-mailbox: bool,
}

// A from-scratch slider, standing in for std-widgets' `Slider`. That one's
// thumb/track follow the Fluent style's `accentify()`, which pulls the
// *Windows system accent color* -- entirely independent of this app's own
// Appearance > Accent color picker. That mismatch is exactly why every
// slider in the app was tracking the OS accent (yellow, on the machine
// that reported it) no matter what was chosen here. This one uses
// `Theme.accent` instead, so it actually reflects the user's choice.
component AccentSlider {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in-out property <float> value: 0;
    callback changed(float);

    // Spec §7 keyboard-only navigation. A slider that can only be dragged
    // is one a keyboard user cannot set at all -- and unlike a button,
    // there is no "activate" fallback that would do instead.
    //
    // Steps are a fiftieth of the range so a full sweep takes a
    // manageable number of presses whatever the units are; Home and End
    // jump to the ends, which is how every native slider behaves.
    slider-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.value = max(root.minimum, root.value - (root.maximum - root.minimum) / 50);
                root.changed(root.value);
                return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.value = min(root.maximum, root.value + (root.maximum - root.minimum) / 50);
                root.changed(root.value);
                return accept;
            }
            if (event.text == Key.Home) {
                root.value = root.minimum;
                root.changed(root.value);
                return accept;
            }
            if (event.text == Key.End) {
                root.value = root.maximum;
                root.changed(root.value);
                return accept;
            }
            reject
        }
    }

    min-width: 100px;
    height: 24px;
    vertical-stretch: 0;
    horizontal-stretch: 1;

    accessible-role: slider;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;

    function value-from-x(x: length) -> float {
        return clamp(root.minimum + (x / root.width) * (root.maximum - root.minimum), root.minimum, root.maximum);
    }

    track := Rectangle {
        // Visible focus, so a keyboard user can see which slider the arrow
        // keys are about to move.
        border-width: slider-focus.has-focus ? 2px : 0px;
        border-color: Theme.accent-text;
        y: parent.height / 2 - 2px;
        height: 4px;
        width: parent.width;
        border-radius: 2px;
        background: Theme.track-background;

        Rectangle {
            x: 0px;
            y: 0px;
            height: 100%;
            width: parent.width * (root.value - root.minimum) / max(0.0001, root.maximum - root.minimum);
            border-radius: 2px;
            background: Theme.accent;
        }
    }

    thumb := Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: Theme.accent;
        border-width: 2px;
        border-color: white;
        y: parent.height / 2 - self.height / 2;
        x: clamp((parent.width - self.width) * (root.value - root.minimum) / max(0.0001, root.maximum - root.minimum), 0px, parent.width - self.width);
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.value = root.value-from-x(self.pressed-x);
            root.changed(root.value);
        }
        moved => {
            if self.pressed {
                root.value = root.value-from-x(self.mouse-x);
                root.changed(root.value);
            }
        }
    }
}

// A from-scratch on/off switch, standing in for std-widgets' `CheckBox`.
// Same reasoning as `AccentSlider` above: the native checkbox's check-mark
// follows the Windows system accent color, not `Theme.accent`, and its
// square box doesn't match the animated pill-and-knob look asked for here.
// Where the hovered setting's description lives while it is showing.
//
// One shared surface at window level rather than a popup per icon. The
// first attempt used a `PopupWindow` anchored to each icon, which
// flickered badly: the popup opened under the pointer, took the hover away
// from the icon that opened it, which closed the popup, which gave the
// hover back -- several times a second. A plain rectangle drawn last, with
// no `TouchArea` anywhere in it, cannot take a hover and so cannot
// oscillate.
global TooltipState {
    in-out property <string> text: "";
    in-out property <bool> visible: false;
    in-out property <length> anchor-x: 0;
    in-out property <length> anchor-y: 0;
    in-out property <float> scale: 1.0;
}

// Spec §0 "Explain everything": no feature ships without a one-sentence
// description in the UI, and the spec is explicit that these ship "as
// tooltips or inline help".
//
// This is the tooltip form -- a circled "i" that reveals its sentence on
// hover, so the explanation is one glance away without a wall of grey text
// under every slider. The description is also the accessible label, so a
// screen reader reads it without needing to trigger the hover.
component HelpIcon {
    in property <string> text;
    in property <float> text-scale: 1.0;

    // Fixed footprint so showing or hiding a description never reflows the
    // settings list under the pointer.
    width: 18px;
    height: 18px;
    horizontal-stretch: 0;

    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        border-width: 1px;
        border-color: touch.has-hover ? Theme.accent : Theme.muted-text;
        background: touch.has-hover ? Theme.accent-wash : transparent;

        accessible-role: AccessibleRole.text;
        accessible-label: root.text;

        Text {
            text: "i";
            font-size: 11px * root.text-scale;
            font-weight: 700;
            color: touch.has-hover ? Theme.accent : Theme.muted-text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            changed has-hover => {
                if (self.has-hover) {
                    TooltipState.text = root.text;
                    TooltipState.anchor-x = root.absolute-position.x;
                    TooltipState.anchor-y = root.absolute-position.y;
                    TooltipState.scale = root.text-scale;
                    TooltipState.visible = true;
                } else if (TooltipState.text == root.text) {
                    // Only the icon that currently owns the tooltip may
                    // hide it. Sweeping from one icon to the next fires
                    // the new icon's enter before the old one's leave, and
                    // without this guard the leave would blank the
                    // description that just appeared.
                    TooltipState.visible = false;
                }
            }
        }
    }
}

component ToggleSwitch {
    in property <string> text: "";
    in property <string> help: "";
    in property <float> text-scale: 1.0;
    in property <bool> reduced-motion: false;
    in property <bool> enabled: true;
    in-out property <bool> checked: false;
    callback toggled();

    min-height: 24px;
    horizontal-stretch: 1;
    opacity: root.enabled ? 1.0 : 0.5;

    // Spec §7 keyboard-only navigation. A control built from a TouchArea
    // is invisible to the keyboard unless it is given a FocusScope, which
    // is why every custom widget here needs one -- the built-in Slint
    // widgets get this for free and these do not.
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.checked = !root.checked;
                root.toggled();
                return accept;
            }
            reject
        }
    }

    accessible-role: checkbox;
    accessible-checked: root.checked;
    accessible-label: root.text;
    accessible-action-default => {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        pill := Rectangle {
            width: 40px;
            height: 22px;
            border-radius: 11px;
            y: (parent.height - self.height) / 2;
            background: root.checked ? Theme.accent : Theme.track-background;
            // Focus has to be *visible*, or keyboard navigation is a maze
            // with the lights off.
            border-width: focus.has-focus ? 2px : 0px;
            border-color: Theme.accent-text;
            animate background { duration: reduced-motion ? 0ms : 150ms; }

            knob := Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: white;
                y: 2px;
                x: root.checked ? parent.width - self.width - 2px : 2px;
                animate x { duration: reduced-motion ? 0ms : 150ms; easing: ease-out; }
            }

            TouchArea {
                enabled: root.enabled;
                clicked => {
                    root.checked = !root.checked;
                    root.toggled();
                }
            }
        }

        if root.text != "" : Text {
            text: root.text;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: root.help == "" ? 1 : 0;
        }

        // The description belongs on the control's own row. Left floating
        // on a line of its own it reads as an unattached icon between two
        // settings, with nothing saying which one it explains.
        if root.help != "" : HelpIcon {
            text-scale: root.text-scale;
            text: root.help;
            y: (parent.height - self.height) / 2;
        }
        if root.help != "" : Rectangle { horizontal-stretch: 1; }
    }
}

// A settings label with its description attached -- the slider equivalent
// of `ToggleSwitch.help`.
component SettingLabel {
    in property <string> text;
    in property <string> help;
    in property <float> text-scale: 1.0;
    in property <bool> muted: true;

    min-height: 18px;
    horizontal-stretch: 1;

    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Text {
            text: root.text;
            color: root.muted ? Theme.muted-text : Palette.foreground;
            font-size: 11px * root.text-scale;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        if root.help != "" : HelpIcon {
            text-scale: root.text-scale;
            text: root.help;
            y: (parent.height - self.height) / 2;
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

// A standard saturation/value square + hue bar picker, replacing the
// three stacked R/G/B sliders (narrower, and lets you land on a color by
// eye instead of dialing three numbers). HSV math itself lives in Rust
// (see `hsv_to_rgb`/`rgb_to_hsv` in main.rs) since `.slint` expressions
// have no modulo/floor to do the piecewise HSV->RGB conversion cleanly --
// this component only owns the raw h/s/v numbers and the pointer math to
// drag them, and asks Rust (via `changed`) to turn the result into a color.
component ColorPicker {
    in-out property <float> hue: 0; // 0..360
    in-out property <float> sat: 1; // 0..1
    in-out property <float> val: 1; // 0..1
    // The fully-saturated, full-brightness color at the current hue alone
    // (i.e. hsv(hue, 1, 1)) -- Rust computes this and pushes it in, since
    // that conversion needs the same Rust-side HSV math as `changed` below.
    in property <color> hue-preview: red;
    callback changed();

    // Deliberately narrower than the settings pane, not stretched to fill
    // it -- a full-width SV square would dwarf the hex field/swatch next
    // to it for no benefit; the picker only needs to be big enough to
    // click a color accurately.
    horizontal-stretch: 0;
    width: 200px;

    VerticalBox {
        padding: 0px;
        spacing: 8px;

        sv-square := Rectangle {
            height: 110px;
            border-radius: 6px;
            clip: true;
            background: root.hue-preview;

            Rectangle {
                x: 0px; y: 0px; width: 100%; height: 100%;
                background: @linear-gradient(90deg, white 0%, root.hue-preview.with-alpha(0) 100%);
            }
            Rectangle {
                x: 0px; y: 0px; width: 100%; height: 100%;
                background: @linear-gradient(180deg, transparent 0%, black 100%);
            }

            sv-indicator := Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                border-width: 2px;
                border-color: white;
                x: clamp(root.sat, 0, 1) * (parent.width - self.width);
                y: (1 - clamp(root.val, 0, 1)) * (parent.height - self.height);
            }

            sv-touch := TouchArea {
                width: 100%;
                height: 100%;
                moved => {
                    if self.pressed {
                        root.sat = clamp(self.mouse-x / self.width, 0, 1);
                        root.val = 1 - clamp(self.mouse-y / self.height, 0, 1);
                        root.changed();
                    }
                }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.sat = clamp(self.mouse-x / self.width, 0, 1);
                        root.val = 1 - clamp(self.mouse-y / self.height, 0, 1);
                        root.changed();
                    }
                }
            }
        }

        hue-bar := Rectangle {
            height: 14px;
            border-radius: 7px;
            clip: true;
            background: @linear-gradient(90deg,
                #ff0000 0%, #ffff00 16.67%, #00ff00 33.33%, #00ffff 50%,
                #0000ff 66.67%, #ff00ff 83.33%, #ff0000 100%);

            hue-indicator := Rectangle {
                width: 6px;
                height: 100%;
                border-width: 2px;
                border-color: white;
                x: clamp(root.hue / 360, 0, 1) * (parent.width - self.width);
            }

            hue-touch := TouchArea {
                width: 100%;
                height: 100%;
                moved => {
                    if self.pressed {
                        root.hue = clamp(self.mouse-x / self.width, 0, 1) * 360;
                        root.changed();
                    }
                }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.hue = clamp(self.mouse-x / self.width, 0, 1) * 360;
                        root.changed();
                    }
                }
            }
        }
    }
}

// A round avatar: a user-picked image (PNG/JPG/GIF -- GIFs show their
// first frame only, Slint's `Image` element doesn't animate) if one's set,
// otherwise the same colored-circle-plus-initial fallback the app always
// used. One component so the compact profile bar and the larger profile
// popup can't drift out of sync with each other visually.
component ProfileAvatar {
    in property <length> size: 36px;
    in property <bool> has-image: false;
    in property <image> img;
    in property <string> initial: "Y";
    // Same fit/rotate/crop controls as the theme background image (see
    // Appearance > Theme), applied here too -- "the same editor for
    // profile pictures so users can adjust them." 0 cover, 1 contain
    // (letterboxed), 2 stretch, 3 original.
    in property <int> fit: 0;
    in property <float> rotation: 0;
    in property <float> crop-left: 0;
    in property <float> crop-top: 0;
    in property <float> crop-right: 0;
    in property <float> crop-bottom: 0;

    width: root.size;
    height: root.size;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.size / 2;
        clip: true;
        background: Theme.accent;

        if root.has-image : Image {
            width: 100%;
            height: 100%;
            source: root.img;
            image-fit: root.fit == 0 ? ImageFit.cover : root.fit == 1 ? ImageFit.contain : root.fit == 2 ? ImageFit.fill : ImageFit.preserve;
            transform-rotation: root.rotation * 1deg;
            source-clip-x: round(root.img.width * root.crop-left / 100);
            source-clip-y: round(root.img.height * root.crop-top / 100);
            source-clip-width: round(root.img.width - root.img.width * root.crop-left / 100 - root.img.width * root.crop-right / 100);
            source-clip-height: round(root.img.height - root.img.height * root.crop-top / 100 - root.img.height * root.crop-bottom / 100);
        }
        if !root.has-image : Text {
            text: root.initial;
            color: white;
            font-weight: 700;
            font-size: root.size * 0.4;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// A scaled-down mock of the app window, so the background image's fit,
// rotation, crop and opacity can be judged against what they'll actually
// look like -- the settings pane itself covers most of the real window, so
// adjusting these blind was guesswork. Mirrors the real background layer's
// composition exactly: colour underneath, image over it at its own opacity,
// the whole layer faded by the window-opacity setting, with stand-in panels
// on top to show how much of it a real panel will cover.
component WallpaperPreview {
    in property <bool> custom-mode: false;
    in property <color> bg-color;
    in property <bool> has-image: false;
    in property <image> img;
    in property <float> image-opacity: 0.5;
    in property <float> window-opacity: 1.0;
    in property <int> fit: 0;
    in property <float> rotation: 0;
    in property <float> crop-left: 0;
    in property <float> crop-top: 0;
    in property <float> crop-right: 0;
    in property <float> crop-bottom: 0;

    height: 132px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.divider;
        clip: true;
        // A checkerboard-ish base so window transparency reads as
        // see-through rather than as "a darker colour".
        background: #7a7a7a;

        Rectangle {
            x: 0px;
            y: 0px;
            width: 50%;
            height: 50%;
            background: #5e5e5e;
        }
        Rectangle {
            x: parent.width / 2;
            y: parent.height / 2;
            width: 50%;
            height: 50%;
            background: #5e5e5e;
        }

        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            background: root.custom-mode ? root.bg-color : Palette.background;
            opacity: root.window-opacity;

            if root.has-image : Image {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                source: root.img;
                image-fit: root.fit == 0 ? ImageFit.cover : root.fit == 1 ? ImageFit.contain : root.fit == 2 ? ImageFit.fill : ImageFit.preserve;
                transform-rotation: root.rotation * 1deg;
                opacity: root.image-opacity;
                source-clip-x: round(root.img.width * root.crop-left / 100);
                source-clip-y: round(root.img.height * root.crop-top / 100);
                source-clip-width: round(root.img.width - root.img.width * root.crop-left / 100 - root.img.width * root.crop-right / 100);
                source-clip-height: round(root.img.height - root.img.height * root.crop-top / 100 - root.img.height * root.crop-bottom / 100);
            }
        }

        // Stand-in widgets, at roughly the proportions real panels occupy.
        Rectangle {
            x: 10px;
            y: 12px;
            width: 40%;
            height: 44px;
            border-radius: 4px;
            background: Palette.background;
            border-width: 1px;
            border-color: Theme.divider;
        }
        Rectangle {
            x: 10px;
            y: 66px;
            width: 40%;
            height: 30px;
            border-radius: 4px;
            background: Palette.background;
            border-width: 1px;
            border-color: Theme.divider;
        }
        Rectangle {
            x: parent.width * 0.55;
            y: 12px;
            width: 36%;
            height: 84px;
            border-radius: 4px;
            background: Palette.background;
            border-width: 1px;
            border-color: Theme.divider;
        }
    }
}

// One "Action .... [Key] [Change] [Clear]" row in the Keybinds tab.
// `id` is the binding's name on the Rust side, passed straight back
// through the callbacks so one capture flow serves every shortcut.
component KeybindRow {
    in property <string> label;
    in property <string> id;
    in property <string> key-name;
    in property <bool> capturing: false;
    in property <bool> clearable: true;
    in property <float> text-scale: 1.0;
    callback change();
    callback clear();

    height: 34px;
    vertical-stretch: 0;

    HorizontalBox {
        padding: 0px;
        spacing: 8px;
        Text { text: root.label; vertical-alignment: center; font-size: 13px * root.text-scale; }
        Rectangle { horizontal-stretch: 1; }
        Rectangle {
            width: 88px;
            border-radius: 4px;
            background: Theme.track-background;
            Text {
                text: root.capturing ? "press a key" : (root.key-name == "" ? "unbound" : root.key-name);
                color: root.capturing ? Theme.accent-text : (root.key-name == "" ? Theme.muted-text : Palette.foreground);
                font-family: "Consolas";
                font-size: 12px * root.text-scale;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Button { text: "Change"; enabled: !root.capturing; clicked => { root.change(); } }
        if root.clearable : Button { text: "Clear"; enabled: root.key-name != ""; clicked => { root.clear(); } }
    }
}

// Spec §0 "Explain everything": no feature ships without a one-sentence
// description in the UI. This is that sentence, in one place so every
// setting explains itself the same way instead of each section
// hand-rolling a muted Text with slightly different size and wrapping.
// Plain language on purpose -- the rule is that if a user has to google
// what a setting does, the setting is broken.
// Spec §0 "Explain everything": no feature ships without a one-sentence
// description in the UI, and the spec is explicit that these ship "as
// tooltips or inline help".
//
// This is the tooltip form -- a circled "i" that reveals its sentence on
// hover, so the explanation is one glance away without a wall of grey text
// under every slider. The description is also the accessible label, so a
// screen reader reads it without needing to trigger the hover.
//
// Kept as one component so every setting explains itself identically
// rather than each section hand-rolling its own affordance.
component TabButton {
    in property <string> label;
    in property <bool> active;
    in property <bool> reduced-motion: false;
    callback clicked();

    tab-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    height: 36px;
    horizontal-stretch: 0;
    min-width: 88px;

    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selectable: true;
    accessible-item-selected: root.active;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        border-radius: 6px;
        background: active ? Theme.accent : (touch.has-hover ? Theme.panel-hover : transparent);

        animate background { duration: reduced-motion ? 0ms : 100ms; }

        touch := TouchArea {
            clicked => { root.clicked(); }
        }

        Text {
            text: root.label;
            color: active ? white : Palette.foreground;
            font-weight: active ? 700 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component SideNavButton {
    in property <string> label;
    in property <bool> active;
    in property <bool> reduced-motion: false;
    callback clicked();

    nav-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    height: 34px;
    horizontal-stretch: 0;

    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selectable: true;
    accessible-item-selected: root.active;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        border-radius: 6px;
        background: active ? Theme.accent-wash : (touch.has-hover ? Theme.panel-hover : transparent);
        border-width: nav-focus.has-focus ? 2px : 0px;
        border-color: Theme.accent-text;
        animate background { duration: reduced-motion ? 0ms : 100ms; }

        touch := TouchArea {
            clicked => { root.clicked(); }
        }

        Rectangle {
            x: 0px;
            width: 3px;
            height: parent.height;
            background: active ? Theme.accent : transparent;
            border-radius: 1.5px;
        }

        Text {
            x: 12px;
            text: root.label;
            color: active ? Theme.accent-text : Palette.foreground;
            font-weight: active ? 700 : 400;
            vertical-alignment: center;
        }
    }
}

// A draggable, resizable panel for the Call tab's freeform "Edit layout"
// mode -- the app-wide widget-based layout customization, applied first to
// the tab where placing things by hand actually makes sense (a fixed list
// of settings rows doesn't benefit from freeform x/y the way a HUD-style
// call screen does).
//
// The title bar and resize handle track their OWN drag directly (standard
// Slint idiom: `self.mouse-x - self.pressed-x` inside a `moved` handler on
// Purely visual/layout -- no `TouchArea`s of its own. An earlier version
// had the title bar and resize handle each track their own drag directly
// (`self.mouse-x - self.pressed-x`), on the theory that since Slint
// pointer capture stays with whichever element received the press, that
// element tracking its own gesture would sidestep needing a stable
// external coordinate frame. In practice that still moved slower than the
// pointer and stuttered -- panel-x/y/width/height changing *is* that
// element's own geometry changing mid-gesture, and empirically that's not
// as drift-free as the math suggested it should be. The actual fix: hit
// detection and all continuous drag/resize math now live on ONE
// stationary, canvas-sized `TouchArea` (see the Call tab's `canvas`/`hit`
// below) that manually checks each panel's *current* rect rather than
// relying on any single panel's own local coordinates -- a frame that
// truly never moves has no drift to reason about in the first place.
component FreeformPanel {
    in property <string> title;
    in property <length> panel-x;
    in property <length> panel-y;
    in property <length> panel-width: 200px;
    in property <length> panel-height: 120px;
    in property <bool> editing: false;
    // True for the brief moment Rust is correcting a drag's drop point to
    // the nearest open (non-overlapping) grid slot -- animates just that
    // correction. Live dragging itself stays instant/unanimated (bound to
    // `false` the rest of the time), since animating *every* position
    // update would make dragging visibly lag behind the pointer.
    in property <bool> animating: false;
    // The profile widget can be moved/resized like any other panel but,
    // unlike the rest, can never be hidden or removed -- it's the app's
    // one guaranteed way back to itself (Settings, mute/deafen). `false`
    // just skips rendering the x button; hit-testing for it already lives
    // in the canvas, not here, so there's nothing else to gate.
    in property <bool> removable: true;
    // A Slint `VerticalBox` splits leftover space *equally* among children
    // when none of them claim it with `vertical-stretch`, which is why
    // every panel's buttons and text fields were growing to absurd heights
    // in a panel taller than its content. The trailing spacer below claims
    // that slack instead, so children keep their natural size. Panels whose
    // content wants to fill the height itself (Chat pins its input row to
    // the bottom) set `content-fills` and supply their own spacer.
    in property <bool> content-fills: false;
    callback remove-clicked();

    x: panel-x;
    y: panel-y;
    width: panel-width;
    height: panel-height;
    animate x, y { duration: root.animating ? 200ms : 0ms; easing: ease-out; }

    Rectangle {
        width: 100%;
        height: 100%;
        background: Palette.background;
        border-radius: 8px;
        border-width: root.editing ? 2px : 1px;
        border-color: root.editing ? Theme.accent : Theme.divider;
        clip: true;

        VerticalBox {
            padding: 10px;
            spacing: 6px;
            HorizontalBox {
                padding: 0px;
                Text { text: root.title; font-weight: 700; font-size: 10px; color: Theme.muted-text; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                if root.editing && root.removable : remove-touch := TouchArea {
                    width: 14px;
                    height: 14px;
                    clicked => { root.remove-clicked(); }
                    Text {
                        text: "x";
                        color: remove-touch.has-hover ? Theme.accent-text : Theme.muted-text;
                        font-weight: 700;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Content that doesn't fit the panel's current size scrolls
            // vertically instead of getting silently clipped -- resizing a
            // panel down shouldn't make its bottom controls simply vanish.
            // Horizontal scrolling is deliberately off: the inner content's
            // width is pinned to the panel's own (minus the scrollbar's
            // width), which is what actually makes `wrap: word-wrap` on
            // text inside do anything -- a `ScrollView` left to size its
            // content at its natural width never gives wrapping a
            // narrower-than-natural width to wrap against, so text just
            // stayed on one line and the view scrolled sideways instead.
            content-scroll := ScrollView {
                vertical-stretch: 1;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                VerticalBox {
                    width: content-scroll.width - 14px;
                    padding: 0px;
                    spacing: 6px;
                    @children
                    if !root.content-fills : Rectangle { vertical-stretch: 1; }
                }
            }
        }

        if root.editing : Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 26px;
            background: Theme.panel-hover;
            opacity: 0.5;
        }

        if root.editing : Rectangle {
            x: parent.width - 16px;
            y: parent.height - 16px;
            width: 16px;
            height: 16px;
            border-radius: 4px;
            background: Theme.accent-wash;
            Text {
                text: "//";
                color: Theme.muted-text;
                font-size: 9px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// A labeled, collapsible header bar. Deliberately *not* the container for
// its section's content (Slint's `@children` placeholder can't live inside
// an `if`, and collapsing had to actually remove the content from layout --
// not just hide it -- or collapsing left a blank gap behind). So each call
// site pairs one of these with its own `if <expanded-prop> : { ... }` block
// right below it; see the Settings tab for the pattern.
component SectionHeader {
    in property <string> title;
    in property <string> help: "";
    in property <float> text-scale: 1.0;
    in property <bool> reduced-motion: false;
    in-out property <bool> expanded: true;
    // "Edit layout" mode: reveals up/down reorder buttons on the right of
    // the header. `can-move-*` disables the one at whichever end of the
    // list this section is currently at, rather than letting it wrap or
    // silently no-op.
    in property <bool> editing: false;
    in property <bool> can-move-up: true;
    in property <bool> can-move-down: true;
    callback move-up();
    callback move-down();

    height: 32px;
    vertical-stretch: 0;

    header-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.expanded = !root.expanded;
                return accept;
            }
            reject
        }
    }

    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.expanded = !root.expanded; }

    Rectangle {
        border-radius: 6px;
        background: header-touch.has-hover ? Theme.panel-hover : transparent;
        border-width: header-focus.has-focus ? 2px : 0px;
        border-color: Theme.accent-text;
        animate background { duration: reduced-motion ? 0ms : 100ms; }

        header-touch := TouchArea {
            clicked => { root.expanded = !root.expanded; }
        }

        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            spacing: 8px;
            Text {
                text: root.expanded ? "-" : "+";
                color: Theme.muted-text;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
                width: 14px;
            }
            Text {
                text: root.title;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            // What the whole section is for, attached to its heading
            // rather than floating above the first control inside it.
            if root.help != "" : HelpIcon {
                text-scale: root.text-scale;
                text: root.help;
                y: (parent.height - self.height) / 2;
            }

            if !root.editing : Rectangle { horizontal-stretch: 1; }
            if root.editing : Rectangle { horizontal-stretch: 1; }

            if root.editing : HorizontalLayout {
                spacing: 2px;
                horizontal-stretch: 0;

                up-rect := Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 4px;
                    opacity: root.can-move-up ? 1.0 : 0.35;
                    background: up-touch.has-hover && root.can-move-up ? Theme.panel-hover : transparent;
                    Text { text: "^"; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    up-touch := TouchArea {
                        enabled: root.can-move-up;
                        clicked => { root.move-up(); }
                    }
                }
                down-rect := Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 4px;
                    opacity: root.can-move-down ? 1.0 : 0.35;
                    background: down-touch.has-hover && root.can-move-down ? Theme.panel-hover : transparent;
                    Text { text: "v"; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    down-touch := TouchArea {
                        enabled: root.can-move-down;
                        clicked => { root.move-down(); }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    // Bound rather than fixed so two instances running different profiles
    // are tellable apart in the taskbar, which is the whole point of
    // being able to run two.
    in-out property <string> window-title: "Antiphon";
    title: window-title;
    icon: @image-url("tray-icon.png");
    min-width: 560px;
    min-height: 480px;
    preferred-width: 640px;
    preferred-height: 560px;
    // Left transparent so the composited background layer below (which is
    // what actually paints the window) can fade toward see-through -- the
    // winit backend already creates the surface with alpha support, so an
    // opaque `background` here would just paint over that and hide it.
    background: transparent;
    // Cascades to every text element window-wide, including native widget
    // labels (Button/CheckBox/etc.) that don't set their own font-family --
    // unlike `text-scale` below, which only multiplies font sizes on Text
    // elements this file wrote directly.
    default-font-family: font-family-choice;

    in-out property <string> font-family-choice: "";
    /// Names of the built-in font choices, including the dyslexia-friendly
    /// option (spec §7). Supplied by Rust so the list and what each one
    /// resolves to are decided in one place.
    in-out property <[string]> font-choices: [];
    in-out property <string> font-choice-note: "";
    callback pick-font-choice(int);
    // Set once a font imported via "Import font..." registers successfully
    // (its family name, extracted from the file itself -- Rust owns that
    // extraction). Shown in the Font section and used to tell an imported
    // font apart from the built-in System/Monospace/Serif choices.
    in-out property <string> font-import-message: "";
    callback import-font();
    in-out property <color> accent-choice: #2d7d5a;
    changed accent-choice => { Theme.accent = accent-choice; }

    // The ColorPicker (saturation/value square + hue bar) and the hex text
    // field are two views onto the same `accent-choice` color; Rust keeps
    // them in sync (HSV<->RGB and hex parsing/formatting aren't things the
    // `.slint` expression language can do on its own) rather than trying
    // to bind them to each other directly.
    in-out property <float> accent-hue: 145;
    in-out property <float> accent-sat: 0.64;
    in-out property <float> accent-val: 0.49;
    in-out property <color> accent-hue-preview: #2dff8a;
    in-out property <string> accent-hex-display: "#2d7d5a";
    callback accent-color-picker-changed();
    callback accent-hex-changed(string);

    // Theme mode: 0 system, 1 light, 2 dark, 3 custom. Custom reveals its
    // own background ColorPicker below, same pattern as the accent color --
    // and independently, an optional background image and an overall
    // window-opacity slider that apply regardless of mode.
    in-out property <color> theme-bg-color: #202020;
    in-out property <float> theme-bg-hue: 0;
    in-out property <float> theme-bg-sat: 0;
    in-out property <float> theme-bg-val: 0.13;
    in-out property <color> theme-bg-hue-preview: red;
    in-out property <string> theme-bg-hex-display: "#202020";
    callback theme-bg-color-picker-changed();
    callback theme-bg-hex-changed(string);

    in-out property <image> theme-bg-image;
    in-out property <bool> theme-bg-image-set: false;
    // Bumped by Rust every time a new load (or a clear) targets this image
    // slot, so an in-flight GIF animation's self-rescheduling timer chain
    // knows to stop once it's no longer the current one -- see
    // `animated_image`'s doc comment.
    in-out property <int> theme-bg-gif-generation: 0;
    in-out property <int> avatar-gif-generation: 0;
    in-out property <float> theme-image-opacity: 0.5;
    in-out property <string> theme-image-message: "";
    // 0 cover (fill + crop to preserve aspect), 1 contain (fit within,
    // may letterbox), 2 stretch (fill, ignores aspect ratio), 3 original
    // (1:1 pixels, cropped like cover but never up/downscaled).
    in-out property <int> theme-image-fit: 0;
    in-out property <float> theme-image-rotation: 0; // degrees, -180..180
    // Percent (0..100) trimmed off each source-image edge before fitting.
    in-out property <float> theme-image-crop-left: 0;
    in-out property <float> theme-image-crop-top: 0;
    in-out property <float> theme-image-crop-right: 0;
    in-out property <float> theme-image-crop-bottom: 0;
    callback import-theme-image();
    callback clear-theme-image();

    // How much of whatever's behind the window shows through the app's own
    // background -- the background layer's opacity, not the whole window's
    // (buttons/text/panels stay fully opaque so the UI stays legible).
    in-out property <float> theme-opacity: 1.0;

    // Per-tab section order for the "Edit layout" reorder controls. Rust
    // owns the actual swap logic (see `move-*-section`); these just hold
    // whatever order it last computed, and the `.slint` side dispatches on
    // the id string to render each section's already-written content in
    // that order -- Slint has no dynamic component lookup to do this any
    // more directly than an if/else-if chain.
    in-out property <[string]> audio-order: ["presets", "callcontrols", "gate", "hpf", "deesser", "eq", "comp", "limiter", "pitch", "reverb"];
    in-out property <[string]> appearance-order: ["accent", "theme", "textmotion", "importexport"];
    in-out property <[string]> profile-order: ["profile", "about"];
    in-out property <bool> editing-layout: false;
    in-out property <length> sidebar-width: 148px;

    // Call tab freeform panel layout -- see `FreeformPanel` for how the
    // drag/resize math works. Defaults roughly reproduce the original
    // stacked-GroupBox look, just as independently movable/resizable panels.
    in-out property <bool> call-editing-layout: false;
    in-out property <length> call-connect-x: 0px;
    in-out property <length> call-connect-y: 0px;
    in-out property <length> call-connect-width: 540px;
    in-out property <length> call-connect-height: 190px;
    in-out property <length> call-filetransfer-x: 550px;
    in-out property <length> call-filetransfer-y: 0px;
    in-out property <length> call-filetransfer-width: 320px;
    in-out property <length> call-filetransfer-height: 340px;
    // The profile widget -- unlike the other five, always visible (see
    // `FreeformPanel.removable`), so it has no `call-panel-visible-profile`
    // to go with it.
    in-out property <length> call-profile-x: 550px;
    in-out property <length> call-profile-y: 350px;
    in-out property <length> call-profile-width: 320px;
    in-out property <length> call-profile-height: 130px;
    in-out property <length> call-chat-x: 550px;
    in-out property <length> call-chat-y: 500px;
    in-out property <length> call-chat-width: 320px;
    in-out property <length> call-chat-height: 220px;
    in-out property <bool> call-panel-visible-chat: true;
    in-out property <length> call-contacts-x: 900px;
    in-out property <length> call-contacts-y: 0px;
    in-out property <length> call-contacts-width: 320px;
    in-out property <length> call-contacts-height: 300px;
    in-out property <bool> call-panel-visible-contacts: true;
    // Spec §4: the invite QR as a panel you can move, resize or hide,
    // rather than something only reachable through settings. Off by
    // default -- a code that identifies you should be on screen because
    // you put it there.
    in-out property <length> call-invite-x: 550px;
    in-out property <length> call-invite-y: 350px;
    in-out property <length> call-invite-width: 260px;
    in-out property <length> call-invite-height: 300px;
    in-out property <bool> call-panel-visible-invite: false;

    // Contacts / servers (spec §3 "Known contacts"). Rust owns the list
    // (it lives in config, outliving any one call); this is the rendered
    // copy plus the add-form's working fields.
    in-out property <[ContactEntry]> contacts: [];
    in-out property <string> new-contact-name: "";
    in-out property <string> new-contact-address: "";
    in-out property <bool> new-contact-is-server: false;
    // The peer's display name when they've asked to be added, "" otherwise.
    in-out property <string> friend-request-from: "";
    in-out property <string> contacts-message: "";

    // Trust state for the peer on the current call (spec §4 "Knowing it's
    // really them"). The handshake proves the peer holds a key; these say
    // whether it is the key we expected.
    in-out property <string> peer-fingerprint: "";
    in-out property <bool> peer-key-changed: false;
    in-out property <bool> peer-verified: false;
    in-out property <string> peer-trust-message: "";
    callback mark-peer-verified();
    callback add-contact();
    callback remove-contact(int);
    /// Spec §9: per-contact ring permission.
    callback set-contact-ring-rule(int, int);
    /// Spec §4: hand a contact's key to the person on this call.
    callback introduce-contact(int);
    in-out property <string> introduction-message: "";
    callback call-contact(int);
    callback set-contact-connection-mode(int, int);
    callback send-friend-request();
    callback accept-friend-request();
    callback reject-friend-request();

    // In-call text chat (spec §4). Rust owns the log; this is just the
    // rendered copy plus the input line's working text.
    in-out property <[ChatMessage]> chat-messages: [];
    /// Message lifecycle (spec §13). Editing reuses the same input box:
    /// a second field for edits would sit empty almost always.
    in-out property <int> chat-editing-id: -1;
    callback edit-chat-message(int, string);
    callback delete-chat-message(int);
    callback pin-chat-message(int, bool);
    /// Adds or removes our reaction (spec §13).
    callback react-to-message(int, string);
    in-out property <[string]> reaction-choices: [];
    /// Disappearing messages for the current contact, in seconds. 0 = off.
    in-out property <int> chat-expire-secs: 0;
    callback chat-expire-changed(int);
    in-out property <string> chat-input: "";
    callback send-chat-message(string);
    // Spec §8: one line saying how many messages are still waiting, so a
    // queue that is not moving is visible rather than only discoverable
    // message by message.
    in-out property <string> outbox-summary: "";

    // Replay (spec §2): save the rolling last-30s of received audio.
    in-out property <string> replay-message: "";
    callback save-replay();
    // Spec §2 replay history: the few seconds around each moment the
    // network damaged, kept so "what did they just say?" has an answer.
    in-out property <[string]> replay-clips: [];
    callback play-replay-clip(int);
    callback clear-replay-clips();

    // Spec §2 connection-quality readout, formatted by Rust: call
    // duration, frames delivered, frames concealed and loss percent.
    in-out property <string> call-stats: "";

    // Server console (the view the app relaunches into when server mode is
    // on): command echo/output lines, the prompt's working text, and the
    // command dispatch callback -- see `on_terminal_command` in main.rs.
    in-out property <[string]> terminal-lines: [];
    in-out property <string> terminal-input: "";
    callback terminal-command(string);
    // Whether each Call tab panel is shown at all -- the "remove" half of
    // "add and remove widgets", toggled from the profile widget's menu or a
    // panel's own x button.
    in-out property <bool> call-panel-visible-connect: true;
    in-out property <bool> call-panel-visible-filetransfer: true;
    // See `FreeformPanel.animating`'s doc comment -- set true only for the
    // instant Rust corrects a drop point to the nearest open grid slot.
    in-out property <bool> call-panel-snap-animating: false;

    // File transfer (spec §5) -- state read from `ActiveCall::file_transfer`
    // by main.rs's UI timer, same polling pattern as `mic-level`/PTT.
    in-out property <bool> ft-offer-pending: false;
    in-out property <string> ft-offer-name: "";
    in-out property <string> ft-offer-size: "";
    /// Sender-generated preview (spec §5), empty when there is none.
    in-out property <image> ft-offer-thumbnail;
    /// Whether the file can still be fetched, in plain words.
    in-out property <string> ft-availability: "";
    /// Why a file couldn't be offered (spec §5), when that happens.
    in-out property <string> ft-send-error: "";
    in-out property <bool> ft-outgoing-active: false;
    in-out property <string> ft-outgoing-name: "";
    in-out property <float> ft-outgoing-progress: 0;
    in-out property <string> ft-outgoing-error: "";
    in-out property <bool> ft-incoming-active: false;
    in-out property <string> ft-incoming-name: "";
    in-out property <float> ft-incoming-progress: 0;
    in-out property <string> ft-incoming-error: "";
    in-out property <string> ft-status-message: "";
    callback send-file();
    callback accept-file-offer();
    callback reject-file-offer();
    callback cancel-file-transfer();
    // Spec §5: hold a send without losing it. Distinct from cancelling --
    // the transfer, the receiver's partial file and the agreed chunk
    // numbering all survive, so resuming continues rather than restarts.
    callback set-transfer-paused(bool);
    in-out property <bool> ft-outgoing-paused: false;

    // The canvas's own live size, for Rust's collision-clamping math to
    // clamp against -- bound straight from the `canvas` element itself
    // (see its `width`/`height` bindings below) rather than duplicated,
    // so it can't drift out of sync with it. Slint doesn't allow a
    // property declared here to reference a nested element's id directly,
    // so the binding runs the other way: `canvas` pushes its own size
    // into these instead of these pulling from it.
    in-out property <length> call-canvas-width: 2000px;
    in-out property <length> call-canvas-height: 2000px;
    // Shared by all four panels (id "connect"/"controls"/"miclevel"/
    // "mictest"), same reasoning as `move-audio-section` above: one
    // callback plus an id string, not sixteen near-identical ones.
    callback call-panel-drag-started(string);
    callback call-panel-drag-moved(string, length, length);
    callback call-panel-drag-finished(string);
    callback call-panel-resize-started(string);
    callback call-panel-resize-moved(string, length, length);
    callback call-panel-resize-finished(string);

    callback move-audio-section(string, int);
    callback move-appearance-section(string, int);
    callback move-profile-section(string, int);

    // NAT traversal (spec §3): the public address a STUN server reports
    // for our socket, and the state of a hole-punch attempt.
    in-out property <string> public-address: "";
    in-out property <string> nat-status: "";
    in-out property <bool> nat-busy: false;
    callback discover-public-address();
    // Spec §10: NAT-PMP. Separate from Find on purpose -- Find says what
    // your address looks like, this is what makes it reachable, and one
    // button for both would make a failure of either read as a failure of
    // both.
    callback open-port-automatically();
    in-out property <bool> port-mapped: false;
    in-out property <[ReachabilityRow]> reachability-rows: [];
    // Asked and refused, as distinct from never asked.
    in-out property <bool> port-forward-refused: false;
    // Spec §3: how this call is actually carried, and what that means.
    in-out property <string> call-mode: "Direct";
    in-out property <string> call-mode-explanation: "";
    callback start-punch();

    in-out property <string> status-text: "Not connected";
    in-out property <bool> connected: false;
    in-out property <string> remote-address: "127.0.0.1:6001";
    in-out property <string> local-port: "6002";
    in-out property <bool> muted: false;
    in-out property <bool> deafened: false;
    in-out property <bool> ptt-held: false;
    in-out property <float> mic-level: 0;
    in-out property <bool> ptt-toggle: false;
    in-out property <bool> mute-hold: false;
    in-out property <bool> deafen-hold: false;
    in-out property <float> ptt-release-ms: 0;
    in-out property <bool> loopback-enabled: false;
    in-out property <string> loopback-message: "";
    // Spec §1 "Mic Test & Record Preview".
    in-out property <string> mic-test-message: "";
    in-out property <bool> mic-test-running: false;
    callback mic-test();
    callback toggle-loopback();
    in-out property <bool> monitor-enabled: false;
    in-out property <int> monitor-latency-ms: 120;
    in-out property <int> current-tab: 0;
    in-out property <int> settings-category: 0;

    // Settings search (spec §0). Rust owns the filtering and writes the
    // narrowed section orders back, so the `for section-id in ...-order`
    // loops below need no search-specific conditionals.
    /// Saved call-screen arrangements (spec §7).
    /// Soundboard (spec §13).
    /// Voice messages (spec §13).
    in-out property <bool> voice-recording: false;
    in-out property <string> voice-message-status: "";
    callback start-voice-message();
    callback stop-voice-message();

    in-out property <[string]> sound-clip-names: [];
    in-out property <string> soundboard-message: "";
    callback add-sound-clip();
    callback remove-sound-clip(int);
    /// `to_peer` false means play it to yourself only.
    callback play-sound-clip(int, bool);

    in-out property <[ThemePresetEntry]> theme-presets: [];
    callback apply-theme-preset(string);

    in-out property <[string]> layout-names: [];
    in-out property <string> new-layout-name: "";
    in-out property <string> layout-message: "";
    callback save-layout(string);
    callback load-layout(string);
    callback delete-layout(string);

    in-out property <string> settings-search: "";
    in-out property <string> settings-search-summary: "";
    /// The device pickers / level meter / mic test block at the top of the
    /// Audio tab is always on screen, so a search has to hide it
    /// explicitly or every query still shows it.
    in-out property <bool> show-audio-fixed-block: true;
    callback settings-search-changed(string);

    // Call tab (spec §3/§9).
    in-out property <[string]> call-order: [];
    in-out property <bool> sec-callstart: true;
    in-out property <bool> sec-callparticipants: true;
    in-out property <bool> sec-soundboard: true;
    in-out property <bool> sec-notifications: true;
    in-out property <bool> sec-transferlimits: true;
    in-out property <bool> sec-sharedfiles: true;
    in-out property <bool> sec-discovery: true;
    in-out property <bool> sec-outbox: true;
    in-out property <bool> sec-calladvanced: true;
    in-out property <bool> ip-direct-calling: false;
    // Spec §3: the relay this machine listens at, "" for none.
    in-out property <string> relay-server: "";
    callback new-invite-secret();
    /// Ring rules (spec §9 "Receiver settings always win", §13 schedules).
    /// Getting-started prompt (spec §13). Empty title means nothing to
    /// show, so the banner disappears entirely rather than sitting blank.
    /// Moderation (spec §9). Blocking is keyed to the person.
    in-out property <[string]> blocked-names: [];
    in-out property <bool> peer-blocked: false;
    in-out property <string> moderation-message: "";
    // Set from `moderation::BLOCK_EXPLANATION` / `REPORT_EXPLANATION` so
    // the wording lives in one place -- a second copy here is how the
    // promise and the behaviour drift apart.
    in-out property <string> block-explanation: "";
    in-out property <string> report-explanation: "";
    callback block-peer();
    callback unblock-at(int);
    callback report-peer(string);

    in-out property <string> onboard-title: "";
    in-out property <string> onboard-body: "";
    callback dismiss-onboarding();

    /// File transfer bandwidth limits (spec §5).
    in-out property <int> upload-kbps: 0;
    in-out property <bool> throttle-during-calls: true;
    in-out property <int> in-call-kbps: 256;
    in-out property <string> transfer-limit-note: "";

    in-out property <bool> crash-reporting: false;
    in-out property <int> default-ring-rule: 0;
    in-out property <bool> quiet-hours-enabled: false;
    in-out property <int> quiet-hours-start: 1380; // 23:00
    in-out property <int> quiet-hours-end: 420;    // 07:00
    in-out property <bool> start-with-screen-share: false;
    in-out property <bool> start-with-camera: false;
    in-out property <bool> mute-others-by-default: false;
    in-out property <bool> mute-self-on-join: false;
    /// Your own shareable ID, derived from the identity key.
    /// Your presence (spec §7), and the peer's as reported to you.
    /// Replay window and behaviour (spec §2).
    in-out property <int> replay-seconds: 30;
    in-out property <int> replay-mode: 0;
    // Spec §8: how long an undelivered message keeps trying. 0 is never
    // give up, which is the default.
    in-out property <int> outbox-give-up-hours: 0;
    in-out property <[RouteEntry]> routes: [];
    in-out property <bool> strict-mode: false;
    in-out property <bool> route-fan-out: false;
    in-out property <bool> hold-mail: false;
    in-out property <int> hold-mail-port: 3480;
    in-out property <string> found-nodes: "";
    in-out property <string> delivery-notice: "";
    in-out property <string> leave-message-text: "";
    callback route-toggled(int, bool);
    callback route-move(int, int);
    callback route-nodes-edited(int, string);
    callback route-code-edited(int, string);
    callback delivery-settings-changed();
    callback find-nodes();
    // Spec §5 seeding and pinning.
    in-out property <bool> seeding: false;
    in-out property <int> seed-scope: 0;
    in-out property <int> seed-port: 3481;
    in-out property <string> pin-nodes: "";
    in-out property <string> pin-code: "";
    in-out property <[SharedFileEntry]> shared-files: [];
    callback sharing-settings-changed();
    // Spec §6: bring your own VPN.
    in-out property <bool> sec-vpn: true;
    in-out property <bool> vpn-enabled: false;
    in-out property <bool> vpn-route-voice: false;
    in-out property <bool> vpn-route-files: true;
    in-out property <bool> vpn-route-messages: true;
    in-out property <bool> vpn-kill-switch: false;
    in property <[VpnConfigEntry]> vpn-configs: [];
    in property <string> vpn-status: "";
    in property <string> vpn-message: "";
    callback vpn-settings-changed();
    callback import-vpn-config();
    callback select-vpn-config(string);
    callback delete-vpn-config(string);
    callback check-shared-files();
    callback download-shared-file(string);
    callback forget-shared-file(string);
    // Spec §4 discovery: the DHT and community directories.
    in-out property <bool> dht-enabled: false;
    in-out property <string> dht-bootstrap: "";
    in-out property <string> dht-status: "";
    in-out property <string> directories: "";
    in-out property <string> directory-status: "";
    in-out property <[DirectoryEntry]> directory-entries: [];
    callback dht-settings-changed();
    callback browse-directories();
    callback join-directory-entry(string, string);
    callback set-contact-message-route(int, int);
    callback leave-message(int);
    /// Shown when audio was recovered, if the mode asks for it.
    in-out property <string> replay-notice: "";
    // Spec §2 "Ask me": a clip is waiting behind a Replay button.
    in-out property <bool> replay-ask: false;
    // Spec §3 group calls: everyone in the call, you included, and the
    // names of everyone beyond the person you're connected to.
    in-out property <int> group-people: 2;
    in-out property <string> group-names: "";
    callback replay-settings-changed();

    in-out property <int> my-presence: 0;
    in-out property <string> presence-note: "";
    callback presence-changed(int);
    in-out property <string> peer-presence-label: "";

    in-out property <string> my-share-id: "";
    callback copy-share-id();
    /// Full invite link (`antiphon://<id>@<address>`) and its QR code.
    in-out property <string> my-invite-link: "";
    in-out property <image> my-invite-qr;
    in-out property <bool> my-invite-has-address: false;
    callback refresh-invite();
    /// Pasting someone else's invite to add them.
    in-out property <string> new-contact-invite: "";
    callback add-from-invite();
    /// Recovery phrase (spec §3 "Backup & recovery"). Hidden until asked
    /// for -- anyone who reads it becomes you.
    /// Searching your own stored history with the current peer (spec
            /// section 9), and the count of matches.
    in-out property <string> history-query: "";
    in-out property <string> history-result: "";
    callback search-history(string);
    /// Deletes the stored messages for one contact, keeping the contact.
    callback forget-history(int);
    in-out property <string> recovery-phrase: "";
    in-out property <bool> recovery-phrase-shown: false;
    callback toggle-recovery-phrase();
    in-out property <int> recovery-split-choice: 0;
    in-out property <string> recovery-shares: "";
    in-out property <bool> recovery-shares-shown: false;
    callback toggle-recovery-shares();

    in-out property <string> display-name: "You";
    // Rust-computed (first character of display-name, uppercased) for the
    // profile bar's avatar circle -- Slint's expression language doesn't
    // have a string-indexing/uppercase operation to do this in `.slint`.
    in-out property <string> display-initial: "Y";
    in-out property <string> status-message: "Online";
    in-out property <string> peer-display-name: "";
    // Spec §4 "Verification code": derived from both identity keys, so it
    // is the same string on both ends and different for anyone in the
    // middle.
    in-out property <string> verification-code: "";
    in-out property <string> peer-status-message: "";

    // Profile widget (the persistent bottom-left bar + its popup): a
    // user-picked avatar image, the popup's open/closed state, and which
    // pieces of info the compact bar itself shows -- the popup, being the
    // "full detail" view, always shows everything regardless of these.
    in-out property <image> profile-avatar-image;
    in-out property <bool> profile-avatar-image-set: false;
    in-out property <string> profile-avatar-message: "";
    in-out property <bool> profile-popup-open: false;
    in-out property <bool> profile-widget-show-avatar: true;
    in-out property <bool> profile-widget-show-name: true;
    in-out property <bool> profile-widget-show-status: true;
    // Same fit/rotate/crop editor as the theme background image -- see
    // `ProfileAvatar`'s doc comment.
    in-out property <int> avatar-image-fit: 0;
    in-out property <float> avatar-image-rotation: 0;
    in-out property <float> avatar-image-crop-left: 0;
    in-out property <float> avatar-image-crop-top: 0;
    in-out property <float> avatar-image-crop-right: 0;
    in-out property <float> avatar-image-crop-bottom: 0;
    callback import-profile-avatar();
    callback clear-profile-avatar();

    in-out property <bool> gate-enabled: true;
    in-out property <float> gate-threshold: -45;
    // Spec §1 lists attack/hold/release as gate controls. They were fixed
    // constants in `read_chain_config` before -- real DSP parameters the
    // user had no way to reach, which is exactly what §0 "User choice"
    // rules out.
    in-out property <float> gate-attack: 5;
    in-out property <float> gate-hold: 150;
    in-out property <float> gate-release: 120;
    in-out property <bool> hpf-enabled: true;
    in-out property <float> hpf-cutoff: 80;
    // The low-pass stage existed in `antiphon-audio` and was wired into the
    // chain, but nothing in the GUI ever set it -- `read_chain_config`
    // wrote `LowPassConfig::default()` unconditionally, so the stage was
    // unreachable from the app.
    in-out property <bool> lpf-enabled: false;
    in-out property <float> lpf-cutoff: 12000;
    in-out property <bool> deesser-enabled: true;
    in-out property <float> deesser-threshold: -26;
    in-out property <float> deesser-ratio: 4;
    in-out property <float> deesser-split: 4000;
    in-out property <float> deesser-attack: 3;
    in-out property <float> deesser-release: 40;
    /// Live gate attenuation in dB (spec §1's gate meter).
    in-out property <float> gate-attenuation-db: 0;
    /// Per-person volume trim and mute for whoever is on the call (spec §1
    /// "Per-User Volume"). Saved against the contact, so it sticks.
    in-out property <float> peer-volume-db: 0;
    in-out property <bool> peer-muted: false;
    // Spec §1 "Per-User EQ", as three tone controls rather than a full
    // parametric editor: the problem being solved is "their microphone is
    // boomy / harsh", which three knobs answer, and a per-contact band
    // editor would be a lot of surface for a rare need.
    in-out property <float> peer-bass-db: 0;
    in-out property <float> peer-voice-db: 0;
    in-out property <float> peer-treble-db: 0;
    /// Ducking depth in dB (spec §1). Zero is off.
    in-out property <int> duck-db: 0;
    callback peer-audio-changed();
    in-out property <bool> comp-enabled: true;
    in-out property <float> comp-threshold: -22;
    in-out property <float> comp-ratio: 3;
    in-out property <bool> limiter-enabled: true;
    in-out property <float> limiter-ceiling: -1;
    in-out property <bool> gain-auto: true;
    in-out property <float> gain-target: -18;

    in-out property <bool> pitch-enabled: false;
    in-out property <float> pitch-semitones: 0;
    in-out property <bool> reverb-enabled: false;
    in-out property <float> reverb-room-size: 0.5;
    in-out property <float> reverb-damping: 0.5;
    in-out property <float> reverb-wet: 0.3;

    // Per-section collapse state within the Audio and Profile categories
    // (spec-adjacent request: labeled, collapsible groups instead of one
    // long undifferentiated scroll). EQ/Pitch/Reverb/About start collapsed
    // since they're the least likely to need a glance on every visit.
    in-out property <bool> sec-presets: true;
    in-out property <bool> sec-callcontrols: true;
    in-out property <bool> sec-aec: true;
    in-out property <bool> sec-denoise: true;
    in-out property <bool> ns-enabled: true;
    in-out property <float> ns-strength: 1.0;
    in-out property <bool> ns-neural: true;
    in-out property <bool> sec-gate: true;
    in-out property <bool> sec-hpf: true;
    in-out property <bool> sec-lpf: true;
    in-out property <bool> sec-deesser: true;
    in-out property <bool> sec-eq: false;
    in-out property <bool> sec-comp: true;
    in-out property <bool> sec-limiter: true;
    in-out property <bool> sec-pitch: false;
    in-out property <bool> sec-reverb: false;
    in-out property <bool> sec-profile: true;
    in-out property <bool> sec-about: false;
    in-out property <bool> sec-accent: true;
    in-out property <bool> sec-theme: true;
    in-out property <bool> sec-textmotion: true;
    in-out property <bool> sec-importexport: false;

    in-out property <[string]> input-devices: ["System default"];
    in-out property <[string]> output-devices: ["System default"];
    in-out property <string> selected-input-device: "System default";
    in-out property <string> selected-output-device: "System default";
    in-out property <float> output-gain-db: 0;

    // General tab: settings about the app's own behavior rather than any
    // one feature.
    in-out property <bool> sections-expanded-default: true;

    // Named voice presets (spec §1). Rust owns the list; this is the
    // rendered copy plus the name box for saving a new one.
    in-out property <[PresetEntry]> voice-presets: [];
    in-out property <string> new-preset-name: "";
    in-out property <string> preset-message: "";
    in-out property <bool> pitch-preserve-formants: true;
    callback save-preset();
    callback load-preset(int);
    callback delete-preset(int);
    callback export-preset(int);
    callback import-preset();

    // 0 push-to-talk, 1 voice activation, 2 open mic.
    in-out property <int> transmit-mode: 0;
    in-out property <float> va-threshold: 0.05;
    in-out property <string> ptt-key-name: "Space";
    // Which binding the "press a key" capture is currently filling in, ""
    // when idle. One capture flow serves every shortcut rather than five
    // near-identical ones.
    in-out property <string> capturing-binding: "";
    /// Why a key was refused, or why one never arrived (spec §1).
    in-out property <string> binding-warning: "";
    in-out property <string> mute-key-name: "";
    in-out property <string> deafen-key-name: "";
    in-out property <string> hangup-key-name: "";
    in-out property <string> replay-key-name: "";
    callback capture-binding(string);
    callback clear-binding(string);

    // Auto-listen on startup instead of waiting for the user to press
    // Listen -- always-on and reachable, the honest meaning of "server
    // mode" for a P2P call (there's no real client/server split once
    // connected).
    in-out property <bool> server-mode: false;

    // 0 = follow system, 1 = light, 2 = dark.
    in-out property <int> theme-mode: 0;
    in-out property <float> text-scale: 1.0;
    in-out property <bool> reduced-motion: false;
    in-out property <bool> start-maximized: false;
    in-out property <string> import-export-message: "";

    changed theme-mode => {
        Palette.color-scheme = theme-mode == 1 ? ColorScheme.light : theme-mode == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    in-out property <[EqBand]> eq-bands: [];
    in-out property <string> eq-curve-svg: "";

    callback start-listen();
    callback start-call();
    /// Tells the peer this is a silent call (spec §9).
    callback send-silent-marker();
    callback escalate-call();
    // Spec §9: whether the *next* call started from this window is a
    // knock. Read into the greeting when the call opens, so the intent
    // travels with the first thing sent rather than arriving after the
    // other end has already decided what to do.
    in-out property <bool> start-call-silently: false;
    // Spec §1 echo cancellation. Off by default -- see `echo_cancel.rs`.
    in-out property <bool> echo-cancel: false;
    in-out property <float> echo-erle-db: 0;
    // 0 own button only, 1 own button + Shift+click Call, 2 inverted.
    in-out property <int> silent-call-mode: 0;
    // True once this side has knocked, so the withdrawal is offered only
    // where it means something.
    in-out property <bool> knocked: false;
    callback hang-up();
    callback toggle-mute();
    callback toggle-deafen();
    callback settings-changed();
    callback profile-changed();
    callback export-settings();
    callback import-settings();
    /// Spec §13 data export: everything, in a form readable without this app.
    callback export-all-data();
    callback server-mode-changed();
    callback device-changed();
    callback toggle-monitor();
    callback eq-toggle(int);
    callback eq-set-freq(int, string);
    callback eq-set-gain(int, string);
    callback eq-set-q(int, string);
    callback eq-add-band();
    callback eq-remove-band(int);
    callback eq-set-type(int, int);
    in-out property <[string]> eq-preset-names: [];
    callback eq-load-preset(string);
    /// Live gain reduction from the compressor, in dB (spec §1's "gain
    /// reduction meter"). Zero when no audio is flowing.
    in-out property <float> comp-gain-reduction-db: 0;
    callback eq-curve-drag(float, float);

    // The Theme background layer -- declared first so it paints behind
    // everything else (Slint z-orders siblings by declaration order). Its
    // own opacity is `theme-opacity`, independent of the rest of the UI,
    // which is why it's a separate layer rather than something set on
    // `background` directly: fading it doesn't touch panel/text/button
    // opacity above it.
    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: theme-mode == 3 ? theme-bg-color : Palette.background;
        opacity: theme-opacity;

        if theme-bg-image-set : Image {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            source: theme-bg-image;
            image-fit: theme-image-fit == 0 ? ImageFit.cover : theme-image-fit == 1 ? ImageFit.contain : theme-image-fit == 2 ? ImageFit.fill : ImageFit.preserve;
            transform-rotation: theme-image-rotation * 1deg;
            opacity: theme-image-opacity;
            source-clip-x: round(theme-bg-image.width * theme-image-crop-left / 100);
            source-clip-y: round(theme-bg-image.height * theme-image-crop-top / 100);
            source-clip-width: round(theme-bg-image.width - theme-bg-image.width * theme-image-crop-left / 100 - theme-bg-image.width * theme-image-crop-right / 100);
            source-clip-height: round(theme-bg-image.height - theme-bg-image.height * theme-image-crop-top / 100 - theme-bg-image.height * theme-image-crop-bottom / 100);
        }
    }

    VerticalBox {
        width: 100%;
        height: 100%;
        HorizontalBox {
            height: 32px;
            padding: 0px;
            Image { source: @image-url("tray-icon.png"); width: 24px; height: 24px; }
            Text { text: "Antiphon"; font-size: 17px * text-scale; font-weight: 700; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: status-text; vertical-alignment: center; color: connected ? Theme.accent-text : Theme.muted-text; }
        }

        HorizontalBox {
            height: 36px;
            padding: 0px;
            spacing: 6px;
            // Only a way back, not a tab switcher -- Settings is reached
            // from the profile widget's gear button (spec: "remove the
            // Settings button from the top left since there's one in the
            // profile widget"), so there's nothing to show here on the
            // Call tab itself.
            if current-tab == 1 : TabButton { label: "Return"; active: false; reduced-motion: reduced-motion; clicked => { current-tab = 0; } }
            Rectangle { horizontal-stretch: 1; }
        }

        // Server mode replaces the whole widget UI with a console -- the
        // profile widget/settings/canvas are all deliberately unreachable
        // (a headless-style server surface); "normal" typed at the prompt
        // relaunches back into the full UI.
        if server-mode : Rectangle {
            vertical-stretch: 1;
            background: #0a0f0a;
            border-radius: 8px;

            VerticalBox {
                padding: 12px;
                spacing: 4px;
                Text { text: "==[ antiphon :: server console ]=="; color: #4dff88; font-family: "Consolas"; font-size: 14px; font-weight: 700; }
                Text { text: status-text; color: #33cc66; font-family: "Consolas"; font-size: 12px; }
                if call-stats != "" : Text { text: call-stats; color: #2aa355; font-family: "Consolas"; font-size: 11px; }
                if connected && peer-display-name != "" : Text { text: "peer: " + peer-display-name; color: #33cc66; font-family: "Consolas"; font-size: 11px; }
                Rectangle { height: 1px; background: #1e3a28; }

                term-scroll := ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    VerticalBox {
                        width: term-scroll.width - 14px;
                        padding: 0px;
                        spacing: 2px;
                        for msg in chat-messages : Text {
                            text: "[chat] " + (msg.from-me ? "you" : (peer-display-name == "" ? "peer" : peer-display-name)) + ": " + msg.text;
                            color: #7dffa8;
                            font-family: "Consolas";
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        for line in terminal-lines : Text {
                            text: line;
                            color: #33ff77;
                            font-family: "Consolas";
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalBox {
                    padding: 0px;
                    spacing: 6px;
                    Text { text: ">"; color: #4dff88; font-family: "Consolas"; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                    LineEdit {
                        text <=> terminal-input;
                        placeholder-text: "type help";
                        accepted(v) => { terminal-command(v); }
                    }
                }
            }
        }

        if current-tab == 0 && !server-mode : VerticalBox {
            padding: 0px;
            spacing: 6px;

            // Edit layout and Widgets used to live in a toolbar here;
            // both moved into the profile widget's hamburger menu (see the
            // "Profile" `FreeformPanel` below) so they're reachable from
            // one consistent place instead of a second, separate control
            // surface floating above the canvas.
            if call-editing-layout : Text {
                text: "Editing layout: drag a panel's title bar to move it, or its bottom-right corner (//) to resize it. Click a panel's x to remove it.";
                wrap: word-wrap;
                color: Theme.muted-text;
                font-size: 11px * text-scale;
            }

            canvas := Rectangle {
                vertical-stretch: 1;
                clip: true;
                changed width => { call-canvas-width = self.width; }
                changed height => { call-canvas-height = self.height; }

                // Hit-testing and all continuous drag/resize math for every
                // panel happens on this ONE stationary TouchArea rather
                // than on each panel's own (moving) geometry -- see
                // `FreeformPanel`'s doc comment for why.
                function hits-title(px: length, py: length, rx: length, ry: length, rw: length) -> bool {
                    return px >= rx && px <= rx + rw && py >= ry && py <= ry + 26px;
                }
                function hits-resize(px: length, py: length, rx: length, ry: length, rw: length, rh: length) -> bool {
                    return px >= rx + rw - 16px && px <= rx + rw && py >= ry + rh - 16px && py <= ry + rh;
                }

                if call-editing-layout : hit := TouchArea {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 100%;

                    property <string> target: "";
                    property <string> mode: "";
                    property <length> press-x: 0px;
                    property <length> press-y: 0px;

                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            self.press-x = self.pressed-x;
                            self.press-y = self.pressed-y;
                            if hits-resize(self.pressed-x, self.pressed-y, call-profile-x, call-profile-y, call-profile-width, call-profile-height) {
                                self.target = "profile"; self.mode = "resize"; call-panel-resize-started("profile");
                            } else if call-panel-visible-contacts && hits-resize(self.pressed-x, self.pressed-y, call-contacts-x, call-contacts-y, call-contacts-width, call-contacts-height) {
                                self.target = "contacts"; self.mode = "resize"; call-panel-resize-started("contacts");
                            } else if call-panel-visible-chat && hits-resize(self.pressed-x, self.pressed-y, call-chat-x, call-chat-y, call-chat-width, call-chat-height) {
                                self.target = "chat"; self.mode = "resize"; call-panel-resize-started("chat");
                            } else if call-panel-visible-filetransfer && hits-resize(self.pressed-x, self.pressed-y, call-filetransfer-x, call-filetransfer-y, call-filetransfer-width, call-filetransfer-height) {
                                self.target = "filetransfer"; self.mode = "resize"; call-panel-resize-started("filetransfer");
                            } else if call-panel-visible-invite && hits-resize(self.pressed-x, self.pressed-y, call-invite-x, call-invite-y, call-invite-width, call-invite-height) {
                                self.target = "invite"; self.mode = "resize"; call-panel-resize-started("invite");
                            } else if call-panel-visible-connect && hits-resize(self.pressed-x, self.pressed-y, call-connect-x, call-connect-y, call-connect-width, call-connect-height) {
                                self.target = "connect"; self.mode = "resize"; call-panel-resize-started("connect");
                            } else if hits-title(self.pressed-x, self.pressed-y, call-profile-x, call-profile-y, call-profile-width) {
                                self.target = "profile"; self.mode = "drag"; call-panel-drag-started("profile");
                            } else if call-panel-visible-contacts && hits-title(self.pressed-x, self.pressed-y, call-contacts-x, call-contacts-y, call-contacts-width) {
                                self.target = "contacts"; self.mode = "drag"; call-panel-drag-started("contacts");
                            } else if call-panel-visible-chat && hits-title(self.pressed-x, self.pressed-y, call-chat-x, call-chat-y, call-chat-width) {
                                self.target = "chat"; self.mode = "drag"; call-panel-drag-started("chat");
                            } else if call-panel-visible-filetransfer && hits-title(self.pressed-x, self.pressed-y, call-filetransfer-x, call-filetransfer-y, call-filetransfer-width) {
                                self.target = "filetransfer"; self.mode = "drag"; call-panel-drag-started("filetransfer");
                            } else if call-panel-visible-invite && hits-title(self.pressed-x, self.pressed-y, call-invite-x, call-invite-y, call-invite-width) {
                                self.target = "invite"; self.mode = "drag"; call-panel-drag-started("invite");
                            } else if call-panel-visible-connect && hits-title(self.pressed-x, self.pressed-y, call-connect-x, call-connect-y, call-connect-width) {
                                self.target = "connect"; self.mode = "drag"; call-panel-drag-started("connect");
                            } else {
                                self.target = "";
                                self.mode = "";
                            }
                        } else if event.kind == PointerEventKind.up {
                            if self.mode == "drag" {
                                call-panel-drag-finished(self.target);
                            } else if self.mode == "resize" {
                                call-panel-resize-finished(self.target);
                            }
                            self.target = "";
                            self.mode = "";
                        }
                    }

                    moved => {
                        if self.mode == "drag" {
                            call-panel-drag-moved(self.target, self.mouse-x - self.press-x, self.mouse-y - self.press-y);
                        } else if self.mode == "resize" {
                            call-panel-resize-moved(self.target, self.mouse-x - self.press-x, self.mouse-y - self.press-y);
                        }
                    }
                }

                if onboard-title != "" : Rectangle {
                    x: 12px;
                    y: 12px;
                    width: min(420px, parent.width - 24px);
                    height: onboard-layout.preferred-height;
                    background: Palette.background;
                    border-color: Theme.accent;
                    border-width: 1px;
                    border-radius: 8px;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: #00000050;

                    onboard-layout := VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        Text {
                            text: onboard-title;
                            font-weight: 700;
                            font-size: 13px * text-scale;
                            color: Theme.accent-text;
                        }
                        Text {
                            text: onboard-body;
                            wrap: word-wrap;
                            font-size: 11px * text-scale;
                        }
                        HorizontalLayout {
                            alignment: end;
                            Button { text: "Got it"; clicked => { dismiss-onboarding(); } }
                        }
                    }
                }

                if call-panel-visible-connect : FreeformPanel {
                    title: "Connect";
                    panel-x: call-connect-x;
                    panel-y: call-connect-y;
                    panel-width: call-connect-width;
                    panel-height: call-connect-height;
                    editing: call-editing-layout;
                    animating: call-panel-snap-animating;
                    remove-clicked => { call-panel-visible-connect = false; settings-changed(); }

                    HorizontalBox {
                        padding: 0px;
                        Text { text: "Listen port:"; vertical-alignment: center; }
                        LineEdit { text <=> local-port; enabled: !connected; }
                        Button { text: "Listen"; enabled: !connected; clicked => { start-listen(); } }
                    }
                    // Raw address calling is off by default (Settings >
                    // Call > Advanced): a direct connection shows both
                    // sides each other's IP.
                    // Spec §9: a silent call knocks rather than rings. Its own
                    // button rather than a modifier on the main one -- a
                    // hidden Shift behaviour is undiscoverable, and this is
                    // a courtesy people should be able to find.
                    if connected && !knocked : Button {
                        text: "Knock (silent)";
                        clicked => { send-silent-marker(); knocked = true; }
                    }
                    // Spec §9: starting a call as a knock rather than
                    // turning one into a knock afterwards. Shown while
                    // disconnected, because that is when the choice can
                    // still be made.
                    if !connected : ToggleSwitch {
                        text: "Knock instead of ringing";
                        checked <=> start-call-silently;
                        reduced-motion: reduced-motion;
                        text-scale: text-scale;
                        help: silent-call-mode == 0
                            ? "Starts the call without asking for their attention -- they see you are there and answer when they want. Their own notification rules still decide; this can only ask for less, never more."
                            : "Starts the call without asking for their attention -- they see you are there and answer when they want. Shift+click on Call flips this for one call without changing the switch.";
                        toggled => { settings-changed(); }
                    }
                    // Spec §9: escalating a knock without hanging up and
                    // calling back. It withdraws your own silencing and
                    // nothing more -- their rules still decide, and a
                    // contact set never to ring still will not.
                    if connected && knocked : Button {
                        text: "Ring them after all";
                        clicked => { escalate-call(); knocked = false; }
                    }
                    if ip-direct-calling : HorizontalBox {
                        padding: 0px;
                        Text { text: "Call:"; vertical-alignment: center; }
                        LineEdit { text <=> remote-address; enabled: !connected; }
                        // Spec §9: Shift+click as an *alternative* to the
                        // checkbox, never the only way to reach it. The
                        // TouchArea sits on top only in the modes that
                        // want it, so an ordinary click still goes to the
                        // Button and keeps its keyboard behaviour.
                        Rectangle {
                            call-button := Button {
                                text: "Call";
                                enabled: !connected;
                                clicked => { start-call(); }
                            }
                            if silent-call-mode != 0 && !connected : TouchArea {
                                mouse-cursor: pointer;
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.up) {
                                        // Shift flips the switch for this
                                        // one call and puts it back after,
                                        // so a modifier never silently
                                        // changes a standing preference.
                                        if (event.modifiers.shift) {
                                            start-call-silently = !start-call-silently;
                                            start-call();
                                            start-call-silently = !start-call-silently;
                                        } else {
                                            start-call();
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if !ip-direct-calling && !connected : Text {
                        text: "Calling a raw IP is turned off. Call a saved contact instead, or turn it on in Settings > Call > Advanced.";
                        wrap: word-wrap;
                        color: Theme.muted-text;
                        font-size: 10px * text-scale;
                    }
                    Button { text: "Hang up"; enabled: connected; clicked => { hang-up(); } }

                    Rectangle { height: 1px; background: Theme.divider; }
                    Text { text: "Across the internet (NAT)"; font-weight: 700; font-size: 11px * text-scale; }
                    Text {
                        text: "Listen and Call above work on a local network. To reach someone in another house without port forwarding, use this instead.";
                        wrap: word-wrap;
                        color: Theme.muted-text;
                        font-size: 10px * text-scale;
                    }
                    HorizontalBox {
                        padding: 0px;
                        spacing: 6px;
                        LineEdit {
                            text: public-address;
                            read-only: true;
                            placeholder-text: "your public address appears here";
                        }
                        Button { text: "Find"; enabled: !nat-busy && !connected; clicked => { discover-public-address(); } }
                    }
                    Text {
                        text: "1. Press Find, then send that address to the other person. 2. Put their address in Call: above. 3. Both press Punch within a few seconds of each other.";
                        wrap: word-wrap;
                        color: Theme.muted-text;
                        font-size: 10px * text-scale;
                    }
                    HorizontalBox {
                        padding: 0px;
                        spacing: 6px;
                        Button {
                            text: port-mapped ? "Close forwarded port" : "Open my port on the router";
                            enabled: !nat-busy;
                            clicked => { open-port-automatically(); }
                        }
                        HelpIcon {
                            text-scale: text-scale;
                            text: "Asks your router to forward your port inward (NAT-PMP), so people can call *you* rather than only the other way round. Renewed automatically while the app is open, and closed again when you press this a second time or quit -- it deliberately expires on its own rather than being left open. Plenty of routers either do not support this or have it switched off, in which case nothing changes and you can still call out.";
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Button { text: nat-busy ? "Punching..." : "Punch"; enabled: !nat-busy && !connected; clicked => { start-punch(); } }
                    if nat-status != "" : Text { text: nat-status; color: Theme.muted-text; font-size: 10px * text-scale; wrap: word-wrap; }

                    // Spec §10's capability table. Three columns rather
                    // than prose: the questions are independent, and a
                    // paragraph makes people hunt for the one they care
                    // about.
                    for row in reachability-rows : VerticalBox {
                        padding: 0px;
                        spacing: 1px;
                        HorizontalBox {
                            padding: 0px;
                            spacing: 6px;
                            Text {
                                text: row.question;
                                font-size: 10px * text-scale;
                                font-weight: 700;
                                width: 110px;
                            }
                            Text {
                                text: row.answer;
                                font-size: 10px * text-scale;
                                color: row.answer == "Works" ? Theme.accent-text : Theme.muted-text;
                            }
                        }
                        Text {
                            text: row.meaning;
                            color: Theme.muted-text;
                            font-size: 9px * text-scale;
                            wrap: word-wrap;
                        }
                    }

                    if connected && verification-code != "" : VerticalBox {
                        padding: 0px;
                        spacing: 2px;
                        Text { text: "Verification code"; font-weight: 700; font-size: 11px * text-scale; }
                        Text {
                            text: verification-code;
                            font-family: "Consolas";
                            font-size: 12px * text-scale;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Read this aloud and check it matches on their screen. If it does, nobody is sitting in the middle of this call. If it doesn't, stop talking.";
                            wrap: word-wrap;
                            color: Theme.muted-text;
                            font-size: 10px * text-scale;
                        }

                        // Trust state for this peer's key (spec §4). The
                        // code above proves the call isn't intercepted
                        // *right now*; this says whether the key is the
                        // one we pinned last time.
                        if peer-fingerprint != "" : Text {
                            text: "Their key: \{peer-fingerprint}";
                            color: Theme.muted-text;
                            font-family: "Consolas";
                            font-size: 10px * text-scale;
                            wrap: word-wrap;
                        }
                        if peer-trust-message != "" : Text {
                            text: peer-trust-message;
                            color: peer-key-changed ? #e05252 : Theme.muted-text;
                            font-weight: peer-key-changed ? 700 : 400;
                            font-size: 10px * text-scale;
                            wrap: word-wrap;
                        }
                        if !peer-verified : Button {
                            text: peer-key-changed ? "Codes match -- trust the new key" : "Codes match -- mark verified";
                            clicked => { mark-peer-verified(); }
                        }
                        HorizontalBox {
                            padding: 0px;
                            spacing: 6px;
                            Button { text: "Block"; clicked => { block-peer(); } }
                            HelpIcon { text-scale: text-scale; text: block-explanation; }
                            Button { text: "Report"; clicked => { report-peer(""); } }
                            HelpIcon { text-scale: text-scale; text: report-explanation; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if moderation-message != "" : Text {
                            text: moderation-message;
                            color: Theme.muted-text;
                            font-size: 10px * text-scale;
                            wrap: word-wrap;
                        }
                    }
                    if connected : VerticalBox {
                        padding: 0px;
                        spacing: 2px;
                        ToggleSwitch {
                            text: "Mute them";
                            checked <=> peer-muted;
                            reduced-motion: reduced-motion;
                            text-scale: text-scale;
                            help: "Silences this person on your end only. They are not told, and it does not affect anyone else.";
                            toggled => { peer-audio-changed(); }
                        }
                        SettingLabel {
                            text: "Their volume: \{round(peer-volume-db)} dB";
                            help: "A per-person trim on top of the master volume, remembered against this contact -- so a quiet microphone stays fixed for every future call.";
                            text-scale: text-scale;
                        }
                        AccentSlider {
                            minimum: -24;
                            maximum: 12;
                            value <=> peer-volume-db;
                            changed(v) => { peer-audio-changed(); }
                        }
                        SettingLabel {
                            text: "Their tone";
                            help: "Fixes how their microphone sounds, on your end only -- they hear nothing different. Remembered against this contact, so a boomy or harsh microphone stays fixed for every future call. All three at 0 means no processing at all.";
                            text-scale: text-scale;
                        }
                        Text {
                            text: "Bass \{round(peer-bass-db)} dB";
                            color: Theme.muted-text;
                            font-size: 10px * text-scale;
                        }
                        AccentSlider {
                            minimum: -12;
                            maximum: 12;
                            value <=> peer-bass-db;
                            changed(v) => { peer-audio-changed(); }
                        }
                        Text {
                            text: "Voice \{round(peer-voice-db)} dB";
                            color: Theme.muted-text;
                            font-size: 10px * text-scale;
                        }
                        AccentSlider {
                            minimum: -12;
                            maximum: 12;
                            value <=> peer-voice-db;
                            changed(v) => { peer-audio-changed(); }
                        }
                        Text {
                            text: "Treble \{round(peer-treble-db)} dB";
                            color: Theme.muted-text;
                            font-size: 10px * text-scale;
                        }
                        AccentSlider {
                            minimum: -12;
                            maximum: 12;
                            value <=> peer-treble-db;
                            changed(v) => { peer-audio-changed(); }
                        }
                    }
                    // Spec §3: the mode in the call UI, with one line
                    // saying what it means. One mode exists today; naming
                    // it anyway is what makes the line worth reading when
                    // a second one arrives.
                    if connected : VerticalBox {
                        padding: 0px;
                        spacing: 1px;
                        HorizontalBox {
                            padding: 0px;
                            spacing: 6px;
                            Text {
                                text: "Connection: " + call-mode;
                                font-size: 11px * text-scale;
                                font-weight: 700;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Text {
                            text: call-mode-explanation;
                            color: Theme.muted-text;
                            font-size: 10px * text-scale;
                            wrap: word-wrap;
                        }
                    }
                    // Spec §3 group calls / §9: who else is here.
                    if connected && group-people > 2 : Text {
                        text: "Voice active · \{group-people} people -- also with \{group-names}";
                        font-size: 11px * text-scale;
                        wrap: word-wrap;
                    }
                    // Spec §2 "Ask me (popup button)".
                    if connected && replay-ask : HorizontalBox {
                        padding: 0px;
                        spacing: 6px;
                        Text {
                            text: "Their audio dropped out.";
                            font-size: 11px * text-scale;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "Replay it";
                            clicked => { replay-ask = false; play-replay-clip(0); }
                        }
                        Button {
                            text: "Dismiss";
                            clicked => { replay-ask = false; replay-notice = ""; }
                        }
                    }
                    if connected && peer-display-name != "" : Text {
                        text: peer-status-message != "" ? "With: \{peer-display-name} -- \{peer-status-message}" : "With: \{peer-display-name}";
                        color: Theme.muted-text;
                        font-size: 12px * text-scale;
                    }
                }

                if call-panel-visible-filetransfer : FreeformPanel {
                    title: "File Transfer";
                    panel-x: call-filetransfer-x;
                    panel-y: call-filetransfer-y;
                    panel-width: call-filetransfer-width;
                    panel-height: call-filetransfer-height;
                    editing: call-editing-layout;
                    animating: call-panel-snap-animating;
                    remove-clicked => { call-panel-visible-filetransfer = false; settings-changed(); }

                    if ft-send-error != "" : Text {
                        text: ft-send-error;
                        color: #e0a052;
                        font-size: 10px * text-scale;
                        wrap: word-wrap;
                    }
                    if ft-offer-pending : VerticalBox {
                        padding: 0px;
                        spacing: 6px;
                        Text { text: "Incoming file"; font-weight: 700; font-size: 11px * text-scale; }
                        Text { text: ft-offer-name; wrap: word-wrap; font-size: 11px * text-scale; }
                        Text { text: ft-offer-size; color: Theme.muted-text; font-size: 10px * text-scale; }
                        // Made by the sender, checked before decoding.
                        if ft-offer-thumbnail.width > 0 : Image {
                            source: ft-offer-thumbnail;
                            width: 64px;
                            height: 64px;
                            image-fit: contain;
                        }
                        if ft-availability != "" : Text {
                            text: ft-availability;
                            color: Theme.muted-text;
                            font-size: 10px * text-scale;
                            wrap: word-wrap;
                        }
                        HorizontalBox {
                            padding: 0px;
                            Button { text: "Accept"; clicked => { accept-file-offer(); } }
                            Button { text: "Reject"; clicked => { reject-file-offer(); } }
                        }
                    }

                    if !ft-offer-pending && ft-incoming-active : VerticalBox {
                        padding: 0px;
                        spacing: 6px;
                        Text { text: "Receiving: \{ft-incoming-name}"; wrap: word-wrap; font-size: 11px * text-scale; }
                        Rectangle {
                            height: 10px;
                            background: Theme.track-background;
                            border-radius: 5px;
                            clip: true;
                            Rectangle { x: 0px; y: 0px; height: 100%; width: parent.width * ft-incoming-progress; background: Theme.accent; }
                        }
                        Text { text: "\{round(ft-incoming-progress * 100)}%"; color: Theme.muted-text; font-size: 10px * text-scale; }
                        if ft-incoming-error != "" : Text { text: ft-incoming-error; color: Theme.muted-text; wrap: word-wrap; font-size: 10px * text-scale; }
                        Button { text: "Cancel"; clicked => { cancel-file-transfer(); } }
                    }

                    if !ft-offer-pending && !ft-incoming-active && ft-outgoing-active : VerticalBox {
                        padding: 0px;
                        spacing: 6px;
                        Text { text: "Sending: \{ft-outgoing-name}"; wrap: word-wrap; font-size: 11px * text-scale; }
                        Rectangle {
                            height: 10px;
                            background: Theme.track-background;
                            border-radius: 5px;
                            clip: true;
                            Rectangle { x: 0px; y: 0px; height: 100%; width: parent.width * ft-outgoing-progress; background: Theme.accent; }
                        }
                        Text {
                            text: ft-outgoing-paused
                                ? "\{round(ft-outgoing-progress * 100)}% -- paused"
                                : "\{round(ft-outgoing-progress * 100)}%";
                            color: Theme.muted-text;
                            font-size: 10px * text-scale;
                        }
                        if ft-outgoing-error != "" : Text { text: ft-outgoing-error; color: Theme.muted-text; wrap: word-wrap; font-size: 10px * text-scale; }
                        HorizontalBox {
                            padding: 0px;
                            spacing: 6px;
                            Button {
                                text: ft-outgoing-paused ? "Resume" : "Pause";
                                clicked => { set-transfer-paused(!ft-outgoing-paused); }
                            }
                            Button { text: "Cancel"; clicked => { cancel-file-transfer(); } }
                        }
                    }

                    if !ft-offer-pending && !ft-incoming-active && !ft-outgoing-active : VerticalBox {
                        padding: 0px;
                        spacing: 6px;
                        Text {
                            text: "Send a file to your peer over the same encrypted connection as the call.";
                            wrap: word-wrap;
                            color: Theme.muted-text;
                            font-size: 11px * text-scale;
                        }
                        Button { text: "Send file..."; enabled: connected; clicked => { send-file(); } }
                        if !connected : Text { text: "Connect to a peer first."; color: Theme.muted-text; font-size: 10px * text-scale; }
                        if ft-status-message != "" : Text { text: ft-status-message; color: Theme.muted-text; wrap: word-wrap; font-size: 10px * text-scale; }
                    }
                }

                if call-panel-visible-chat : FreeformPanel {
                    title: "Chat";
                    panel-x: call-chat-x;
                    panel-y: call-chat-y;
                    panel-width: call-chat-width;
                    panel-height: call-chat-height;
                    editing: call-editing-layout;
                    animating: call-panel-snap-animating;
                    content-fills: true;
                    remove-clicked => { call-panel-visible-chat = false; settings-changed(); }

                    if voice-message-status != "" : Text {
                        text: voice-message-status;
                        color: voice-recording ? #e05252 : Theme.muted-text;
                        font-size: 10px * text-scale;
                        wrap: word-wrap;
                    }
                    if connected : HorizontalBox {
                        padding: 0px;
                        spacing: 6px;
                        vertical-stretch: 0;
                        Text {
                            text: "Disappear after";
                            color: Theme.muted-text;
                            font-size: 10px * text-scale;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            model: ["Never", "1 hour", "1 day", "1 week"];
                            current-index: chat-expire-secs == 3600 ? 1
                                : chat-expire-secs == 86400 ? 2
                                : chat-expire-secs == 604800 ? 3
                                : 0;
                            selected(v) => {
                                chat-expire-changed(
                                    self.current-index == 1 ? 3600
                                    : self.current-index == 2 ? 86400
                                    : self.current-index == 3 ? 604800
                                    : 0
                                );
                            }
                        }
                        HelpIcon {
                            text-scale: text-scale;
                            text: "Deletes messages with this person from your device once they reach this age. Applies to messages sent from now on, and only on your side -- you cannot make their copy disappear.";
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if chat-messages.length == 0 : Text {
                        text: connected ? "Say something -- messages ride the same encrypted connection as the call." : "Chat opens up once you're on a call.";
                        wrap: word-wrap;
                        color: Theme.muted-text;
                        font-size: 11px * text-scale;
                    }
                    for msg in chat-messages : VerticalBox {
                        padding: 0px;
                        spacing: 1px;
                        HorizontalBox {
                            padding: 0px;
                            spacing: 4px;
                            Text {
                                text: (msg.pinned ? "* " : "") + (msg.from-me ? "You" : (peer-display-name == "" ? "Peer" : peer-display-name));
                                color: msg.from-me ? Theme.accent-text : Theme.muted-text;
                                font-size: 9px * text-scale;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            // Spec §8. Shown only while a message is still
                            // in the outbox: labelling every delivered line
                            // "Delivered" is noise, and noise is what stops
                            // people noticing the one that says otherwise.
                            if msg.delivery != "" && msg.delivery != "Delivered" : Text {
                                text: msg.delivery;
                                color: Theme.muted-text;
                                font-size: 9px * text-scale;
                                font-italic: true;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            // Pinning is local, so it is offered on anyone's
                            // message. Edit and delete are only offered on
                            // your own -- rewriting someone else's words
                            // would not be an edit.
                            if !msg.deleted : Text {
                                text: msg.pinned ? "unpin" : "pin";
                                color: pin-touch.has-hover ? Theme.accent-text : Theme.muted-text;
                                font-size: 9px * text-scale;
                                vertical-alignment: center;
                                pin-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { pin-chat-message(msg.id, !msg.pinned); }
                                }
                            }
                            if msg.from-me && !msg.deleted : Text {
                                text: "edit";
                                color: edit-touch.has-hover ? Theme.accent-text : Theme.muted-text;
                                font-size: 9px * text-scale;
                                vertical-alignment: center;
                                edit-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        chat-editing-id = msg.id;
                                        chat-input = msg.text;
                                    }
                                }
                            }
                            if msg.from-me && !msg.deleted : Text {
                                text: "delete";
                                color: del-touch.has-hover ? #e05252 : Theme.muted-text;
                                font-size: 9px * text-scale;
                                vertical-alignment: center;
                                del-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { delete-chat-message(msg.id); }
                                }
                            }
                        }
                        Text {
                            // Already formatted by `ChatEntry::display_text`
                            // -- deciding it again here would be a second
                            // place for the wording to drift.
                            text: msg.text;
                            wrap: word-wrap;
                            font-size: 12px * text-scale;
                            font-italic: msg.deleted;
                            color: msg.deleted ? Theme.muted-text : Palette.foreground;
                        }
                        // Says where a link goes without fetching anything
                        // from it. A preview that loaded the page would
                        // hand the sender your IP address before you had
                        // decided whether to trust them.
                        if msg.links != "" : Text {
                            text: msg.links;
                            color: Theme.muted-text;
                            font-size: 9px * text-scale;
                            wrap: word-wrap;
                        }
                        if msg.reactions != "" : Text {
                            text: msg.reactions;
                            font-size: 11px * text-scale;
                        }
                        if !msg.deleted : HorizontalBox {
                            padding: 0px;
                            spacing: 2px;
                            for choice in reaction-choices : Text {
                                text: choice;
                                font-size: 11px * text-scale;
                                opacity: react-touch.has-hover ? 1.0 : 0.35;
                                react-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { react-to-message(msg.id, choice); }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                    // Spacer + a non-stretching input row keeps the prompt
                    // pinned to the panel's bottom edge instead of letting
                    // the text field swell to fill the panel.
                    Rectangle { vertical-stretch: 1; }
                    if outbox-summary != "" : Text {
                        text: outbox-summary;
                        color: Theme.muted-text;
                        font-size: 10px * text-scale;
                        wrap: word-wrap;
                    }
                    HorizontalBox {
                        padding: 0px;
                        spacing: 6px;
                        vertical-stretch: 0;
                        LineEdit {
                            text <=> chat-input;
                            enabled: connected;
                            placeholder-text: chat-editing-id >= 0 ? "Editing..." : "Message...";
                            accepted(v) => {
                                if (chat-editing-id >= 0) {
                                    edit-chat-message(chat-editing-id, v);
                                    chat-editing-id = -1;
                                } else {
                                    send-chat-message(v);
                                }
                            }
                        }
                        if chat-editing-id >= 0 : Button {
                            text: "Cancel";
                            clicked => { chat-editing-id = -1; chat-input = ""; }
                        }
                        Button {
                            text: voice-recording ? "Stop & send" : "Record";
                            enabled: connected;
                            clicked => {
                                if (voice-recording) {
                                    stop-voice-message();
                                } else {
                                    start-voice-message();
                                }
                            }
                        }
                        Button { text: "Send"; enabled: connected && chat-input != ""; clicked => { send-chat-message(chat-input); } }
                    }
                }

                if call-panel-visible-invite : FreeformPanel {
                    title: "My Invite";
                    panel-x: call-invite-x;
                    panel-y: call-invite-y;
                    panel-width: call-invite-width;
                    panel-height: call-invite-height;
                    editing: call-editing-layout;
                    animating: call-panel-snap-animating;
                    remove-clicked => { call-panel-visible-invite = false; settings-changed(); }

                    if my-invite-qr.width > 0 : Image {
                        source: my-invite-qr;
                        // `contain` already keeps the square square inside
                        // whatever the panel was resized to. Sizing the
                        // width from the height instead would make width
                        // depend on a height that depends on width.
                        vertical-stretch: 1;
                        image-fit: contain;
                    }
                    Text {
                        text: my-invite-has-address
                            ? "Scan or send the link. It carries your ID and your current address."
                            : "This invite names you but has no address yet -- press Find in the Connect panel, then Refresh.";
                        color: Theme.muted-text;
                        font-size: 10px * text-scale;
                        wrap: word-wrap;
                    }
                    // Read-only rather than a Copy button: Slint has no
                    // clipboard API, so a button would have nothing to do.
                    // A field you can select from actually works.
                    LineEdit {
                        text: my-invite-link;
                        read-only: true;
                        font-size: 9px * text-scale;
                    }
                    Button { text: "Refresh"; clicked => { refresh-invite(); } }
                }

                if call-panel-visible-contacts : FreeformPanel {
                    title: "Contacts & Servers";
                    panel-x: call-contacts-x;
                    panel-y: call-contacts-y;
                    panel-width: call-contacts-width;
                    panel-height: call-contacts-height;
                    editing: call-editing-layout;
                    animating: call-panel-snap-animating;
                    remove-clicked => { call-panel-visible-contacts = false; settings-changed(); }

                    if friend-request-from != "" : Rectangle {
                        background: Theme.accent-wash;
                        border-radius: 6px;
                        VerticalBox {
                            padding: 8px;
                            spacing: 6px;
                            Text { text: friend-request-from + " wants to be added"; wrap: word-wrap; font-size: 11px * text-scale; font-weight: 700; }
                            HorizontalBox {
                                padding: 0px;
                                spacing: 6px;
                                Button { text: "Accept"; clicked => { accept-friend-request(); } }
                                Button { text: "Decline"; clicked => { reject-friend-request(); } }
                            }
                        }
                    }

                    if delivery-notice != "" : Text {
                        text: delivery-notice;
                        wrap: word-wrap;
                        font-size: 11px * text-scale;
                    }
                    LineEdit {
                        text <=> leave-message-text;
                        placeholder-text: "Write a message, then press Leave message on a contact";
                    }
                    if contacts.length == 0 : Text {
                        text: "No saved contacts yet. Add one below, or press \"Add current peer\" while on a call.";
                        wrap: word-wrap;
                        color: Theme.muted-text;
                        font-size: 11px * text-scale;
                    }
                    for c[i] in contacts : HorizontalBox {
                        padding: 0px;
                        spacing: 6px;
                        VerticalBox {
                            padding: 0px;
                            spacing: 0px;
                            horizontal-stretch: 1;
                            Text {
                                text: (c.is-server ? "[server] " : "") + c.name
                                    + (c.verified ? "  [verified]" : "")
                                    + (c.key-changed ? "  [KEY CHANGED]" : "");
                                font-size: 12px * text-scale;
                                font-weight: 600;
                                color: c.key-changed ? #e05252 : Palette.foreground;
                                overflow: elide;
                            }
                            Text { text: c.address; color: Theme.muted-text; font-size: 10px * text-scale; overflow: elide; }
                            Text {
                                text: c.fingerprint == "" ? "no key pinned yet" : c.fingerprint;
                                color: Theme.muted-text;
                                font-family: "Consolas";
                                font-size: 9px * text-scale;
                                overflow: elide;
                            }
                        }
                        ComboBox {
                            model: ["Rings", "Silent", "Never"];
                            current-index: c.ring-rule;
                            selected(v) => { set-contact-ring-rule(i, self.current-index); }
                        }
                        // Spec §3: the connection mode, chosen automatically
                        // and overridable per conversation.
                        ComboBox {
                            model: ["Auto", "Direct", "Relay"];
                            current-index: c.connection-mode;
                            selected(v) => { set-contact-connection-mode(i, self.current-index); }
                        }
                        // Spec §8 per-contact override for messages.
                        ComboBox {
                            model: ["Mail: their routes", "Mail: direct only"];
                            current-index: c.message-route;
                            selected(v) => { set-contact-message-route(i, self.current-index); }
                        }
                        Button {
                            text: "Leave message";
                            enabled: leave-message-text != "" && c.key != "";
                            clicked => { leave-message(i); }
                        }
                        Button {
                            text: "Introduce";
                            enabled: connected && c.fingerprint != "";
                            clicked => { introduce-contact(i); }
                        }
                        Button {
                            text: connected ? "Add" : "Call";
                            enabled: !connected || group-people < 5;
                            clicked => { call-contact(i); }
                        }
                        Button { text: "Forget"; clicked => { forget-history(i); } }
                        Button { text: "X"; clicked => { remove-contact(i); } }
                    }

                    Rectangle { height: 1px; background: Theme.divider; }
                    Button {
                        text: "Add current peer";
                        enabled: connected;
                        clicked => {
                            new-contact-name = peer-display-name == "" ? "Peer" : peer-display-name;
                            new-contact-address = remote-address;
                            add-contact();
                        }
                    }
                    Button { text: "Ask peer to add me"; enabled: connected; clicked => { send-friend-request(); } }

                    Rectangle { height: 1px; background: Theme.divider; }
                    SettingLabel { text: "Search history"; help: "Searches the messages stored on this device for the person you are on a call with. Nothing leaves your machine, and nothing is searched for people you have not saved as contacts."; text-scale: text-scale; }
                    LineEdit {
                        text <=> history-query;
                        placeholder-text: "Find in this conversation";
                        enabled: connected;
                        edited(v) => { search-history(v); }
                    }
                    if history-result != "" : Text {
                        text: history-result;
                        wrap: word-wrap;
                        color: Theme.muted-text;
                        font-size: 10px * text-scale;
                    }

                    if blocked-names.length > 0 : Rectangle { height: 1px; background: Theme.divider; }
                    if blocked-names.length > 0 : Text {
                        text: "Blocked";
                        font-size: 11px * text-scale;
                        font-weight: 600;
                    }
                    for name[bi] in blocked-names : HorizontalBox {
                        padding: 0px;
                        spacing: 6px;
                        Text { text: name; vertical-alignment: center; font-size: 11px * text-scale; overflow: elide; }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "Unblock"; clicked => { unblock-at(bi); } }
                    }

                    Rectangle { height: 1px; background: Theme.divider; }
                    Text { text: "Add from an invite"; font-size: 11px * text-scale; font-weight: 600; }
                    LineEdit {
                        text <=> new-contact-invite;
                        placeholder-text: "Paste antiphon://... invite";
                        accepted(v) => { add-from-invite(); }
                    }
                    HorizontalBox {
                        padding: 0px;
                        spacing: 6px;
                        Button { text: "Add from invite"; enabled: new-contact-invite != ""; clicked => { add-from-invite(); } }
                        HelpIcon {
                            text-scale: text-scale;
                            text: "Paste a link someone sent you. Their permanent ID is pinned straight away, so you will be warned if it ever changes -- but you still need to compare the verification code on your first call to be sure the link really came from them.";
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    LineEdit { text <=> new-contact-name; placeholder-text: "Name"; }
                    LineEdit { text <=> new-contact-address; placeholder-text: "host:port"; }
                    ToggleSwitch { text: "This is a server"; checked <=> new-contact-is-server; }
                    Button { text: "Add"; enabled: new-contact-name != "" && new-contact-address != ""; clicked => { add-contact(); } }
                    if introduction-message != "" : Text {
                        text: introduction-message;
                        color: Theme.muted-text;
                        font-size: 10px * text-scale;
                        wrap: word-wrap;
                    }
                    if contacts-message != "" : Text { text: contacts-message; color: Theme.muted-text; font-size: 10px * text-scale; wrap: word-wrap; }
                }

                // The profile widget: always present, never removable (see
                // `FreeformPanel.removable`) -- it's the app's one
                // guaranteed way back to itself. Avatar/name/status open
                // the profile popup; Mute/Deafen live here directly now
                // (not as separate buttons outside any widget); the
                // hamburger opens Settings/Edit layout/Widgets.
                //
                // The avatar/name/status row deliberately has NO `TouchArea`
                // while `call-editing-layout` is on: with one, it would sit
                // on top of (and steal clicks from) the canvas-level `hit`
                // layer's title-bar drag detection, since a nested
                // `TouchArea` always wins hit-testing over a sibling
                // declared earlier/further out -- so this panel would be
                // draggable everywhere except by its own header, unlike
                // every other panel. Two near-identical copies of the same
                // row (one wrapped in a click handler, one not) is simpler
                // and more obviously correct than trying to make one
                // TouchArea conditionally transparent to hits.
                FreeformPanel {
                    title: "Profile";
                    panel-x: call-profile-x;
                    panel-y: call-profile-y;
                    panel-width: call-profile-width;
                    panel-height: call-profile-height;
                    editing: call-editing-layout;
                    animating: call-panel-snap-animating;
                    removable: false;

                    if !call-editing-layout : profile-trigger := TouchArea {
                        clicked => { profile-popup-open = !profile-popup-open; }
                        HorizontalBox {
                            padding: 0px;
                            spacing: 8px;
                            if profile-widget-show-avatar : ProfileAvatar {
                                size: 36px;
                                has-image: profile-avatar-image-set;
                                img: profile-avatar-image;
                                initial: display-initial;
                                fit: avatar-image-fit;
                                rotation: avatar-image-rotation;
                                crop-left: avatar-image-crop-left;
                                crop-top: avatar-image-crop-top;
                                crop-right: avatar-image-crop-right;
                                crop-bottom: avatar-image-crop-bottom;
                            }
                            VerticalBox {
                                padding: 0px;
                                spacing: 0px;
                                horizontal-stretch: 1;
                                alignment: center;
                                if profile-widget-show-name : Text { text: display-name == "" ? "You" : display-name; font-weight: 700; font-size: 13px * text-scale; overflow: elide; }
                                if profile-widget-show-status : Text { text: status-message == "" ? "Online" : status-message; color: Theme.muted-text; font-size: 11px * text-scale; overflow: elide; }
                            }
                        }
                    }
                    if call-editing-layout : HorizontalBox {
                        padding: 0px;
                        spacing: 8px;
                        if profile-widget-show-avatar : ProfileAvatar {
                                size: 36px;
                                has-image: profile-avatar-image-set;
                                img: profile-avatar-image;
                                initial: display-initial;
                                fit: avatar-image-fit;
                                rotation: avatar-image-rotation;
                                crop-left: avatar-image-crop-left;
                                crop-top: avatar-image-crop-top;
                                crop-right: avatar-image-crop-right;
                                crop-bottom: avatar-image-crop-bottom;
                            }
                        VerticalBox {
                            padding: 0px;
                            spacing: 0px;
                            horizontal-stretch: 1;
                            alignment: center;
                            if profile-widget-show-name : Text { text: display-name == "" ? "You" : display-name; font-weight: 700; font-size: 13px * text-scale; overflow: elide; }
                            if profile-widget-show-status : Text { text: status-message == "" ? "Online" : status-message; color: Theme.muted-text; font-size: 11px * text-scale; overflow: elide; }
                        }
                    }

                    HorizontalBox {
                        padding: 0px;
                        spacing: 6px;
                        Button { text: muted ? "Unmute" : "Mute"; enabled: connected; clicked => { toggle-mute(); } }
                        Button { text: deafened ? "Undeafen" : "Deafen"; enabled: connected; clicked => { toggle-deafen(); } }
                        Rectangle { horizontal-stretch: 1; }
                        hamburger := Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 4px;
                            background: hamburger-touch.has-hover ? Theme.panel-hover : transparent;

                            VerticalBox {
                                padding-top: 8px;
                                padding-bottom: 8px;
                                padding-left: 7px;
                                padding-right: 7px;
                                spacing: 3px;
                                Rectangle { height: 2px; background: Theme.muted-text; }
                                Rectangle { height: 2px; background: Theme.muted-text; }
                                Rectangle { height: 2px; background: Theme.muted-text; }
                            }

                            hamburger-touch := TouchArea {
                                clicked => { hamburger-menu.show({ x: 0px, y: hamburger.height }); }
                            }

                            hamburger-menu := ContextMenuArea {
                                Menu {
                                    MenuItem { title: "Settings"; activated => { current-tab = 1; } }
                                    // Toggling this saves config and relaunches the
                                    // whole app into (or out of) the server console
                                    // view -- see `on_server_mode_changed` in main.rs.
                                    MenuItem { title: "Server mode (console)"; checkable: true; checked <=> server-mode; activated => { server-mode-changed(); } }
                                    MenuSeparator { }
                                    MenuItem { title: "Edit layout"; checkable: true; checked <=> call-editing-layout; }
                                    Menu {
                                        title: "Widgets";
                                        MenuItem { title: "Connect"; checkable: true; checked <=> call-panel-visible-connect; activated => { settings-changed(); } }
                                        MenuItem { title: "File transfer"; checkable: true; checked <=> call-panel-visible-filetransfer; activated => { settings-changed(); } }
                                        MenuItem { title: "Chat"; checkable: true; checked <=> call-panel-visible-chat; activated => { settings-changed(); } }
                                        MenuItem { title: "Contacts & servers"; checkable: true; checked <=> call-panel-visible-contacts; activated => { settings-changed(); } }
                                        MenuItem { title: "My invite (QR)"; checkable: true; checked <=> call-panel-visible-invite; activated => { settings-changed(); } }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if current-tab == 1 && !server-mode : HorizontalBox {
            padding: 0px;
            spacing: 4px;

            VerticalBox {
                padding: 0px;
                spacing: 2px;
                horizontal-stretch: 0;
                width: sidebar-width;
                LineEdit {
                    placeholder-text: "Search settings";
                    text <=> settings-search;
                    edited(v) => { settings-search-changed(v); }
                }
                if settings-search-summary != "" : Text {
                    text: settings-search-summary;
                    color: Theme.muted-text;
                    font-size: 10px * text-scale;
                    wrap: word-wrap;
                }
                SideNavButton { label: "General"; active: settings-category == 0; reduced-motion: reduced-motion; clicked => { settings-category = 0; } }
                SideNavButton { label: "Appearance"; active: settings-category == 1; reduced-motion: reduced-motion; clicked => { settings-category = 1; } }
                SideNavButton { label: "Audio"; active: settings-category == 2; reduced-motion: reduced-motion; clicked => { settings-category = 2; } }
                SideNavButton { label: "Call"; active: settings-category == 5; reduced-motion: reduced-motion; clicked => { settings-category = 5; } }
                SideNavButton { label: "Keybinds"; active: settings-category == 3; reduced-motion: reduced-motion; clicked => { settings-category = 3; } }
                SideNavButton { label: "Profile"; active: settings-category == 4; reduced-motion: reduced-motion; clicked => { settings-category = 4; } }
                Rectangle { vertical-stretch: 1; }
            }

            // Sidebar resize handle: its own dedicated 5px column right
            // after the nav buttons, never overlapping them regardless of
            // `sidebar-width` -- so it doesn't need to fight the buttons'
            // own `TouchArea`s for hit-testing priority.
            Rectangle {
                width: 5px;
                background: sidebar-handle-touch.pressed || sidebar-handle-touch.has-hover ? Theme.accent : Theme.divider;
                animate background { duration: reduced-motion ? 0ms : 100ms; }
                sidebar-handle-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: ew-resize;
                    moved => {
                        if self.pressed {
                            sidebar-width = clamp(sidebar-width + self.mouse-x - self.pressed-x, 110px, 280px);
                        }
                    }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                            settings-changed();
                        }
                    }
                }
            }

            ScrollView {
                horizontal-stretch: 1;
                // Settings are a single column of labelled controls, and a
                // column has a readable width regardless of how wide the
                // window is. Without this cap, a maximised window on a
                // large monitor stretches every slider and combo box to
                // over a thousand pixels, which is both ugly and harder to
                // aim at -- the control's travel no longer maps to the
                // range you care about.
                HorizontalLayout {
                    alignment: start;
                VerticalBox {
                    padding: 0px;
                    max-width: 760px;

                    HorizontalBox {
                        padding: 0px;
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: editing-layout ? "Done" : "Edit layout";
                            clicked => { editing-layout = !editing-layout; }
                        }
                    }
                    if editing-layout : Text {
                        text: "Use the ^ / v buttons on each section's header to reorder it within this tab.";
                        wrap: word-wrap;
                        color: Theme.muted-text;
                        font-size: 11px * text-scale;
                    }

                    // Named call-screen arrangements (spec §7). Lives beside
                    // "Edit layout" because that is where someone is
                    // standing when they decide the arrangement is worth
                    // keeping.
                    if editing-layout : VerticalBox {
                        padding: 0px;
                        spacing: 4px;
                        SettingLabel {
                            text: "Saved arrangements";
                            help: "Keeps the call screen's panel positions, sizes and visibility under a name, so you can switch between a compact layout and a full one. Colours, fonts and audio settings are not included -- those are separate choices.";
                            text-scale: text-scale;
                        }
                        for name in layout-names : HorizontalBox {
                            padding: 0px;
                            spacing: 6px;
                            Text { text: name; vertical-alignment: center; font-size: 11px * text-scale; overflow: elide; }
                            Rectangle { horizontal-stretch: 1; }
                            Button { text: "Use"; clicked => { load-layout(name); } }
                            Button { text: "X"; clicked => { delete-layout(name); } }
                        }
                        HorizontalBox {
                            padding: 0px;
                            spacing: 6px;
                            LineEdit {
                                text <=> new-layout-name;
                                placeholder-text: "Name this arrangement";
                                accepted(v) => { save-layout(v); }
                            }
                            Button {
                                text: "Save current";
                                enabled: new-layout-name != "";
                                clicked => { save-layout(new-layout-name); }
                            }
                        }
                        if layout-message != "" : Text {
                            text: layout-message;
                            color: Theme.muted-text;
                            font-size: 10px * text-scale;
                            wrap: word-wrap;
                        }
                    }

                    if settings-category == 0 : VerticalBox {
                        padding: 0px;
                        vertical-stretch: 0;
                        Text { text: "New sections start out:"; color: Theme.muted-text; font-size: 12px * text-scale; }
                        HorizontalBox {
                            padding: 0px;
                            spacing: 6px;
                            TabButton { label: "Expanded"; active: sections-expanded-default; reduced-motion: reduced-motion; clicked => { sections-expanded-default = true; settings-changed(); } }
                            TabButton { label: "Collapsed"; active: !sections-expanded-default; reduced-motion: reduced-motion; clicked => { sections-expanded-default = false; settings-changed(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Text {
                            text: "Applies to every Settings section (Audio, Profile, etc.) the next time the app starts -- doesn't retroactively fold or unfold ones you've already toggled by hand this session.";
                            wrap: word-wrap;
                            color: Theme.muted-text;
                            font-size: 11px * text-scale;
                        }
                        Rectangle { height: 1px; background: Theme.divider; }
                        ToggleSwitch { text: "Start maximized"; checked <=> start-maximized; toggled => { settings-changed(); } }
                        Text {
                            text: "Window size and position are remembered automatically between launches, regardless of this setting.";
                            wrap: word-wrap;
                            color: Theme.muted-text;
                            font-size: 11px * text-scale;
                        }

                        Rectangle { height: 1px; background: Theme.divider; }
                        Text { text: "Profile widget: show on the bar"; color: Theme.muted-text; font-size: 12px * text-scale; }
                        ToggleSwitch { text: "Avatar"; checked <=> profile-widget-show-avatar; toggled => { settings-changed(); } }
                        ToggleSwitch { text: "Display name"; checked <=> profile-widget-show-name; toggled => { settings-changed(); } }
                        ToggleSwitch { text: "Status message"; checked <=> profile-widget-show-status; toggled => { settings-changed(); } }
                        Text {
                            text: "The profile widget itself, and its mute/deafen/settings controls, always stay -- this only decides which details it shows. Clicking it still opens the full popup regardless.";
                            wrap: word-wrap;
                            color: Theme.muted-text;
                            font-size: 11px * text-scale;
                        }
                    }

                    if settings-category == 1 : VerticalBox {
                        padding: 0px;
                        vertical-stretch: 0;

                        for section-id[i] in appearance-order : VerticalBox {
                            padding: 0px;

                            if section-id == "accent" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "The one highlight color used for buttons, sliders and anything active.";
                                    text-scale: text-scale;
                                    title: "Accent color";
                                    reduced-motion: reduced-motion;
                                    expanded <=> sec-accent;
                                    editing: editing-layout;
                                    can-move-up: i > 0;
                                    can-move-down: i < appearance-order.length - 1;
                                    move-up => { move-appearance-section(section-id, -1); }
                                    move-down => { move-appearance-section(section-id, 1); }
                                }
                                if sec-accent : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 8px;
                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 10px;
                                        Rectangle {
                                            width: 32px;
                                            height: 32px;
                                            border-radius: 7px;
                                            background: accent-choice;
                                            border-width: 1px;
                                            border-color: Theme.divider;
                                            accessible-role: text;
                                            accessible-label: "current accent color preview";
                                        }
                                        VerticalBox {
                                            padding: 0px;
                                            spacing: 4px;
                                            horizontal-stretch: 0;
                                            width: 90px;
                                            Text { text: "Hex"; color: Theme.muted-text; font-size: 10px * text-scale; }
                                            LineEdit { text <=> accent-hex-display; accepted(v) => { accent-hex-changed(v); } }
                                        }
                                    }
                                    ColorPicker {
                                        hue <=> accent-hue;
                                        sat <=> accent-sat;
                                        val <=> accent-val;
                                        hue-preview: accent-hue-preview;
                                        changed => { accent-color-picker-changed(); }
                                    }
                                }
                            }

                            if section-id == "theme" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "Light, dark, or a background of your own. Themes are plain data -- a theme file can never run code on your machine.";
                                    text-scale: text-scale;
                                    title: "Theme";
                                    reduced-motion: reduced-motion;
                                    expanded <=> sec-theme;
                                    editing: editing-layout;
                                    can-move-up: i > 0;
                                    can-move-down: i < appearance-order.length - 1;
                                    move-up => { move-appearance-section(section-id, -1); }
                                    move-down => { move-appearance-section(section-id, 1); }
                                }
                                if sec-theme : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;

                                    // Spec §7's gallery: most people never
                                    // open a colour picker, so the swatches
                                    // are the feature and the picker below
                                    // is for the minority who want it.
                                    SettingLabel {
                                        text: "Gallery";
                                        help: "Complete colour schemes, ready to use. Picking one changes the accent, the background and whether the app runs light or dark -- it leaves your wallpaper, font and transparency alone.";
                                        text-scale: text-scale;
                                    }
                                    for preset in theme-presets : Rectangle {
                                        height: 40px;
                                        border-radius: 6px;
                                        background: preset-touch.has-hover ? Theme.panel-hover : transparent;
                                        preset-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { apply-theme-preset(preset.name); }
                                        }
                                        HorizontalLayout {
                                            padding-left: 4px;
                                            padding-right: 4px;
                                            spacing: 8px;
                                            // A swatch showing the actual pair,
                                            // so the name is not a guess.
                                            Rectangle {
                                                width: 34px;
                                                height: 22px;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                border-color: Theme.divider;
                                                background: preset.background;
                                                Rectangle {
                                                    width: 12px;
                                                    height: 12px;
                                                    x: parent.width - self.width - 4px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 6px;
                                                    background: preset.accent;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Text { text: preset.name; font-size: 11px * text-scale; font-weight: 600; }
                                                Text {
                                                    text: preset.description;
                                                    color: Theme.muted-text;
                                                    font-size: 9px * text-scale;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                    Rectangle { height: 1px; background: Theme.divider; }

                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 6px;
                                        TabButton { label: "System"; active: theme-mode == 0; reduced-motion: reduced-motion; clicked => { theme-mode = 0; settings-changed(); } }
                                        TabButton { label: "Light"; active: theme-mode == 1; reduced-motion: reduced-motion; clicked => { theme-mode = 1; settings-changed(); } }
                                        TabButton { label: "Dark"; active: theme-mode == 2; reduced-motion: reduced-motion; clicked => { theme-mode = 2; settings-changed(); } }
                                        TabButton { label: "Custom"; active: theme-mode == 3; reduced-motion: reduced-motion; clicked => { theme-mode = 3; settings-changed(); } }
                                        Rectangle { horizontal-stretch: 1; }
                                    }

                                    if theme-mode == 3 : VerticalBox {
                                        padding: 0px;
                                        spacing: 6px;
                                        Text { text: "Background color"; color: Theme.muted-text; font-size: 12px * text-scale; }
                                        HorizontalBox {
                                            padding: 0px;
                                            spacing: 10px;
                                            Rectangle {
                                                width: 32px;
                                                height: 32px;
                                                border-radius: 7px;
                                                background: theme-bg-color;
                                                border-width: 1px;
                                                border-color: Theme.divider;
                                                accessible-role: text;
                                                accessible-label: "current theme background preview";
                                            }
                                            VerticalBox {
                                                padding: 0px;
                                                spacing: 4px;
                                                horizontal-stretch: 0;
                                                width: 90px;
                                                Text { text: "Hex"; color: Theme.muted-text; font-size: 10px * text-scale; }
                                                LineEdit { text <=> theme-bg-hex-display; accepted(v) => { theme-bg-hex-changed(v); } }
                                            }
                                        }
                                        ColorPicker {
                                            hue <=> theme-bg-hue;
                                            sat <=> theme-bg-sat;
                                            val <=> theme-bg-val;
                                            hue-preview: theme-bg-hue-preview;
                                            changed => { theme-bg-color-picker-changed(); }
                                        }

                                        Text { text: "Background image"; color: Theme.muted-text; font-size: 12px * text-scale; }
                                        HorizontalBox {
                                            padding: 0px;
                                            spacing: 6px;
                                            Button { text: theme-bg-image-set ? "Change image..." : "Choose image..."; clicked => { import-theme-image(); } }
                                            if theme-bg-image-set : Button { text: "Clear"; clicked => { clear-theme-image(); } }
                                        }
                                        if theme-bg-image-set : Text { text: "Image opacity: \{round(theme-image-opacity * 100)}%"; color: Theme.muted-text; font-size: 10px * text-scale; }
                                        if theme-bg-image-set : AccentSlider { minimum: 0; maximum: 1; value <=> theme-image-opacity; changed(v) => { settings-changed(); } }
                                        if theme-image-message != "" : Text { text: theme-image-message; color: Theme.muted-text; font-size: 10px * text-scale; wrap: word-wrap; }

                                        if theme-bg-image-set : VerticalBox {
                                            padding: 0px;
                                            spacing: 6px;
                                            Text { text: "Fit"; color: Theme.muted-text; font-size: 10px * text-scale; }
                                            HorizontalBox {
                                                padding: 0px;
                                                spacing: 6px;
                                                TabButton { label: "Cover"; active: theme-image-fit == 0; reduced-motion: reduced-motion; clicked => { theme-image-fit = 0; settings-changed(); } }
                                                TabButton { label: "Fit"; active: theme-image-fit == 1; reduced-motion: reduced-motion; clicked => { theme-image-fit = 1; settings-changed(); } }
                                                TabButton { label: "Stretch"; active: theme-image-fit == 2; reduced-motion: reduced-motion; clicked => { theme-image-fit = 2; settings-changed(); } }
                                                TabButton { label: "Original"; active: theme-image-fit == 3; reduced-motion: reduced-motion; clicked => { theme-image-fit = 3; settings-changed(); } }
                                                Rectangle { horizontal-stretch: 1; }
                                            }

                                            Text { text: "Rotate: \{round(theme-image-rotation)}°"; color: Theme.muted-text; font-size: 10px * text-scale; }
                                            AccentSlider { minimum: -180; maximum: 180; value <=> theme-image-rotation; changed(v) => { settings-changed(); } }

                                            Text { text: "Crop"; color: Theme.muted-text; font-size: 10px * text-scale; }
                                            HorizontalBox {
                                                padding: 0px;
                                                spacing: 12px;
                                                VerticalBox {
                                                    padding: 0px;
                                                    spacing: 4px;
                                                    Text { text: "Left: \{round(theme-image-crop-left)}%"; color: Theme.muted-text; font-size: 9px * text-scale; }
                                                    AccentSlider { minimum: 0; maximum: 90; value <=> theme-image-crop-left; changed(v) => { settings-changed(); } }
                                                    Text { text: "Right: \{round(theme-image-crop-right)}%"; color: Theme.muted-text; font-size: 9px * text-scale; }
                                                    AccentSlider { minimum: 0; maximum: 90; value <=> theme-image-crop-right; changed(v) => { settings-changed(); } }
                                                }
                                                VerticalBox {
                                                    padding: 0px;
                                                    spacing: 4px;
                                                    Text { text: "Top: \{round(theme-image-crop-top)}%"; color: Theme.muted-text; font-size: 9px * text-scale; }
                                                    AccentSlider { minimum: 0; maximum: 90; value <=> theme-image-crop-top; changed(v) => { settings-changed(); } }
                                                    Text { text: "Bottom: \{round(theme-image-crop-bottom)}%"; color: Theme.muted-text; font-size: 9px * text-scale; }
                                                    AccentSlider { minimum: 0; maximum: 90; value <=> theme-image-crop-bottom; changed(v) => { settings-changed(); } }
                                                }
                                            }
                                        }

                                        Text {
                                            text: "The image sits over the background color at this opacity, so a more transparent image lets more of the color show through.";
                                            wrap: word-wrap;
                                            color: Theme.muted-text;
                                            font-size: 10px * text-scale;
                                        }
                                    }

                                    Rectangle { height: 1px; background: Theme.divider; }
                                    Text { text: "Window opacity: \{round(theme-opacity * 100)}%"; color: Theme.muted-text; font-size: 12px * text-scale; }
                                    AccentSlider { minimum: 0.15; maximum: 1; value <=> theme-opacity; changed(v) => { settings-changed(); } }
                                    Text {
                                        text: "Fades the app's own background toward see-through, letting whatever's behind the window show through -- panels, text, and buttons stay fully opaque.";
                                        wrap: word-wrap;
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                    }

                                    Rectangle { height: 1px; background: Theme.divider; }
                                    Text { text: "Preview"; color: Theme.muted-text; font-size: 12px * text-scale; }
                                    WallpaperPreview {
                                        custom-mode: theme-mode == 3;
                                        bg-color: theme-bg-color;
                                        has-image: theme-bg-image-set;
                                        img: theme-bg-image;
                                        image-opacity: theme-image-opacity;
                                        window-opacity: theme-opacity;
                                        fit: theme-image-fit;
                                        rotation: theme-image-rotation;
                                        crop-left: theme-image-crop-left;
                                        crop-top: theme-image-crop-top;
                                        crop-right: theme-image-crop-right;
                                        crop-bottom: theme-image-crop-bottom;
                                    }
                                    Text {
                                        text: "The grey squares stand in for whatever is behind the window, so window opacity reads as see-through rather than just darker.";
                                        wrap: word-wrap;
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                    }
                                }
                            }

                            if section-id == "textmotion" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "Text size here is independent of your system scaling, so you can make this app bigger without changing anything else.";
                                    text-scale: text-scale;
                                    title: "Text, font & motion";
                                    reduced-motion: reduced-motion;
                                    expanded <=> sec-textmotion;
                                    editing: editing-layout;
                                    can-move-up: i > 0;
                                    can-move-down: i < appearance-order.length - 1;
                                    move-up => { move-appearance-section(section-id, -1); }
                                    move-down => { move-appearance-section(section-id, 1); }
                                }
                                if sec-textmotion : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    Text { text: "Text size: \{round(text-scale * 100)}%"; color: Theme.muted-text; font-size: 12px * text-scale; }
                                    AccentSlider { minimum: 0.85; maximum: 1.4; value <=> text-scale; changed(v) => { settings-changed(); } }
                                    ToggleSwitch { text: "Reduce animations"; checked <=> reduced-motion; toggled => { settings-changed(); } }

                                    Rectangle { height: 1px; background: Theme.divider; }
                                    Text { text: "Font"; color: Theme.muted-text; font-size: 12px * text-scale; }
                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 6px;
                                        TabButton { label: "System"; active: font-family-choice == ""; reduced-motion: reduced-motion; clicked => { font-family-choice = ""; settings-changed(); } }
                                        TabButton { label: "Monospace"; active: font-family-choice == "Consolas"; reduced-motion: reduced-motion; clicked => { font-family-choice = "Consolas"; settings-changed(); } }
                                        TabButton { label: "Serif"; active: font-family-choice == "Georgia"; reduced-motion: reduced-motion; clicked => { font-family-choice = "Georgia"; settings-changed(); } }
                                        // Spec §7's dyslexia-friendly option.
                                        // Resolved by Rust against what is
                                        // actually installed, so this is
                                        // never a button that silently does
                                        // nothing.
                                        TabButton {
                                            label: "Easy reading";
                                            active: font-choice-note != "";
                                            reduced-motion: reduced-motion;
                                            clicked => { pick-font-choice(3); }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    if font-choice-note != "" : Text {
                                        text: font-choice-note;
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                        wrap: word-wrap;
                                    }
                                    HelpIcon {
                                        text-scale: text-scale;
                                        text: "\"Easy reading\" picks whichever high-legibility font your system already has -- OpenDyslexic if you have installed it, otherwise Verdana or Tahoma, which are wide and open enough to help. No font is bundled: shipping one would mean licensing it for redistribution, and the ones that help most are the ones people already chose to install.";
                                    }
                                    Button { text: "Import font..."; clicked => { import-font(); } }
                                    if font-family-choice != "" && font-family-choice != "Consolas" && font-family-choice != "Georgia" : Text {
                                        text: "Using imported font: \{font-family-choice}";
                                        color: Theme.accent-text;
                                        font-size: 11px * text-scale;
                                    }
                                    Text {
                                        text: "Applies window-wide, including buttons and menus -- not just this app's own text. Imported fonts (.ttf/.otf/.ttc) stay available across restarts.";
                                        wrap: word-wrap;
                                        color: Theme.muted-text;
                                        font-size: 11px * text-scale;
                                    }
                                    if font-import-message != "" : Text { text: font-import-message; color: Theme.muted-text; font-size: 11px * text-scale; wrap: word-wrap; }
                                }
                            }

                            if section-id == "importexport" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "One file carries your layout, colors, fonts and profile arrangement. Safe to share -- it holds no keys and no contacts.";
                                    text-scale: text-scale;
                                    title: "Import / export settings";
                                    reduced-motion: reduced-motion;
                                    expanded <=> sec-importexport;
                                    editing: editing-layout;
                                    can-move-up: i > 0;
                                    can-move-down: i < appearance-order.length - 1;
                                    move-up => { move-appearance-section(section-id, -1); }
                                    move-down => { move-appearance-section(section-id, 1); }
                                }
                                if sec-importexport : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    HorizontalBox {
                                        padding: 0px;
                                        Button { text: "Export settings..."; clicked => { export-settings(); } }
                                        Button { text: "Import settings..."; clicked => { import-settings(); } }
                                    }
                                    Rectangle { height: 1px; background: Theme.divider; }
                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 6px;
                                        Button { text: "Export everything..."; clicked => { export-all-data(); } }
                                        HelpIcon {
                                            text-scale: text-scale;
                                            text: "Writes your settings, contacts, message history, soundboard clips and received files into a folder as plain JSON and WAV -- readable without this app. Your identity key is deliberately left out; use your recovery phrase instead.";
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    Text {
                                        text: "The exported folder is not encrypted. Your messages are readable by anyone who opens it.";
                                        color: #e0a052;
                                        font-size: 10px * text-scale;
                                        wrap: word-wrap;
                                    }
                                    Rectangle { height: 1px; background: Theme.divider; }
                                    ToggleSwitch {
                                        text: "Save crash reports";
                                        checked <=> crash-reporting;
                                        reduced-motion: reduced-motion;
                                        text-scale: text-scale;
                                        help: "Writes a file describing any crash, with usernames, file paths, keys and addresses stripped out. Reports stay on your machine -- nothing is ever sent anywhere. Off means nothing is written at all, not merely nothing sent.";
                                        toggled => { settings-changed(); }
                                    }
                                    if import-export-message != "" : Text { text: import-export-message; color: Theme.muted-text; font-size: 12px * text-scale; wrap: word-wrap; }
                                }
                            }
                        }
                    }

                    if settings-category == 2 : VerticalBox {
                        padding: 0px;
                        vertical-stretch: 0;

                        Text { text: "Devices (input/output)"; font-weight: 700; }
                        VerticalBox {
                            padding-top: 4px; padding-left: 0px; padding-right: 0px; padding-bottom: 10px; spacing: 6px;
                            if connected : Text {
                                text: "Switching devices while connected takes effect immediately.";
                                color: Theme.muted-text;
                                font-size: 11px * text-scale;
                            }
                            if show-audio-fixed-block : HorizontalBox {
                                padding: 0px;
                                spacing: 16px;
                                alignment: start;
                                // Both columns pack from the top. Without
                                // `alignment: start` a VerticalBox shares
                                // leftover height among its children, so
                                // the shorter output column spread itself
                                // out and its picker drifted below the
                                // input one -- rows that should read as a
                                // pair sitting at different heights.
                                VerticalBox {
                                    padding: 0px;
                                    spacing: 6px;
                                    alignment: start;
                                    Text { text: "Microphone (input)"; color: Theme.muted-text; font-size: 11px * text-scale; }
                                    ComboBox { model: input-devices; current-value <=> selected-input-device; selected(v) => { device-changed(); } }
                                    ToggleSwitch { text: "Auto gain"; checked <=> gain-auto; toggled => { settings-changed(); } }
                                    Text { text: gain-auto ? "Target: \{round(gain-target)} dB" : "Gain: \{round(gain-target)} dB"; color: Theme.muted-text; font-size: 11px * text-scale; }
                                    AccentSlider { minimum: -40; maximum: 0; value <=> gain-target; changed(v) => { settings-changed(); } }

                                    // Level meter and mic test sit directly under the
                                    // input picker: they're how you check the device
                                    // you just chose is the right one.
                                    Text { text: "Level"; color: Theme.muted-text; font-size: 11px * text-scale; }
                                    Rectangle {
                                        height: 12px;
                                        background: Theme.track-background;
                                        border-radius: 6px;
                                        clip: true;
                                        accessible-role: progress-indicator;
                                        accessible-label: "microphone level";
                                        accessible-value: mic-level;
                                        accessible-value-minimum: 0;
                                        accessible-value-maximum: 1;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: 100%;
                                            width: parent.width * mic-level;
                                            background: Theme.accent;
                                            animate width { duration: reduced-motion ? 0ms : 40ms; }
                                        }
                                    }
                                    if call-stats != "" : Text {
                                        text: call-stats;
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                        wrap: word-wrap;
                                    }

                                    ToggleSwitch {
                                        text: "Live loopback";
                                        checked <=> loopback-enabled;
                                        enabled: !connected;
                                        reduced-motion: reduced-motion;
                                        text-scale: text-scale;
                                        help: "Hear your own microphone straight back, through the same processing chain a real call uses -- so you hear exactly what the other side would. Use headphones, or it will echo.";
                                        toggled => { toggle-loopback(); }
                                    }
                                    if loopback-message != "" : Text {
                                        text: loopback-message;
                                        wrap: word-wrap;
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                    }
                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 6px;
                                        Button {
                                            text: "Mic test (5 s)";
                                            enabled: !connected && !loopback-enabled && !mic-test-running;
                                            clicked => { mic-test(); }
                                        }
                                        HelpIcon {
                                            text-scale: text-scale;
                                            text: "Records five seconds of you, then plays it back through your full processing chain -- exactly what other people hear. Nothing is kept afterwards.";
                                        }
                                    }
                                    if mic-test-message != "" : Text {
                                        text: mic-test-message;
                                        wrap: word-wrap;
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                    }
                                }
                                VerticalBox {
                                    padding: 0px;
                                    spacing: 6px;
                                    alignment: start;
                                    Text { text: "Speakers / headphones (output)"; color: Theme.muted-text; font-size: 11px * text-scale; }
                                    ComboBox { model: output-devices; current-value <=> selected-output-device; selected(v) => { device-changed(); } }
                                    SettingLabel {
                                        text: "Volume: \{round(output-gain-db)} dB";
                                        help: "How loud the other person is in your ears. Only affects your end -- it does not change how loud you are to them.";
                                        text-scale: text-scale;
                                    }
                                    AccentSlider { minimum: -24; maximum: 12; value <=> output-gain-db; changed(v) => { settings-changed(); } }
                                }
                            }
                        }

                        for section-id[i] in audio-order : VerticalBox {
                            padding: 0px;

                            // Mic level, mic test and call controls used to
                            // be widgets on the Call canvas. They live here
                            // instead: they're all "is my microphone set up
                            // right?", which is what this tab is for.
                            if section-id == "presets" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    title: "Voice presets"; reduced-motion: reduced-motion; expanded <=> sec-presets;
                                    editing: editing-layout; can-move-up: i > 0; can-move-down: i < audio-order.length - 1;
                                    move-up => { move-audio-section(section-id, -1); }
                                    move-down => { move-audio-section(section-id, 1); }
                                }
                                if sec-presets : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    Text {
                                        text: "A preset stores this whole audio chain under a name. It doesn't touch your devices or appearance, so loading someone else's is safe.";
                                        wrap: word-wrap;
                                        color: Theme.muted-text;
                                        font-size: 11px * text-scale;
                                    }
                                    if voice-presets.length == 0 : Text {
                                        text: "No presets saved yet.";
                                        color: Theme.muted-text;
                                        font-size: 11px * text-scale;
                                    }
                                    for preset[pi] in voice-presets : HorizontalBox {
                                        padding: 0px;
                                        spacing: 6px;
                                        Text { text: preset.name; vertical-alignment: center; font-size: 12px * text-scale; overflow: elide; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Button { text: "Load"; clicked => { load-preset(pi); } }
                                        Button { text: "Export"; clicked => { export-preset(pi); } }
                                        Button { text: "X"; clicked => { delete-preset(pi); } }
                                    }
                                    Rectangle { height: 1px; background: Theme.divider; }
                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 6px;
                                        LineEdit { text <=> new-preset-name; placeholder-text: "Name this preset"; accepted(v) => { save-preset(); } }
                                        Button { text: "Save current"; enabled: new-preset-name != ""; clicked => { save-preset(); } }
                                    }
                                    Button { text: "Import a preset file..."; clicked => { import-preset(); } }
                                    if preset-message != "" : Text { text: preset-message; color: Theme.muted-text; font-size: 10px * text-scale; wrap: word-wrap; }
                                }
                            }

                            if section-id == "callcontrols" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "Choose how your mic opens: hold a key to talk, or let it open on its own when you speak.";
                                    text-scale: text-scale;
                                    title: "Transmit & monitoring"; reduced-motion: reduced-motion; expanded <=> sec-callcontrols;
                                    editing: editing-layout; can-move-up: i > 0; can-move-down: i < audio-order.length - 1;
                                    move-up => { move-audio-section(section-id, -1); }
                                    move-down => { move-audio-section(section-id, 1); }
                                }
                                if sec-callcontrols : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;

                                    Text { text: "The mic opens when:"; color: Theme.muted-text; font-size: 12px * text-scale; }
                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 6px;
                                        TabButton { label: "Push to talk"; active: transmit-mode == 0; reduced-motion: reduced-motion; clicked => { transmit-mode = 0; settings-changed(); } }
                                        TabButton { label: "Voice activated"; active: transmit-mode == 1; reduced-motion: reduced-motion; clicked => { transmit-mode = 1; settings-changed(); } }
                                        TabButton { label: "Open mic"; active: transmit-mode == 2; reduced-motion: reduced-motion; clicked => { transmit-mode = 2; settings-changed(); } }
                                        Rectangle { horizontal-stretch: 1; }
                                    }

                                    if transmit-mode == 0 : Text {
                                        text: "Held key: \{ptt-key-name} -- rebind it in Keybinds.";
                                        color: Theme.muted-text;
                                        font-size: 11px * text-scale;
                                    }
                                    if transmit-mode == 2 : Text {
                                        text: "Everything the microphone picks up is sent, continuously.";
                                        color: Theme.muted-text;
                                        font-size: 11px * text-scale;
                                    }
                                    if transmit-mode == 1 : VerticalBox {
                                        padding: 0px;
                                        spacing: 4px;
                                        Text { text: "Sensitivity -- lower opens the mic more easily"; color: Theme.muted-text; font-size: 11px * text-scale; }
                                        AccentSlider { minimum: 0.0; maximum: 0.3; value <=> va-threshold; changed(v) => { settings-changed(); } }
                                        Rectangle {
                                            height: 10px;
                                            background: Theme.track-background;
                                            border-radius: 5px;
                                            clip: true;
                                            Rectangle {
                                                x: 0px;
                                                width: parent.width * mic-level;
                                                height: 100%;
                                                background: mic-level > va-threshold ? Theme.accent : Theme.muted-text;
                                            }
                                            Rectangle {
                                                x: parent.width * (va-threshold / 0.3) - 1px;
                                                width: 2px;
                                                height: 100%;
                                                background: Palette.foreground;
                                            }
                                        }
                                    }

                                    HorizontalBox {
                                        padding: 0px;
                                        Rectangle {
                                            width: 14px;
                                            height: 14px;
                                            border-radius: 7px;
                                            background: ptt-held ? Theme.accent : Theme.muted-text;
                                            animate background { duration: reduced-motion ? 0ms : 60ms; }
                                            accessible-role: text;
                                            accessible-label: ptt-held ? "transmitting" : "not transmitting";
                                        }
                                        Text {
                                            text: transmit-mode == 2 ? "Open mic" : transmit-mode == 1 ? "Voice activated" : "Push to talk";
                                            vertical-alignment: center;
                                        }
                                    }
                                    ToggleSwitch {
                                        text: "Push-to-talk latches (toggle)";
                                        checked <=> ptt-toggle;
                                        reduced-motion: reduced-motion;
                                        text-scale: text-scale;
                                        help: "Press once to start talking and again to stop, instead of holding the key down. Handy for long calls; easy to leave on by accident.";
                                        toggled => { settings-changed(); }
                                    }
                                    SettingLabel {
                                        text: "Release delay: \{round(ptt-release-ms)} ms";
                                        help: "How long the mic stays open after you let go of the key. A little delay stops the end of your last word being chopped off. Ignored in toggle mode.";
                                        text-scale: text-scale;
                                    }
                                    AccentSlider {
                                        minimum: 0;
                                        maximum: 1000;
                                        value <=> ptt-release-ms;
                                        changed(v) => { settings-changed(); }
                                    }
                                    HorizontalBox {
                                        padding: 0px;
                                        ToggleSwitch {
                                            text: "Live monitoring (hear yourself)";
                                            checked <=> monitor-enabled;
                                            enabled: connected;
                                            reduced-motion: reduced-motion;
                                            text-scale: text-scale;
                                            help: "Hear your own processed microphone during a call. Outside a call, use Live loopback at the top of this tab instead.";
                                            toggled => { toggle-monitor(); }
                                        }
                                        Text {
                                            text: "about \{monitor-latency-ms} ms of delay";
                                            color: Theme.muted-text;
                                            font-size: 12px * text-scale;
                                            vertical-alignment: center;
                                        }
                                        HelpIcon {
                                            text-scale: text-scale;
                                            text: "How far behind your own voice sounds when monitoring. Roughly, not exactly -- it includes an estimate for your sound card, which cannot be measured portably. Under about 30 ms goes unnoticed; this is well above that, so use it to check your sound rather than to talk over.";
                                        }
                                    }
                                    SettingLabel {
                                        text: "Replay keeps the last \{replay-seconds} seconds";
                                        help: "How much of what you have heard is kept, so you can save a moment you missed. It is encrypted in memory under a key made for this call, rolls over as it fills, and is gone the moment the call ends -- never written to disk unless you press Save. This app does not record you. While the call runs, something that can read this program's memory could still read it, which is one reason it is capped at a minute.";
                                        text-scale: text-scale;
                                    }
                                    AccentSlider {
                                        minimum: 10; maximum: 60;
                                        value: replay-seconds;
                                        changed(v) => { replay-seconds = round(v); replay-settings-changed(); }
                                    }
                                    // Spec §2 asks for this to be stated loudly, not
                                    // tucked into help: otherwise "the app records
                                    // you" becomes the story.
                                    Text {
                                        text: "Not a recording: encrypted in memory, rolling, and gone when the call ends.";
                                        color: Theme.muted-text;
                                        font-size: 11px * text-scale;
                                        wrap: word-wrap;
                                    }
                                    SettingLabel {
                                        text: "When their audio drops out";
                                        help: "When the network damages a moment badly enough to be worth a second listen, the seconds around it are kept. Auto-play replays that moment straight away; Ask me shows a Replay button on the call screen; Off keeps it quietly in the list below. Small losses are repaired invisibly either way.";
                                        text-scale: text-scale;
                                    }
                                    ComboBox {
                                        model: ["Off", "Ask me", "Auto-play"];
                                        current-index: replay-mode;
                                        selected(v) => { replay-mode = self.current-index; replay-settings-changed(); }
                                    }
                                    if replay-notice != "" : Text {
                                        text: replay-notice;
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                        wrap: word-wrap;
                                    }
                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 6px;
                                        Button { text: "Save replay"; enabled: connected; clicked => { save-replay(); } }
                                        if replay-message != "" : Text { text: replay-message; color: Theme.muted-text; font-size: 10px * text-scale; vertical-alignment: center; overflow: elide; }
                                    }
                                    SettingLabel {
                                        text: "Repaired moments";
                                        help: "Each time the network damaged enough audio to be worth a second listen, the seconds either side are kept here. In memory only and cleared when the call ends -- this is a repair aid, not a call recording.";
                                        text-scale: text-scale;
                                    }
                                    if replay-clips.length == 0 : Text {
                                        text: connected ? "Nothing has needed repairing." : "Available during a call.";
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                    }
                                    for clip[ci] in replay-clips : HorizontalBox {
                                        padding: 0px;
                                        spacing: 6px;
                                        Button {
                                            text: "Play";
                                            clicked => { play-replay-clip(ci); }
                                        }
                                        Text {
                                            text: clip;
                                            color: Theme.muted-text;
                                            font-size: 10px * text-scale;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    if replay-clips.length > 0 : Button {
                                        text: "Clear repaired moments";
                                        clicked => { clear-replay-clips(); }
                                    }
                                }
                            }

                            if section-id == "aec" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "Removes the other person's voice from your microphone, so they do not hear themselves echoed back when you are not wearing headphones.";
                                    text-scale: text-scale;
                                    title: "Echo Cancellation"; reduced-motion: reduced-motion; expanded <=> sec-aec;
                                    editing: editing-layout; can-move-up: i > 0; can-move-down: i < audio-order.length - 1;
                                    move-up => { move-audio-section(i, -1); }
                                    move-down => { move-audio-section(i, 1); }
                                }
                                if sec-aec : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    ToggleSwitch {
                                        text: "Cancel echo from my speakers";
                                        checked <=> echo-cancel;
                                        reduced-motion: reduced-motion;
                                        text-scale: text-scale;
                                        help: "Without headphones, what you hear from the other person is picked up by your microphone and sent back, so they hear themselves. This learns how your speakers reach your microphone and subtracts it. On by default; if you always wear headphones you can turn it off for the lowest possible processing.";
                                        toggled => { settings-changed(); }
                                    }
                                    if echo-cancel : Text {
                                        text: connected
                                            ? (echo-erle-db > 1
                                                ? "Removing \{round(echo-erle-db)} dB of echo."
                                                : "Nothing to remove yet -- it needs a few seconds of them talking while your speakers are on.")
                                            : "The meter appears once you are in a call.";
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if section-id == "denoise" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "Turns down steady background sound -- a fan, a hiss, an air conditioner -- including while you are talking, which is what the noise gate below cannot do.";
                                    text-scale: text-scale;
                                    title: "Noise Suppression"; reduced-motion: reduced-motion; expanded <=> sec-denoise;
                                    editing: editing-layout; can-move-up: i > 0; can-move-down: i < audio-order.length - 1;
                                    move-up => { move-audio-section(i, -1); }
                                    move-down => { move-audio-section(i, 1); }
                                }
                                if sec-denoise : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    ToggleSwitch {
                                        text: "Remove background sound";
                                        checked <=> ns-enabled;
                                        reduced-motion: reduced-motion;
                                        text-scale: text-scale;
                                        help: "Takes background sound out of your mic while you talk, not just between sentences like the noise gate below.";
                                        toggled => { settings-changed(); }
                                    }
                                    if ns-enabled : ToggleSwitch {
                                        text: "Use the voice model";
                                        checked <=> ns-neural;
                                        reduced-motion: reduced-motion;
                                        text-scale: text-scale;
                                        help: "On: a trained model (RNNoise) that knows what a voice sounds like, so it also removes keyboards, dogs and doors. Off: classic spectral subtraction, which only removes sound that is steadily there, like a fan or hiss. The model needs your mic at 48 kHz; at other rates the classic method is used.";
                                        toggled => { settings-changed(); }
                                    }
                                    if ns-enabled : SettingLabel {
                                        text: "Strength: " + round(ns-strength * 100) + "%";
                                        help: ns-neural ? "How much of the cleaned sound replaces the original. 100% is the model's output; lower keeps some of the room in." : "How much of the background to take out. Low settings barely touch anything; high settings remove a lot of it. Speech and background share the same frequencies, so past about 70% you start removing the parts of your voice that live in the same place -- which is what makes it sound thin.";
                                        text-scale: text-scale;
                                    }
                                    if ns-enabled : AccentSlider {
                                        minimum: 0; maximum: 1;
                                        value: ns-strength;
                                        changed(v) => { ns-strength = v; settings-changed(); }
                                    }
                                    // Spec §1 asks for this warning specifically, and it
                                    // belongs next to the number that causes it.
                                    if ns-enabled && !ns-neural && ns-strength >= 0.7 : Text {
                                        text: "At this strength your voice may start to sound thin -- speech and background share frequencies, so removing more of one removes more of the other.";
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if section-id == "gate" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "Mutes your mic when you're not talking, so your keyboard, fan and background chatter aren't heard between sentences.";
                                    text-scale: text-scale;
                                    title: "Noise Gate"; reduced-motion: reduced-motion; expanded <=> sec-gate;
                                    editing: editing-layout; can-move-up: i > 0; can-move-down: i < audio-order.length - 1;
                                    move-up => { move-audio-section(section-id, -1); }
                                    move-down => { move-audio-section(section-id, 1); }
                                }
                                if sec-gate : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    ToggleSwitch { text: "Enabled"; checked <=> gate-enabled; toggled => { settings-changed(); } }
                                    SettingLabel { text: "Threshold: \{round(gate-threshold)} dB"; help: "How loud you have to be before the mic opens. Raise it if quiet background noise gets through."; text-scale: text-scale; }
                                    AccentSlider { minimum: -80; maximum: -10; value <=> gate-threshold; changed(v) => { settings-changed(); } }
                                    SettingLabel { text: "Attack: \{round(gate-attack)} ms"; help: "How fast the mic opens once you start talking. Too slow clips the start of your words."; text-scale: text-scale; }
                                    AccentSlider { minimum: 1; maximum: 50; value <=> gate-attack; changed(v) => { settings-changed(); } }
                                    SettingLabel { text: "Hold: \{round(gate-hold)} ms"; help: "How long the mic stays open after you stop, so short pauses mid-sentence don't chop you up."; text-scale: text-scale; }
                                    AccentSlider { minimum: 0; maximum: 500; value <=> gate-hold; changed(v) => { settings-changed(); } }
                                    SettingLabel { text: "Release: \{round(gate-release)} ms"; help: "How gently the mic closes afterwards. Longer sounds more natural, shorter cuts background noise sooner."; text-scale: text-scale; }
                                    AccentSlider { minimum: 10; maximum: 1000; value <=> gate-release; changed(v) => { settings-changed(); } }

                                    SettingLabel {
                                        text: gate-attenuation-db < 1 ? "Gate: open" : "Gate: closing (-\{round(gate-attenuation-db)} dB)";
                                        help: "Whether the gate is letting your voice through right now. It should sit open while you talk and close in the gaps -- if it flickers mid-sentence the threshold is too high.";
                                        text-scale: text-scale;
                                    }
                                    Rectangle {
                                        height: 10px;
                                        background: Theme.track-background;
                                        border-radius: 5px;
                                        clip: true;
                                        accessible-role: progress-indicator;
                                        accessible-label: "noise gate open amount";
                                        accessible-value: 60 - gate-attenuation-db;
                                        accessible-value-minimum: 0;
                                        accessible-value-maximum: 60;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: 100%;
                                            // Shows how much is getting *through*, so a
                                            // full bar means an open gate -- the direction
                                            // people expect from a level meter.
                                            width: parent.width * max(0.0, 1.0 - gate-attenuation-db / 60);
                                            background: Theme.accent;
                                            animate width { duration: reduced-motion ? 0ms : 60ms; }
                                        }
                                    }
                                }
                            }

                            if section-id == "hpf" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "Cuts low rumble -- desk bumps, footsteps, and breath thumping on the mic.";
                                    text-scale: text-scale;
                                    title: "High-pass filter"; reduced-motion: reduced-motion; expanded <=> sec-hpf;
                                    editing: editing-layout; can-move-up: i > 0; can-move-down: i < audio-order.length - 1;
                                    move-up => { move-audio-section(section-id, -1); }
                                    move-down => { move-audio-section(section-id, 1); }
                                }
                                if sec-hpf : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    ToggleSwitch { text: "Enabled"; checked <=> hpf-enabled; toggled => { settings-changed(); } }
                                    SettingLabel { text: "Cutoff: \{round(hpf-cutoff)} Hz"; help: "Everything below this is removed. Around 80 Hz is safe for any voice; go higher only if rumble is still getting through."; text-scale: text-scale; }
                                    AccentSlider { minimum: 20; maximum: 400; value <=> hpf-cutoff; changed(v) => { settings-changed(); } }
                                }
                            }

                            if section-id == "lpf" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "Cuts high hiss and sharpness. Useful for cheap mics with a lot of static.";
                                    text-scale: text-scale;
                                    title: "Low-pass filter"; reduced-motion: reduced-motion; expanded <=> sec-lpf;
                                    editing: editing-layout; can-move-up: i > 0; can-move-down: i < audio-order.length - 1;
                                    move-up => { move-audio-section(section-id, -1); }
                                    move-down => { move-audio-section(section-id, 1); }
                                }
                                if sec-lpf : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    ToggleSwitch { text: "Enabled"; checked <=> lpf-enabled; toggled => { settings-changed(); } }
                                    SettingLabel { text: "Cutoff: \{round(lpf-cutoff)} Hz"; help: "Everything above this is removed. Lower cuts more hiss, but too low makes your voice sound muffled and distant."; text-scale: text-scale; }
                                    AccentSlider { minimum: 2000; maximum: 20000; value <=> lpf-cutoff; changed(v) => { settings-changed(); } }
                                }
                            }

                            if section-id == "deesser" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "Softens harsh \"S\" and \"T\" sounds without dulling the rest of your voice.";
                                    text-scale: text-scale;
                                    title: "De-esser"; reduced-motion: reduced-motion; expanded <=> sec-deesser;
                                    editing: editing-layout; can-move-up: i > 0; can-move-down: i < audio-order.length - 1;
                                    move-up => { move-audio-section(section-id, -1); }
                                    move-down => { move-audio-section(section-id, 1); }
                                }
                                if sec-deesser : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    ToggleSwitch { text: "Enabled"; checked <=> deesser-enabled; toggled => { settings-changed(); } }
                                    SettingLabel { text: "Threshold: \{round(deesser-threshold)} dB"; help: "How loud an \"S\" has to be before it gets softened. Lower catches more of them."; text-scale: text-scale; }
                                    AccentSlider { minimum: -50; maximum: -5; value <=> deesser-threshold; changed(v) => { settings-changed(); } }
                                    SettingLabel { text: "Strength: \{round(deesser-ratio * 10) / 10}:1"; help: "How hard those sounds are pushed down once caught. Too high starts to sound like a lisp."; text-scale: text-scale; }
                                    AccentSlider { minimum: 1; maximum: 10; value <=> deesser-ratio; changed(v) => { settings-changed(); } }
                                    SettingLabel { text: "Listening above: \{round(deesser-split)} Hz"; help: "Which frequencies count as \"S\" sounds. Raise it if the de-esser is dulling your voice instead of just the hiss."; text-scale: text-scale; }
                                    AccentSlider { minimum: 2000; maximum: 10000; value <=> deesser-split; changed(v) => { settings-changed(); } }
                                    SettingLabel { text: "Attack: \{round(deesser-attack)} ms"; help: "How fast it clamps down once it hears an \"S\". Too slow lets the sharp front of the sound through anyway."; text-scale: text-scale; }
                                    AccentSlider { minimum: 1; maximum: 50; value <=> deesser-attack; changed(v) => { settings-changed(); } }
                                    SettingLabel { text: "Release: \{round(deesser-release)} ms"; help: "How quickly it lets go afterwards. Too long and it keeps dulling the word that follows."; text-scale: text-scale; }
                                    AccentSlider { minimum: 5; maximum: 300; value <=> deesser-release; changed(v) => { settings-changed(); } }
                                }
                            }

                            if section-id == "eq" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "Shapes how your voice sounds -- add clarity, remove boominess, or cut one specific annoying frequency. Drag the curve to move a band, or click empty space to add one.";
                                    text-scale: text-scale;
                                    title: "Parametric EQ"; reduced-motion: reduced-motion; expanded <=> sec-eq;
                                    editing: editing-layout; can-move-up: i > 0; can-move-down: i < audio-order.length - 1;
                                    move-up => { move-audio-section(section-id, -1); }
                                    move-down => { move-audio-section(section-id, 1); }
                                }
                                if sec-eq : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 8px;

                                    graph := Rectangle {
                                        height: 90px;
                                        background: Theme.track-background;
                                        border-radius: 6px;
                                        clip: true;
                                        Rectangle {
                                            y: parent.height / 2 - 1px;
                                            height: 1px;
                                            width: 100%;
                                            background: Theme.divider;
                                        }
                                        Path {
                                            width: 100%;
                                            height: 100%;
                                            viewbox-x: 0;
                                            viewbox-y: 0;
                                            viewbox-width: 300;
                                            viewbox-height: 100;
                                            stroke: Theme.accent;
                                            stroke-width: 2px;
                                            commands: eq-curve-svg;
                                        }
                                        eq-touch := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            moved => {
                                                if eq-touch.pressed {
                                                    eq-curve-drag(eq-touch.mouse-x / graph.width, eq-touch.mouse-y / graph.height);
                                                }
                                            }
                                        }
                                    }
                                    Text {
                                        text: "Click and drag on the graph to grab the nearest band (or start a new one where there isn't one yet).";
                                        wrap: word-wrap;
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                    }
                                    HorizontalBox {
                                        padding: 0px;
                                        Text { text: "20 Hz"; color: Theme.muted-text; font-size: 10px * text-scale; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: "+/-18 dB"; color: Theme.muted-text; font-size: 10px * text-scale; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: "20 kHz"; color: Theme.muted-text; font-size: 10px * text-scale; }
                                    }

                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 6px;
                                        Text { text: "Starters"; color: Theme.muted-text; font-size: 10px * text-scale; vertical-alignment: center; }
                                        HelpIcon {
                                            text-scale: text-scale;
                                            text: "Replaces the bands below with a gentle starting curve. Nothing is locked -- drag or retype any band afterwards.";
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 4px;
                                        for preset in eq-preset-names : Button {
                                            text: preset;
                                            clicked => { eq-load-preset(preset); }
                                        }
                                    }

                                    for band[bi] in eq-bands : VerticalBox {
                                        padding: 0px;
                                        spacing: 4px;
                                        Rectangle { height: 1px; background: Theme.divider; }
                                        HorizontalBox {
                                            padding: 0px;
                                            ToggleSwitch { checked: band.enabled; toggled => { eq-toggle(bi); } }
                                            Text { text: "Band \{bi + 1}"; font-weight: 600; vertical-alignment: center; }
                                            ComboBox {
                                                model: ["Bell", "Low shelf", "High shelf", "Notch"];
                                                current-index: band.band-type;
                                                selected(v) => { eq-set-type(bi, self.current-index); }
                                            }
                                            HelpIcon {
                                                text-scale: text-scale;
                                                text: "Bell boosts or cuts around one frequency. Low shelf lifts everything below it, high shelf everything above. Notch cuts one narrow frequency hard -- for killing a specific hum or whine without dulling your voice.";
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Button { text: "Remove"; clicked => { eq-remove-band(bi); } }
                                        }
                                        HorizontalBox {
                                            padding: 0px;
                                            spacing: 8px;
                                            VerticalBox {
                                                padding: 0px;
                                                Text { text: "Frequency (Hz)"; color: Theme.muted-text; font-size: 10px * text-scale; }
                                                LineEdit { text: "\{round(band.freq)}"; accepted(v) => { eq-set-freq(bi, v); } }
                                            }
                                            VerticalBox {
                                                padding: 0px;
                                                Text { text: "Gain (dB)"; color: Theme.muted-text; font-size: 10px * text-scale; }
                                                LineEdit { text: "\{round(band.gain * 10) / 10}"; accepted(v) => { eq-set-gain(bi, v); } }
                                            }
                                            VerticalBox {
                                                padding: 0px;
                                                Text { text: "Q"; color: Theme.muted-text; font-size: 10px * text-scale; }
                                                LineEdit { text: "\{round(band.q * 10) / 10}"; accepted(v) => { eq-set-q(bi, v); } }
                                            }
                                        }
                                    }
                                    Button { text: "+ Add band"; clicked => { eq-add-band(); } }
                                    Text {
                                        text: "Type a number and press Enter to apply it.";
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                    }
                                }
                            }

                            if section-id == "comp" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "Evens out your volume. Quiet talking gets louder and shouting gets quieter, so you never blast the people listening.";
                                    text-scale: text-scale;
                                    title: "Compressor"; reduced-motion: reduced-motion; expanded <=> sec-comp;
                                    editing: editing-layout; can-move-up: i > 0; can-move-down: i < audio-order.length - 1;
                                    move-up => { move-audio-section(section-id, -1); }
                                    move-down => { move-audio-section(section-id, 1); }
                                }
                                if sec-comp : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    ToggleSwitch { text: "Enabled"; checked <=> comp-enabled; toggled => { settings-changed(); } }
                                    SettingLabel { text: "Threshold: \{round(comp-threshold)} dB"; help: "The level where evening-out starts. Anything louder than this gets pulled down."; text-scale: text-scale; }
                                    AccentSlider { minimum: -60; maximum: 0; value <=> comp-threshold; changed(v) => { settings-changed(); } }
                                    SettingLabel { text: "Ratio: \{round(comp-ratio * 10) / 10}:1"; help: "How firmly it pulls down. 2:1 is gentle, 8:1 is aggressive and starts to sound processed."; text-scale: text-scale; }
                                    AccentSlider { minimum: 1; maximum: 10; value <=> comp-ratio; changed(v) => { settings-changed(); } }

                                    SettingLabel {
                                        text: "Gain reduction: \{round(comp-gain-reduction-db * 10) / 10} dB";
                                        help: "How much the compressor is pulling your voice down right now. It should flicker on the loud words and sit at zero the rest of the time -- pinned high means the threshold is too low.";
                                        text-scale: text-scale;
                                    }
                                    Rectangle {
                                        height: 10px;
                                        background: Theme.track-background;
                                        border-radius: 5px;
                                        clip: true;
                                        accessible-role: progress-indicator;
                                        accessible-label: "compressor gain reduction";
                                        accessible-value: comp-gain-reduction-db;
                                        accessible-value-minimum: 0;
                                        accessible-value-maximum: 24;
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            height: 100%;
                                            // 24 dB of travel: past that the compressor is
                                            // doing something the user almost certainly
                                            // did not intend, and pinning the bar says so.
                                            width: parent.width * min(comp-gain-reduction-db / 24, 1.0);
                                            background: Theme.accent;
                                            animate width { duration: reduced-motion ? 0ms : 60ms; }
                                        }
                                    }
                                }
                            }

                            if section-id == "limiter" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "A hard ceiling on your volume. Catches sudden loud noises before they hit anyone's ears.";
                                    text-scale: text-scale;
                                    title: "Limiter"; reduced-motion: reduced-motion; expanded <=> sec-limiter;
                                    editing: editing-layout; can-move-up: i > 0; can-move-down: i < audio-order.length - 1;
                                    move-up => { move-audio-section(section-id, -1); }
                                    move-down => { move-audio-section(section-id, 1); }
                                }
                                if sec-limiter : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    ToggleSwitch { text: "Enabled"; checked <=> limiter-enabled; toggled => { settings-changed(); } }
                                    SettingLabel { text: "Ceiling: \{round(limiter-ceiling)} dB"; help: "Nothing you send goes above this level, no matter what happens on your end."; text-scale: text-scale; }
                                    AccentSlider { minimum: -12; maximum: 0; value <=> limiter-ceiling; changed(v) => { settings-changed(); } }
                                }
                            }

                            if section-id == "pitch" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "Raises or lowers your voice pitch.";
                                    text-scale: text-scale;
                                    title: "Pitch shift"; reduced-motion: reduced-motion; expanded <=> sec-pitch;
                                    editing: editing-layout; can-move-up: i > 0; can-move-down: i < audio-order.length - 1;
                                    move-up => { move-audio-section(section-id, -1); }
                                    move-down => { move-audio-section(section-id, 1); }
                                }
                                if sec-pitch : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    ToggleSwitch { text: "Enabled"; checked <=> pitch-enabled; toggled => { settings-changed(); } }
                                    Text { text: "\{round(pitch-semitones)} semitones"; color: Theme.muted-text; font-size: 12px * text-scale; }
                                    AccentSlider { minimum: -12; maximum: 12; value <=> pitch-semitones; changed(v) => { settings-changed(); } }
                                    ToggleSwitch { text: "Keep my voice natural"; checked <=> pitch-preserve-formants; toggled => { settings-changed(); } }
                                    Text {
                                        text: pitch-preserve-formants
                                            ? "Holds the vocal-tract resonances in place so you sound like yourself at a different pitch, instead of a chipmunk. Costs a little CPU."
                                            : "Off: pitch and resonances move together, the classic chipmunk/demon effect. Leave it off if that's the effect you want.";
                                        wrap: word-wrap;
                                        color: Theme.muted-text;
                                        font-size: 11px * text-scale;
                                    }
                                }
                            }

                            if section-id == "reverb" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "Adds a sense of space, like talking in a room or a hall. Mostly for fun.";
                                    text-scale: text-scale;
                                    title: "Reverb"; reduced-motion: reduced-motion; expanded <=> sec-reverb;
                                    editing: editing-layout; can-move-up: i > 0; can-move-down: i < audio-order.length - 1;
                                    move-up => { move-audio-section(section-id, -1); }
                                    move-down => { move-audio-section(section-id, 1); }
                                }
                                if sec-reverb : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    ToggleSwitch { text: "Enabled"; checked <=> reverb-enabled; toggled => { settings-changed(); } }
                                    SettingLabel { text: "Room size: \{round(reverb-room-size * 100)}%"; help: "How big the imagined space is. Small sounds like a booth, large sounds like a hall."; text-scale: text-scale; }
                                    AccentSlider { minimum: 0; maximum: 1; value <=> reverb-room-size; changed(v) => { settings-changed(); } }
                                    SettingLabel { text: "Damping: \{round(reverb-damping * 100)}%"; help: "How soft the walls are. More damping soaks up the echo faster and keeps it from ringing."; text-scale: text-scale; }
                                    AccentSlider { minimum: 0; maximum: 1; value <=> reverb-damping; changed(v) => { settings-changed(); } }
                                    SettingLabel { text: "Mix: \{round(reverb-wet * 100)}% wet"; help: "How much of the effect people hear against your dry voice."; text-scale: text-scale; }
                                    AccentSlider { minimum: 0; maximum: 1; value <=> reverb-wet; changed(v) => { settings-changed(); } }
                                }
                            }
                        }
                    }

                    if settings-category == 3 : VerticalBox {
                        padding: 0px;
                        vertical-stretch: 0;
                        spacing: 4px;

                        Text { text: "Shortcuts"; font-weight: 700; }
                        if binding-warning != "" : Text {
                            text: binding-warning;
                            color: #e0a052;
                            font-size: 11px * text-scale;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Press Change, then press the key you want. These work while the app is in the background, but only while you're on a call.";
                            wrap: word-wrap;
                            color: Theme.muted-text;
                            font-size: 11px * text-scale;
                        }
                        Rectangle { height: 6px; }

                        KeybindRow {
                            label: ptt-toggle ? "Push to talk (toggle)" : "Push to talk (hold)";
                            id: "ptt";
                            key-name: ptt-key-name;
                            capturing: capturing-binding == "ptt";
                            clearable: false;
                            text-scale: text-scale;
                            change => { capture-binding("ptt"); }
                        }
                        KeybindRow {
                            label: mute-hold ? "Mute (hold)" : "Toggle mute";
                            id: "mute";
                            key-name: mute-key-name;
                            capturing: capturing-binding == "mute";
                            text-scale: text-scale;
                            change => { capture-binding("mute"); }
                            clear => { clear-binding("mute"); }
                        }
                        ToggleSwitch {
                            text: "Mute only while the key is held";
                            checked <=> mute-hold;
                            reduced-motion: reduced-motion;
                            text-scale: text-scale;
                            help: "Push-to-mute: you are muted while you hold the key and unmuted the moment you let go, instead of pressing once to mute and again to unmute.";
                            toggled => { settings-changed(); }
                        }
                        KeybindRow {
                            label: deafen-hold ? "Deafen (hold)" : "Toggle deafen";
                            id: "deafen";
                            key-name: deafen-key-name;
                            capturing: capturing-binding == "deafen";
                            text-scale: text-scale;
                            change => { capture-binding("deafen"); }
                            clear => { clear-binding("deafen"); }
                        }
                        ToggleSwitch {
                            text: "Deafen only while the key is held";
                            checked <=> deafen-hold;
                            reduced-motion: reduced-motion;
                            text-scale: text-scale;
                            help: "You hear nothing while you hold the key, and everything comes back the moment you let go, instead of pressing once to deafen and again to undeafen.";
                            toggled => { settings-changed(); }
                        }
                        KeybindRow {
                            label: "Hang up";
                            id: "hangup";
                            key-name: hangup-key-name;
                            capturing: capturing-binding == "hangup";
                            text-scale: text-scale;
                            change => { capture-binding("hangup"); }
                            clear => { clear-binding("hangup"); }
                        }
                        KeybindRow {
                            label: "Save replay (last 30s)";
                            id: "replay";
                            key-name: replay-key-name;
                            capturing: capturing-binding == "replay";
                            text-scale: text-scale;
                            change => { capture-binding("replay"); }
                            clear => { clear-binding("replay"); }
                        }

                        Rectangle { height: 10px; }
                        Text {
                            text: "How the microphone opens is set in Audio > Transmit.";
                            wrap: word-wrap;
                            color: Theme.muted-text;
                            font-size: 11px * text-scale;
                        }
                    }

                    if settings-category == 5 : VerticalBox {
                        padding: 0px;
                        vertical-stretch: 0;
                        spacing: 4px;

                        for section-id[i] in call-order : VerticalBox {
                            padding: 0px;

                            if section-id == "callstart" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "How every call starts, before you change anything in it.";
                                    text-scale: text-scale;
                                    title: "Starting a call"; reduced-motion: reduced-motion; expanded <=> sec-callstart;
                                }
                                if sec-callstart : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    ToggleSwitch { text: "Start with my microphone muted"; checked <=> mute-self-on-join; toggled => { settings-changed(); }; help: "Join quietly and unmute when you're ready. Your mic key still works as normal."; text-scale: text-scale; }

                                    Rectangle { height: 1px; background: Theme.divider; }
                                    ToggleSwitch { text: "Start with screen sharing on"; checked <=> start-with-screen-share; toggled => { settings-changed(); } }
                                    ToggleSwitch { text: "Start with camera on"; checked <=> start-with-camera; toggled => { settings-changed(); }; help: "Saved, but nothing reads these yet -- video and screen sharing aren't built. They're listed as later work in the feature spec, and these switches will be honoured when that lands."; text-scale: text-scale; }
                                }
                            }

                            if section-id == "notifications" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "Who is allowed to ring you, and when. These are your rules -- a caller can ask for less attention than you allow, never more.";
                                    text-scale: text-scale;
                                    title: "Ringing & quiet hours"; reduced-motion: reduced-motion; expanded <=> sec-notifications;
                                }
                                if sec-notifications : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    SettingLabel {
                                        text: "When someone calls";
                                        help: "The default for anyone without their own setting, including people who aren't in your contacts.";
                                        text-scale: text-scale;
                                    }
                                    ComboBox {
                                        model: ["Ring out loud", "Show quietly, no sound", "Don't tell me at all"];
                                        current-index: default-ring-rule;
                                        selected(v) => { default-ring-rule = self.current-index; settings-changed(); }
                                    }

                                    Rectangle { height: 1px; background: Theme.divider; }
                                    ToggleSwitch {
                                        text: "Quiet hours";
                                        checked <=> quiet-hours-enabled;
                                        reduced-motion: reduced-motion;
                                        text-scale: text-scale;
                                        help: "During this window a call still appears, but makes no sound. It lowers what a caller gets -- it never raises it, so someone set to \"don't tell me\" stays silent regardless.";
                                        toggled => { settings-changed(); }
                                    }
                                    if quiet-hours-enabled : SettingLabel {
                                        text: "From \{floor(quiet-hours-start / 60)}:\{quiet-hours-start - floor(quiet-hours-start / 60) * 60 < 10 ? "0" : ""}\{mod(quiet-hours-start, 60)}";
                                        help: "Windows that cross midnight work as you would expect -- 23:00 to 07:00 covers the night, not the day.";
                                        text-scale: text-scale;
                                    }
                                    if quiet-hours-enabled : AccentSlider {
                                        minimum: 0; maximum: 1439;
                                        value: quiet-hours-start;
                                        changed(v) => { quiet-hours-start = round(v); settings-changed(); }
                                    }
                                    if quiet-hours-enabled : SettingLabel {
                                        text: "Until \{floor(quiet-hours-end / 60)}:\{quiet-hours-end - floor(quiet-hours-end / 60) * 60 < 10 ? "0" : ""}\{mod(quiet-hours-end, 60)}";
                                        help: "The end of the quiet window.";
                                        text-scale: text-scale;
                                    }
                                    if quiet-hours-enabled : AccentSlider {
                                        minimum: 0; maximum: 1439;
                                        value: quiet-hours-end;
                                        changed(v) => { quiet-hours-end = round(v); settings-changed(); }
                                    }
                                    HelpIcon {
                                        text-scale: text-scale;
                                        text: "Times are UTC, not your local timezone -- a timezone database is a large dependency and guessing an offset would be wrong half the year.";
                                    }
                                }
                            }

                            if section-id == "soundboard" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "Short audio clips you can play during a call, either out to the other person or just to yourself.";
                                    text-scale: text-scale;
                                    title: "Soundboard"; reduced-motion: reduced-motion; expanded <=> sec-soundboard;
                                }
                                if sec-soundboard : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    if sound-clip-names.length == 0 : Text {
                                        text: "No clips yet. Add a short WAV file to get started.";
                                        color: Theme.muted-text;
                                        font-size: 11px * text-scale;
                                        wrap: word-wrap;
                                    }
                                    for name[ci] in sound-clip-names : HorizontalBox {
                                        padding: 0px;
                                        spacing: 6px;
                                        Text { text: name; vertical-alignment: center; font-size: 11px * text-scale; overflow: elide; }
                                        Rectangle { horizontal-stretch: 1; }
                                        // Two buttons rather than one plus a
                                        // mode switch: sending a sound to
                                        // someone and cueing it privately are
                                        // different intentions, and a hidden
                                        // toggle is how you blast a clip at
                                        // someone by accident.
                                        Button { text: "Send"; enabled: connected; clicked => { play-sound-clip(ci, true); } }
                                        Button { text: "Preview"; clicked => { play-sound-clip(ci, false); } }
                                        Button { text: "X"; clicked => { remove-sound-clip(ci); } }
                                    }
                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 6px;
                                        Button { text: "Add a clip..."; clicked => { add-sound-clip(); } }
                                        HelpIcon {
                                            text-scale: text-scale;
                                            text: "16-bit WAV, mono or stereo, up to 15 seconds. The file is copied into the app, so moving or deleting the original later won't break the clip.";
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    if soundboard-message != "" : Text {
                                        text: soundboard-message;
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if section-id == "transferlimits" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "How much of your connection file transfers are allowed to use. Transfers and calls share one link, and voice degrades long before a transfer notices.";
                                    text-scale: text-scale;
                                    title: "File transfer speed"; reduced-motion: reduced-motion; expanded <=> sec-transferlimits;
                                }
                                if sec-transferlimits : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    ToggleSwitch {
                                        text: "Slow transfers down during calls";
                                        checked <=> throttle-during-calls;
                                        reduced-motion: reduced-motion;
                                        text-scale: text-scale;
                                        help: "On by default. An unthrottled transfer makes a call sound broken, and people blame the call rather than the file -- so this trades transfer speed for audio you can actually hear.";
                                        toggled => { settings-changed(); }
                                    }
                                    if throttle-during-calls : SettingLabel {
                                        text: "During a call: \{in-call-kbps} KB/s";
                                        help: "The cap while you're talking. If your overall limit below is lower, that one wins -- this never speeds a transfer up.";
                                        text-scale: text-scale;
                                    }
                                    if throttle-during-calls : AccentSlider {
                                        minimum: 32; maximum: 2048;
                                        value: in-call-kbps;
                                        changed(v) => { in-call-kbps = round(v); settings-changed(); }
                                    }
                                    SettingLabel {
                                        text: upload-kbps == 0 ? "Overall limit: none" : "Overall limit: \{upload-kbps} KB/s";
                                        help: "Applies all the time. Drag to zero for no limit.";
                                        text-scale: text-scale;
                                    }
                                    AccentSlider {
                                        minimum: 0; maximum: 8192;
                                        value: upload-kbps;
                                        changed(v) => { upload-kbps = round(v); settings-changed(); }
                                    }
                                    if transfer-limit-note != "" : Text {
                                        text: transfer-limit-note;
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if section-id == "sharedfiles" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "Files that can still be fetched after the call. Each is encrypted with its own key that only you and the person you sent it to have; whoever holds a copy -- you, them, a pin node -- can't read it.";
                                    text-scale: text-scale;
                                    title: "Shared files"; reduced-motion: reduced-motion; expanded <=> sec-sharedfiles;
                                }
                                if sec-sharedfiles : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    ToggleSwitch {
                                        text: "Seed files I share and download";
                                        checked <=> seeding;
                                        reduced-motion: reduced-motion;
                                        text-scale: text-scale;
                                        help: "Keeps an encrypted copy of each file and hands it out, so the other person can fetch it after the call, and from several people at once if they seed too. Off by default: it uses disk space and upload. Uses port " + seed-port + ".";
                                        toggled => { sharing-settings-changed(); }
                                    }
                                    if seeding : HorizontalBox {
                                        padding: 0px; spacing: 6px;
                                        SettingLabel { text: "Hand them to"; help: "Only the conversation: whoever has the link from the chat. Contacts: those people, only if they're also your contacts. Anyone: anyone with the file's id -- they still can't read it without the key."; text-scale: text-scale; }
                                        ComboBox {
                                            model: ["This conversation only", "My contacts", "Anyone"];
                                            current-index: seed-scope;
                                            selected(v) => { seed-scope = self.current-index; sharing-settings-changed(); }
                                        }
                                    }
                                    SettingLabel { text: "Pin nodes"; help: "Nodes that keep an encrypted copy of every file you share, for when neither of you is online. A node only does this if its operator turned on file hosting. Comma-separated, press Enter."; text-scale: text-scale; }
                                    LineEdit {
                                        text <=> pin-nodes;
                                        placeholder-text: "node.example.org:3478, ...";
                                        accepted(t) => { sharing-settings-changed(); }
                                    }
                                    LineEdit {
                                        text <=> pin-code;
                                        placeholder-text: "community code, if the node asks for one";
                                        accepted(t) => { sharing-settings-changed(); }
                                    }
                                    HorizontalBox {
                                        padding: 0px; spacing: 6px;
                                        Button { text: "Check availability"; clicked => { check-shared-files(); } }
                                    }
                                    if shared-files.length == 0 : Text {
                                        text: "Nothing shared yet. Files you send in a call land here when seeding or a pin node is on.";
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                        wrap: word-wrap;
                                    }
                                    for f in shared-files : VerticalBox {
                                        padding: 4px; spacing: 2px;
                                        HorizontalBox {
                                            padding: 0px; spacing: 6px;
                                            Text { text: f.name; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                            if !f.mine : Button { text: "Download"; clicked => { download-shared-file(f.file-id); } }
                                            Button { text: f.mine ? "Stop sharing" : "Remove"; clicked => { forget-shared-file(f.file-id); } }
                                        }
                                        Text { text: f.detail; color: Theme.muted-text; font-size: 10px * text-scale; wrap: word-wrap; }
                                        if f.status != "" : Text { text: f.status; font-size: 10px * text-scale; wrap: word-wrap; }
                                    }
                                }
                            }

                            if section-id == "vpn" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "Run your own WireGuard VPN inside this app only -- not a system VPN, so nothing else on this computer changes. Import the .conf file your VPN provider or your own server gives you, then choose what goes through it.";
                                    text-scale: text-scale;
                                    title: "VPN"; reduced-motion: reduced-motion; expanded <=> sec-vpn;
                                }
                                if sec-vpn : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    ToggleSwitch {
                                        text: "Use a VPN for this app";
                                        checked <=> vpn-enabled;
                                        reduced-motion: reduced-motion;
                                        text-scale: text-scale;
                                        help: "Off by default. When on, the traffic you pick below leaves from the VPN server's address instead of yours.";
                                        toggled => { vpn-settings-changed(); }
                                    }
                                    Text {
                                        text: vpn-status;
                                        font-size: 10px * text-scale;
                                        wrap: word-wrap;
                                    }
                                    for c in vpn-configs : VerticalBox {
                                        padding: 4px; spacing: 2px;
                                        HorizontalBox {
                                            padding: 0px; spacing: 6px;
                                            Text { text: (c.active ? "● " : "") + c.name; font-weight: c.active ? 700 : 400; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                            if !c.active : Button { text: "Use"; clicked => { select-vpn-config(c.id); } }
                                            Button { text: "Delete"; clicked => { delete-vpn-config(c.id); } }
                                        }
                                        Text { text: c.detail; color: Theme.muted-text; font-size: 10px * text-scale; wrap: word-wrap; }
                                    }
                                    HorizontalBox {
                                        padding: 0px; spacing: 6px;
                                        Button { text: "Import a WireGuard file..."; clicked => { import-vpn-config(); } }
                                        HelpIcon {
                                            text-scale: text-scale;
                                            text: "A wg-quick .conf file. Its private key is stored encrypted on this device, never in your settings file or a settings export. Script lines (PostUp and the like) are ignored, never run.";
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    if vpn-message != "" : Text {
                                        text: vpn-message;
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                        wrap: word-wrap;
                                    }
                                    SettingLabel {
                                        text: "Send through the VPN";
                                        help: "Pick per kind of traffic -- for example, files through the VPN while calls stay direct, or the reverse.";
                                        text-scale: text-scale;
                                    }
                                    ToggleSwitch {
                                        text: "Calls";
                                        checked <=> vpn-route-voice;
                                        reduced-motion: reduced-motion;
                                        text-scale: text-scale;
                                        help: "Off by default: a tunnel adds a detour, and voice notices delay first. When on, people can still call you only if your VPN forwards a port to you, or through a relay; you can always call out.";
                                        toggled => { vpn-settings-changed(); }
                                    }
                                    ToggleSwitch {
                                        text: "Shared files";
                                        checked <=> vpn-route-files;
                                        reduced-motion: reduced-motion;
                                        text-scale: text-scale;
                                        help: "Downloads from holders and uploads to pin nodes. Files sent inside a call travel with the call.";
                                        toggled => { vpn-settings-changed(); }
                                    }
                                    ToggleSwitch {
                                        text: "Offline messages";
                                        checked <=> vpn-route-messages;
                                        reduced-motion: reduced-motion;
                                        text-scale: text-scale;
                                        help: "Leaving and collecting sealed messages at mailbox nodes.";
                                        toggled => { vpn-settings-changed(); }
                                    }
                                    ToggleSwitch {
                                        text: "Kill switch";
                                        checked <=> vpn-kill-switch;
                                        reduced-motion: reduced-motion;
                                        text-scale: text-scale;
                                        help: "If the VPN is down, the traffic picked above stops instead of going out over your real connection. You'll see an error rather than leak your address. Off by default.";
                                        toggled => { vpn-settings-changed(); }
                                    }
                                }
                            }

                            if section-id == "discovery" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "How contacts find you after your address changes, and how you find public communities. Both are off until you turn them on and name the nodes to use.";
                                    text-scale: text-scale;
                                    title: "Finding contacts"; reduced-motion: reduced-motion; expanded <=> sec-discovery;
                                }
                                if sec-discovery : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    ToggleSwitch {
                                        text: "Let contacts find me if my address changes (DHT)";
                                        checked <=> dht-enabled;
                                        reduced-motion: reduced-motion;
                                        text-scale: text-scale;
                                        help: "Publishes where you can be reached to a distributed table, encrypted so only people who already have your identity key -- your contacts, or anyone you gave your invite link -- can read it. The nodes storing it can't tell whose it is or read the address. When a contact's saved address stops answering, the app looks them up the same way before trying their relay. Off by default.";
                                        toggled => { dht-settings-changed(); }
                                    }
                                    SettingLabel { text: "Bootstrap nodes"; help: "DHT nodes to join through: anyone running antiphon-relay --dht, such as your own or your community's. None are built in. Comma-separated, press Enter."; text-scale: text-scale; }
                                    LineEdit {
                                        text <=> dht-bootstrap;
                                        placeholder-text: "node.example.org:3479, ...";
                                        accepted(t) => { dht-settings-changed(); }
                                    }
                                    if dht-enabled && dht-status != "" : Text {
                                        text: dht-status;
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                        wrap: word-wrap;
                                    }
                                    SettingLabel { text: "Community directories"; help: "Directories list public communities that asked to be listed, never people. Nothing is searched unless you add a directory here and press Browse."; text-scale: text-scale; }
                                    LineEdit {
                                        text <=> directories;
                                        placeholder-text: "directory.example.org:3479, ...";
                                        accepted(t) => { dht-settings-changed(); }
                                    }
                                    HorizontalBox {
                                        padding: 0px; spacing: 6px;
                                        Button { text: "Browse"; clicked => { browse-directories(); } }
                                    }
                                    if directory-status != "" : Text {
                                        text: directory-status;
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                        wrap: word-wrap;
                                    }
                                    for d in directory-entries : VerticalBox {
                                        padding: 4px; spacing: 2px;
                                        HorizontalBox {
                                            padding: 0px; spacing: 6px;
                                            Text { text: d.name; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                            Button { text: "Add"; clicked => { join-directory-entry(d.name, d.invite); } }
                                        }
                                        Text { text: d.description; font-size: 10px * text-scale; wrap: word-wrap; }
                                        Text { text: "Listed by " + d.directory; color: Theme.muted-text; font-size: 10px * text-scale; }
                                    }
                                }
                            }

                            if section-id == "callparticipants" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "What you hear from other people when a call starts. Nothing here changes what they hear -- it only affects your own end.";
                                    text-scale: text-scale;
                                    title: "Participants"; reduced-motion: reduced-motion; expanded <=> sec-callparticipants;
                                }
                                if sec-callparticipants : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    ToggleSwitch { text: "Start with everyone else muted"; checked <=> mute-others-by-default; toggled => { settings-changed(); }; help: "Click a person in the call to un-mute them individually."; text-scale: text-scale; }

                                    SettingLabel {
                                        text: duck-db == 0 ? "Lower them while I talk: off" : "Lower them while I talk: " + duck-db + " dB";
                                        help: "Quietens the other person while your microphone is open. Without headphones, what you hear from them is picked up by your mic and sent back -- this breaks that echo loop. The change is ramped rather than switched, so it does not click at the start of every word.";
                                        text-scale: text-scale;
                                    }
                                    AccentSlider {
                                        minimum: 0; maximum: 24;
                                        value: duck-db;
                                        changed(v) => { duck-db = round(v); settings-changed(); }
                                    }
                                }
                            }

                            if section-id == "outbox" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "A message you send while the other person is offline stays on this device and sends itself the next time you are both connected. It is stored encrypted, and it leaves the queue only once the connection confirms it went.";
                                    text-scale: text-scale;
                                    title: "Message delivery"; reduced-motion: reduced-motion; expanded <=> sec-outbox;
                                }
                                if sec-outbox : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    SettingLabel {
                                        text: outbox-give-up-hours == 0
                                            ? "Keep trying: forever"
                                            : "Keep trying: " + outbox-give-up-hours + " hours";
                                        help: "How long an undelivered message keeps trying before this device gives up on it. Forever by default -- a message you meant to send is still one you meant to send a week later, and a shorter window discards things you believe you have sent.";
                                        text-scale: text-scale;
                                    }
                                    AccentSlider {
                                        minimum: 0; maximum: 336;
                                        value: outbox-give-up-hours;
                                        changed(v) => { outbox-give-up-hours = round(v); settings-changed(); }
                                    }

                                    Rectangle { height: 1px; background: Theme.divider; }
                                    SettingLabel {
                                        text: "Where your mail waits";
                                        help: "Your route list is your inbox: it is sent to your contacts, and when they message you while you're offline their app leaves the sealed message at the highest route you've made available. Nobody can leave your mail somewhere you didn't choose. Every node holds only sealed messages it can't read.";
                                        text-scale: text-scale;
                                    }
                                    ToggleSwitch {
                                        text: "Strict mode";
                                        checked <=> strict-mode;
                                        reduced-motion: reduced-motion;
                                        text-scale: text-scale;
                                        help: "Turns off every route except Direct. Messages only ever move when both of you are online at the same moment, and nothing is stored anywhere, ever.";
                                        toggled => { delivery-settings-changed(); }
                                    }
                                    if !strict-mode : ComboBox {
                                        model: ["First available (least metadata)", "Fan out (most reliable)"];
                                        current-index: route-fan-out ? 1 : 0;
                                        selected(v) => { route-fan-out = self.current-index == 1; delivery-settings-changed(); }
                                    }
                                    if !strict-mode : Text {
                                        text: route-fan-out
                                            ? "The same sealed message is left at several nodes; the first copy to arrive wins and the rest expire. No single operator sees all your traffic, but more nodes know something arrived."
                                            : "Each message goes to the first route that takes it, so as few nodes as possible know anything arrived.";
                                        wrap: word-wrap;
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                    }
                                    for r[ri] in routes : Rectangle {
                                        border-width: 1px;
                                        border-color: Theme.divider;
                                        border-radius: 6px;
                                        opacity: strict-mode && !r.is-direct ? 0.45 : 1.0;
                                        VerticalBox {
                                            padding: 8px;
                                            spacing: 4px;
                                            HorizontalBox {
                                                padding: 0px;
                                                spacing: 6px;
                                                Text { text: (ri + 1) + ". " + r.title; font-weight: 600; font-size: 12px * text-scale; vertical-alignment: center; horizontal-stretch: 1; }
                                                Button { text: "Up"; enabled: ri > 0; clicked => { route-move(ri, -1); } }
                                                Button { text: "Down"; enabled: ri < routes.length - 1; clicked => { route-move(ri, 1); } }
                                                ToggleSwitch {
                                                    text: "";
                                                    checked: r.enabled;
                                                    enabled: !strict-mode;
                                                    reduced-motion: reduced-motion;
                                                    text-scale: text-scale;
                                                    toggled => { route-toggled(ri, self.checked); }
                                                }
                                            }
                                            Text { text: r.description; wrap: word-wrap; color: Theme.muted-text; font-size: 10px * text-scale; }
                                            if !r.is-direct : LineEdit {
                                                text: r.nodes;
                                                placeholder-text: "node addresses, e.g. home.example.org:3479";
                                                enabled: !strict-mode && r.enabled;
                                                accepted(t) => { route-nodes-edited(ri, t); }
                                            }
                                            if !r.is-direct && r.title == "Community node" : LineEdit {
                                                text: r.code;
                                                placeholder-text: "community code, if the node asks for one";
                                                enabled: !strict-mode && r.enabled;
                                                accepted(t) => { route-code-edited(ri, t); }
                                            }
                                            if r.status != "" : Text { text: r.status; wrap: word-wrap; font-size: 10px * text-scale; font-family: "Consolas"; }
                                        }
                                    }
                                    Text {
                                        text: "Press Enter after editing a node list. Removing a node is safe: senders keep messages until another route takes them.";
                                        wrap: word-wrap;
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                    }
                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 6px;
                                        Button { text: "Find nodes on my network"; clicked => { find-nodes(); } }
                                    }
                                    if found-nodes != "" : Text { text: found-nodes; wrap: word-wrap; font-size: 10px * text-scale; }
                                    ToggleSwitch {
                                        text: "Hold mail for my other devices";
                                        checked <=> hold-mail;
                                        reduced-motion: reduced-motion;
                                        text-scale: text-scale;
                                        help: "Makes this device a node for your own other devices: while your phone is asleep, this one holds the sealed messages and hands them over when it wakes. Add this device's address under \"My other devices\" on each of your devices. Only your own devices can register here.";
                                        toggled => { delivery-settings-changed(); }
                                    }
                                    if hold-mail : Text {
                                        text: "Holding mail on port " + hold-mail-port + ".";
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                    }
                                }
                            }

                            if section-id == "calladvanced" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    title: "Advanced"; reduced-motion: reduced-motion; expanded <=> sec-calladvanced;
                                }
                                if sec-calladvanced : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    ToggleSwitch {
                                        text: "Shift+click Call to flip knocking";
                                        checked: silent-call-mode == 1;
                                        reduced-motion: reduced-motion;
                                        text-scale: text-scale;
                                        help: "Adds Shift+click on the Call button as a shortcut for the \"Knock instead of ringing\" switch. Off by default -- the switch is always there, and a courtesy nobody can find is not a courtesy. Shift flips the switch for one call and puts it back, so it never quietly changes what you set. To make every call a knock instead, just leave the switch on.";
                                        toggled => { silent-call-mode = self.checked ? 1 : 0; settings-changed(); }
                                    }
                                    ToggleSwitch { text: "IP direct calling"; checked <=> ip-direct-calling; text-scale: text-scale; help: "Lets you call a raw address like 192.168.1.10:6000, and lets one be called. A direct connection is the fastest and most private option with people you already know, but both sides can see each other's IP address -- the same as any direct connection on the internet. Off by default: with it off, the Connect panel only offers your saved contacts."; toggled => { settings-changed(); } }
                                    SettingLabel {
                                        text: "Relay server";
                                        help: "A relay passes your calls along for people who can't reach you directly, and for anyone not yet a known contact, so neither of you learns the other's IP address. It forwards encrypted data it cannot read and never holds a key. Run your own with antiphon-relay, or use one your community runs. Leave empty for none.";
                                        text-scale: text-scale;
                                    }
                                    LineEdit {
                                        text <=> relay-server;
                                        placeholder-text: "relay.example.org:3479";
                                        edited(t) => { settings-changed(); }
                                    }
                                    Button {
                                        text: "Make a new invite link";
                                        clicked => { new-invite-secret(); }
                                    }
                                    Text {
                                        text: "Anyone holding an old invite link can no longer ring you through the relay. Saved contacts are not affected.";
                                        wrap: word-wrap;
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                    }
                                }
                            }
                        }
                    }

                    if settings-category == 4 : VerticalBox {
                        padding: 0px;
                        vertical-stretch: 0;

                        for section-id[i] in profile-order : VerticalBox {
                            padding: 0px;

                            if section-id == "profile" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    help: "Your name and status are sent to whoever you're on a call with, and to nobody else. Nothing here is published anywhere.";
                                    text-scale: text-scale;
                                    title: "Your profile"; reduced-motion: reduced-motion; expanded <=> sec-profile;
                                    editing: editing-layout; can-move-up: i > 0; can-move-down: i < profile-order.length - 1;
                                    move-up => { move-profile-section(section-id, -1); }
                                    move-down => { move-profile-section(section-id, 1); }
                                }
                                if sec-profile : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;

                                    // Spec §4: identity is a keypair, so
                                    // this ID is derived from your key
                                    // rather than assigned by a server.
                                    // Nobody can take it, and it survives
                                    // moving between machines.
                                    SettingLabel {
                                        text: "Presence";
                                        help: "What your contacts see. Only people you have saved can see this -- there is no directory to broadcast into, and choosing Invisible sends nothing at all rather than sending \"offline\".";
                                        text-scale: text-scale;
                                    }
                                    ComboBox {
                                        model: ["Online", "Away", "Busy", "Invisible"];
                                        current-index: my-presence;
                                        selected(v) => { presence-changed(self.current-index); }
                                    }
                                    if presence-note != "" : Text {
                                        text: presence-note;
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                        wrap: word-wrap;
                                    }
                                    Rectangle { height: 1px; background: Theme.divider; }

                                    Text { text: "Your ID"; color: Theme.muted-text; font-size: 12px * text-scale; }
                                    Text {
                                        text: my-share-id;
                                        font-family: "Consolas";
                                        font-size: 12px * text-scale;
                                        wrap: word-wrap;
                                    }
                                    Button { text: "Copy my ID"; clicked => { copy-share-id(); } }

                                    Text { text: "Invite link"; color: Theme.muted-text; font-size: 12px * text-scale; }
                                    Text {
                                        text: my-invite-link;
                                        font-family: "Consolas";
                                        font-size: 10px * text-scale;
                                        wrap: word-wrap;
                                    }
                                    if my-invite-qr.width > 0 : Image {
                                        source: my-invite-qr;
                                        width: 200px;
                                        height: 200px;
                                        image-fit: contain;
                                    }
                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 6px;
                                        Button { text: "Refresh invite"; clicked => { refresh-invite(); } }
                                        HelpIcon {
                                            text-scale: text-scale;
                                            text: "Send this link, or let someone scan the square. It carries your permanent ID plus your current address, so they can reach you straight away -- no directory and nobody listing you anywhere.";
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    if !my-invite-has-address : Text {
                                        text: "This invite has no address yet, so it names you but can't be dialled. Press Find next to your public address in the Connect panel, then Refresh invite.";
                                        wrap: word-wrap;
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                    }
                                    HelpIcon {
                                        text-scale: text-scale;
                                        text: "Give this to someone so they can add you. It comes from your key, so it is yours permanently -- no server assigns it and nobody else can claim it.";
                                    }
                                    HelpIcon {
                                        text-scale: text-scale;
                                        text: "Sharing it is safe: it identifies you but reveals nothing about where you are. Looking someone up by ID alone needs the distributed address book, which isn't built yet -- for now you still need their address to place the first call.";
                                    }

                                    Rectangle { height: 1px; background: Theme.divider; }
                                    SettingLabel {
                                        text: "Recovery phrase";
                                        help: "Twenty-four words that restore this identity on a new device. Write them down and keep them somewhere safe -- there is no server that can reset your account, so this is the only way back if you lose every device.";
                                        text-scale: text-scale;
                                    }
                                    Button {
                                        text: recovery-phrase-shown ? "Hide recovery phrase" : "Show recovery phrase";
                                        clicked => { toggle-recovery-phrase(); }
                                    }
                                    if recovery-phrase-shown : Text {
                                        text: recovery-phrase;
                                        font-family: "Consolas";
                                        font-size: 12px * text-scale;
                                        wrap: word-wrap;
                                    }
                                    if recovery-phrase-shown : Text {
                                        text: "Anyone who reads these words becomes you. Don't screenshot them, don't put them in a chat, and don't store them with your password manager's autofill.";
                                        wrap: word-wrap;
                                        color: #e0a052;
                                        font-size: 10px * text-scale;
                                    }
                                    SettingLabel {
                                        text: "Split among friends";
                                        help: "Splits your recovery phrase into shares for people or devices you trust. Any two of three (or three of five) rebuild your identity; fewer reveal nothing about it, so no one person holding a share can become you.";
                                        text-scale: text-scale;
                                    }
                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 8px;
                                        ComboBox {
                                            model: ["2 of 3", "3 of 5", "2 of 2"];
                                            current-index <=> recovery-split-choice;
                                            enabled: !recovery-shares-shown;
                                        }
                                        Button {
                                            text: recovery-shares-shown ? "Hide shares" : "Make shares";
                                            clicked => { toggle-recovery-shares(); }
                                        }
                                    }
                                    if recovery-shares-shown : Text {
                                        text: recovery-shares;
                                        font-family: "Consolas";
                                        font-size: 12px * text-scale;
                                        wrap: word-wrap;
                                    }
                                    if recovery-shares-shown : Text {
                                        text: "Give each share to a different person or device. New shares are made every time, and shares from different times don't mix.";
                                        wrap: word-wrap;
                                        color: #e0a052;
                                        font-size: 10px * text-scale;
                                    }
                                    Text {
                                        text: "Restoring: antiphon-cli identity restore \"<your 24 words>\"  or  antiphon-cli identity restore-shares \"<share>\" \"<share>\"";
                                        color: Theme.muted-text;
                                        font-family: "Consolas";
                                        font-size: 10px * text-scale;
                                        wrap: word-wrap;
                                    }

                                    Rectangle { height: 1px; background: Theme.divider; }
                                    Text { text: "Avatar"; color: Theme.muted-text; font-size: 12px * text-scale; }
                                    HorizontalBox {
                                        padding: 0px;
                                        spacing: 10px;
                                        ProfileAvatar {
                                            size: 44px;
                                            has-image: profile-avatar-image-set;
                                            img: profile-avatar-image;
                                            initial: display-initial;
                                            fit: avatar-image-fit;
                                            rotation: avatar-image-rotation;
                                            crop-left: avatar-image-crop-left;
                                            crop-top: avatar-image-crop-top;
                                            crop-right: avatar-image-crop-right;
                                            crop-bottom: avatar-image-crop-bottom;
                                        }
                                        VerticalBox {
                                            padding: 0px;
                                            spacing: 4px;
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            HorizontalBox {
                                                padding: 0px;
                                                spacing: 6px;
                                                Button { text: profile-avatar-image-set ? "Change..." : "Choose image..."; clicked => { import-profile-avatar(); } }
                                                if profile-avatar-image-set : Button { text: "Remove"; clicked => { clear-profile-avatar(); } }
                                            }
                                            if profile-avatar-message != "" : Text { text: profile-avatar-message; color: Theme.muted-text; font-size: 10px * text-scale; wrap: word-wrap; }
                                        }
                                    }
                                    Text {
                                        text: "PNG, JPEG, BMP, GIF, WebP, or TIFF -- an animated GIF plays, everywhere it's shown.";
                                        wrap: word-wrap;
                                        color: Theme.muted-text;
                                        font-size: 10px * text-scale;
                                    }

                                    if profile-avatar-image-set : VerticalBox {
                                        padding: 0px;
                                        spacing: 6px;
                                        Text { text: "Fit"; color: Theme.muted-text; font-size: 10px * text-scale; }
                                        HorizontalBox {
                                            padding: 0px;
                                            spacing: 6px;
                                            TabButton { label: "Cover"; active: avatar-image-fit == 0; reduced-motion: reduced-motion; clicked => { avatar-image-fit = 0; settings-changed(); } }
                                            TabButton { label: "Fit"; active: avatar-image-fit == 1; reduced-motion: reduced-motion; clicked => { avatar-image-fit = 1; settings-changed(); } }
                                            TabButton { label: "Stretch"; active: avatar-image-fit == 2; reduced-motion: reduced-motion; clicked => { avatar-image-fit = 2; settings-changed(); } }
                                            TabButton { label: "Original"; active: avatar-image-fit == 3; reduced-motion: reduced-motion; clicked => { avatar-image-fit = 3; settings-changed(); } }
                                            Rectangle { horizontal-stretch: 1; }
                                        }

                                        Text { text: "Rotate: \{round(avatar-image-rotation)}°"; color: Theme.muted-text; font-size: 10px * text-scale; }
                                        AccentSlider { minimum: -180; maximum: 180; value <=> avatar-image-rotation; changed(v) => { settings-changed(); } }

                                        Text { text: "Crop"; color: Theme.muted-text; font-size: 10px * text-scale; }
                                        HorizontalBox {
                                            padding: 0px;
                                            spacing: 12px;
                                            VerticalBox {
                                                padding: 0px;
                                                spacing: 4px;
                                                Text { text: "Left: \{round(avatar-image-crop-left)}%"; color: Theme.muted-text; font-size: 9px * text-scale; }
                                                AccentSlider { minimum: 0; maximum: 90; value <=> avatar-image-crop-left; changed(v) => { settings-changed(); } }
                                                Text { text: "Right: \{round(avatar-image-crop-right)}%"; color: Theme.muted-text; font-size: 9px * text-scale; }
                                                AccentSlider { minimum: 0; maximum: 90; value <=> avatar-image-crop-right; changed(v) => { settings-changed(); } }
                                            }
                                            VerticalBox {
                                                padding: 0px;
                                                spacing: 4px;
                                                Text { text: "Top: \{round(avatar-image-crop-top)}%"; color: Theme.muted-text; font-size: 9px * text-scale; }
                                                AccentSlider { minimum: 0; maximum: 90; value <=> avatar-image-crop-top; changed(v) => { settings-changed(); } }
                                                Text { text: "Bottom: \{round(avatar-image-crop-bottom)}%"; color: Theme.muted-text; font-size: 9px * text-scale; }
                                                AccentSlider { minimum: 0; maximum: 90; value <=> avatar-image-crop-bottom; changed(v) => { settings-changed(); } }
                                            }
                                        }

                                        // Shown at the two sizes it actually
                                        // appears at, in the surrounding chrome
                                        // it actually appears in -- a crop that
                                        // looks fine at 72px can lose the face
                                        // entirely at 36.
                                        Rectangle { height: 1px; background: Theme.divider; }
                                        Text { text: "Preview"; color: Theme.muted-text; font-size: 10px * text-scale; }
                                        HorizontalBox {
                                            padding: 0px;
                                            spacing: 16px;
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                height: 56px;
                                                border-radius: 8px;
                                                background: Theme.panel-hover;
                                                HorizontalBox {
                                                    padding: 8px;
                                                    spacing: 8px;
                                                    ProfileAvatar {
                                                        size: 36px;
                                                        has-image: profile-avatar-image-set;
                                                        img: profile-avatar-image;
                                                        initial: display-initial;
                                                        fit: avatar-image-fit;
                                                        rotation: avatar-image-rotation;
                                                        crop-left: avatar-image-crop-left;
                                                        crop-top: avatar-image-crop-top;
                                                        crop-right: avatar-image-crop-right;
                                                        crop-bottom: avatar-image-crop-bottom;
                                                    }
                                                    VerticalBox {
                                                        padding: 0px;
                                                        spacing: 0px;
                                                        alignment: center;
                                                        horizontal-stretch: 1;
                                                        Text { text: display-name == "" ? "You" : display-name; font-weight: 700; font-size: 13px * text-scale; overflow: elide; }
                                                        Text { text: status-message == "" ? "Online" : status-message; color: Theme.muted-text; font-size: 11px * text-scale; overflow: elide; }
                                                    }
                                                }
                                            }
                                            VerticalBox {
                                                padding: 0px;
                                                spacing: 2px;
                                                horizontal-stretch: 0;
                                                alignment: center;
                                                ProfileAvatar {
                                                    size: 72px;
                                                    has-image: profile-avatar-image-set;
                                                    img: profile-avatar-image;
                                                    initial: display-initial;
                                                    fit: avatar-image-fit;
                                                    rotation: avatar-image-rotation;
                                                    crop-left: avatar-image-crop-left;
                                                    crop-top: avatar-image-crop-top;
                                                    crop-right: avatar-image-crop-right;
                                                    crop-bottom: avatar-image-crop-bottom;
                                                }
                                                Text { text: "popup"; color: Theme.muted-text; font-size: 9px * text-scale; horizontal-alignment: center; }
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: Theme.divider; }
                                    Text { text: "Display name"; color: Theme.muted-text; font-size: 12px * text-scale; }
                                    LineEdit { text <=> display-name; edited(v) => { profile-changed(); } }
                                    Text { text: "Status"; color: Theme.muted-text; font-size: 12px * text-scale; }
                                    LineEdit { text <=> status-message; edited(v) => { profile-changed(); } }
                                }
                            }

                            if section-id == "about" : VerticalBox {
                                padding: 0px;
                                SectionHeader {
                                    title: "About"; reduced-motion: reduced-motion; expanded <=> sec-about;
                                    editing: editing-layout; can-move-up: i > 0; can-move-down: i < profile-order.length - 1;
                                    move-up => { move-profile-section(section-id, -1); }
                                    move-down => { move-profile-section(section-id, 1); }
                                }
                                if sec-about : VerticalBox {
                                    padding-top: 6px; padding-left: 22px; padding-bottom: 10px; spacing: 6px;
                                    Text {
                                        text: "Your name and status are sent to the other side over the encrypted connection once you're on a call, and shown as \"With: <name> -- <status>\" on the Call tab. Stored locally, and re-sent automatically if you edit it mid-call.";
                                        wrap: word-wrap;
                                        color: Theme.muted-text;
                                        font-size: 12px * text-scale;
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
                }
            }
        }

    }

    // The profile popup (Discord-style: click the profile widget, get a
    // card with the full picture/name/status and a way into Profile
    // settings) has to live as MainWindow's own direct child, not nested
    // inside the profile widget's `FreeformPanel` -- nested there, it
    // would be clipped to the panel's own bounds instead of floating above
    // everything else (and the panel can be dragged anywhere/resized
    // small, which would make a nested popup unusable). A full-window,
    // invisible dismiss layer sits behind it (declared first, so the
    // popup's own buttons still win hit-testing over it) so clicking
    // anywhere outside the card closes it. Deliberately anchored to a
    // fixed window corner rather than tracking the profile widget's own
    // (draggable) position -- simpler, and still predictable/discoverable
    // even after the widget's been moved.
    if profile-popup-open : TouchArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        clicked => { profile-popup-open = false; }
    }

    if profile-popup-open : Rectangle {
        x: 12px;
        // `height` is an explicit, closed-form expression (capped, never
        // taller than the window itself minus margins) rather than
        // implicitly derived from content -- referencing `self.height` in
        // this same `y` binding would otherwise be circular against a
        // content-driven size, which is what made the popup's actual
        // height unpredictable (and, with a long status message, taller
        // than the window) in the first place. `y` is also floored at
        // 12px so a popup at its height cap can't get pushed off the top
        // of a short window.
        y: max(12px, parent.height - self.height - 12px);
        width: 260px;
        height: min(320px, parent.height - 24px);
        background: Palette.background;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.divider;
        clip: true;

        ScrollView {
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            VerticalBox {
                width: parent.width - 14px;
                padding: 16px;
                spacing: 10px;
                ProfileAvatar {
                    size: 72px;
                    has-image: profile-avatar-image-set;
                    img: profile-avatar-image;
                    initial: display-initial;
                    fit: avatar-image-fit;
                    rotation: avatar-image-rotation;
                    crop-left: avatar-image-crop-left;
                    crop-top: avatar-image-crop-top;
                    crop-right: avatar-image-crop-right;
                    crop-bottom: avatar-image-crop-bottom;
                }
                Text {
                    text: display-name == "" ? "You" : display-name;
                    font-weight: 700;
                    font-size: 16px * text-scale;
                    wrap: word-wrap;
                }
                if status-message != "" : Text {
                    text: status-message;
                    color: Theme.muted-text;
                    font-size: 12px * text-scale;
                    wrap: word-wrap;
                }
                Rectangle { height: 1px; background: Theme.divider; }
                Button {
                    text: "Edit Profile";
                    clicked => {
                        current-tab = 1;
                        settings-category = 4;
                        profile-popup-open = false;
                    }
                }
            }
        }
    }

    // The settings-description surface, declared last so it paints above
    // everything else -- Slint has no z-index, so draw order is
    // declaration order. Deliberately contains no `TouchArea`: it must
    // never take a hover, or it would steal the hover from the icon
    // showing it and flicker.
    if TooltipState.visible && TooltipState.text != "" : Rectangle {
        // Clamped so a description near the right or bottom edge folds
        // back into the window instead of being clipped away.
        x: min(TooltipState.anchor-x + 24px, root.width - self.width - 8px);
        y: min(TooltipState.anchor-y - 4px, root.height - self.height - 8px);
        width: min(300px, root.width - 32px);
        height: tip-text.preferred-height + 16px;

        background: Palette.background;
        border-color: Theme.divider;
        border-width: 1px;
        border-radius: 6px;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000050;

        tip-text := Text {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            text: TooltipState.text;
            wrap: word-wrap;
            font-size: 11px * TooltipState.scale;
            color: Palette.foreground;
        }
    }
}

export component AppTrayIcon inherits SystemTrayIcon {
    icon: @image-url("tray-icon.png");
    in-out property <string> status-line: "not connected";
    tooltip: "Antiphon -- " + status-line;

    callback show-window();
    callback quit-app();
    callback toggle-mute();

    clicked => { show-window(); }

    Menu {
        MenuItem { title: "Open"; activated => { show-window(); } }
        MenuItem { title: "Mute / Unmute"; activated => { toggle-mute(); } }
        MenuSeparator { }
        MenuItem { title: "Quit"; activated => { quit-app(); } }
    }
}
